@@ -0,0 +1,57 @@
+"""Collect the exact approved cohort through the public benchmark command."""
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+
+parser = argparse.ArgumentParser(__doc__)
+parser.add_argument("--rounds", type=int, required=True)
+parser.add_argument("--stem", required=True)
+args = parser.parse_args()
+root = Path.cwd()
+evidence = root / "benchmarks/local/proof-recording-under-5x"
+cohort = json.loads((root / "goals/proof-recording-under-5x/cohort.json").read_text())["workloads"]
+assert len(cohort) == len({row["file_sha256"] for row in cohort}) == 127
+for row in cohort:
+    assert "sha256:" + hashlib.sha256((root / row["file"]).read_bytes()).hexdigest() == row["file_sha256"]
+# Check the original outliers first without changing the frozen population.
+priority = ["/luminal/gemma-call-01.egg", "/luminal/gemma4_moe-call-01.egg", "/dialegg/timer-nmm-80-call-01.egg"]
+cohort.sort(key=lambda row: next((i for i, suffix in enumerate(priority) if row["file"].endswith(suffix)), len(priority)))
+report = evidence / f"{args.stem}.jsonl"
+if report.exists():
+    raise SystemExit(f"use a new report path; {report} already exists")
+argv = [
+    "./bench.py", *(row["file"] for row in cohort),
+    "--target", ".", "--compare-target", ".",
+    "--treatment", "proofs", "--compare-treatment", "off",
+    "--rounds", str(args.rounds), "--timeout-sec", "500",
+    "--memory-limit", "--force-run", "--detail", "phases",
+    "--report", str(report), "--format", "markdown",
+]
+patch = subprocess.check_output(["git", "diff", "--binary"])
+(evidence / f"{args.stem}.patch").write_bytes(patch)
+provenance = {
+    "started_at": datetime.now(timezone.utc).isoformat(),
+    "cwd": str(root),
+    "argv": argv,
+    "source_head": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
+    "source_patch_sha256": "sha256:" + hashlib.sha256(patch).hexdigest(),
+    "cohort_sha256": "sha256:" + hashlib.sha256((root / "goals/proof-recording-under-5x/cohort.json").read_bytes()).hexdigest(),
+}
+provenance_path = evidence / f"{args.stem}-provenance.json"
+provenance_path.write_text(json.dumps(provenance, indent=2) + "\n")
+with (evidence / f"{args.stem}.md").open("w") as stdout, (evidence / f"{args.stem}.log").open("w") as stderr:
+    completed = subprocess.run(argv, env={**os.environ, "UV_PYTHON": "3.12"}, stdout=stdout, stderr=stderr)
+provenance["finished_at"] = datetime.now(timezone.utc).isoformat()
+provenance["exit_code"] = completed.returncode
+provenance["source_head_end"] = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
+provenance["source_unchanged"] = (provenance["source_head_end"] == provenance["source_head"] and patch == subprocess.check_output(["git", "diff", "--binary"]))
+binary = root / "target/release/egglog-experimental"
+provenance["binary_sha256"] = "sha256:" + hashlib.sha256(binary.read_bytes()).hexdigest()
+provenance_path.write_text(json.dumps(provenance, indent=2) + "\n")
+print(json.dumps(provenance, indent=2))
+raise SystemExit(completed.returncode)
diff --git a/benchmarks/local/proof-recording-under-5x/check_acceptance.py b/benchmarks/local/proof-recording-under-5x/check_acceptance.py
new file mode 100644
index 00000000..e33db2e5
--- /dev/null
+++ b/benchmarks/local/proof-recording-under-5x/check_acceptance.py
@@ -0,0 +1,113 @@
+"""Check the frozen recording cohort using the runner's codec and statistics."""
+
+import argparse
+import hashlib
+import json
+import math
+from datetime import datetime
+from pathlib import Path
+
+from scipy import stats
+
+from benchmarking.native_memory import NATIVE_LIMIT_BYTES
+from benchmarking.reports.analysis import _ratio_estimate, _sample_estimate
+from benchmarking.reports.store import CacheKey, ReportStore
+
+
+def main():
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--binary", type=Path, required=True)
+    parser.add_argument("--since", type=datetime.fromisoformat, required=True)
+    parser.add_argument("--rounds", type=int, default=10)
+    parser.add_argument("--timeout-sec", type=int, default=500)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path.cwd()
+    cohort_path = root / "goals/proof-recording-under-5x/cohort.json"
+    cohort = json.loads(cohort_path.read_text())["workloads"]
+    binary_sha = "sha256:" + hashlib.sha256(args.binary.read_bytes()).hexdigest()
+    store = ReportStore(args.report)
+    expected = {item["file_sha256"] for item in cohort}
+    issues = []
+    if len(cohort) != 127 or len(expected) != 127:
+        issues.append("cohort must contain exactly 127 unique identities")
+    if len(store.records) != len(cohort) * 2 * args.rounds:
+        issues.append("report must contain exactly the requested new observations")
+    if {row["treatment"] for row in store.records} != {"off", "proofs"}:
+        issues.append("report must contain only off and proofs observations")
+    if {row["binary_sha256"] for row in store.records} != {binary_sha}:
+        issues.append("report does not contain only the pinned executable")
+    if {row["file_sha256"] for row in store.records} != expected:
+        issues.append("report input identity set differs from frozen cohort")
+    critical = float(stats.t.ppf(0.975, args.rounds - 1)) if args.rounds >= 2 else None
+    results = []
+    for item in cohort:
+        case_issues = []
+        actual_hash = "sha256:" + hashlib.sha256((root / item["file"]).read_bytes()).hexdigest()
+        if actual_hash != item["file_sha256"]:
+            case_issues.append("current input differs from frozen identity")
+        observations = {}
+        for treatment in ("off", "proofs"):
+            selected = store.latest_records(
+                CacheKey(binary_sha, item["file_sha256"], treatment),
+                args.rounds, args.timeout_sec, NATIVE_LIMIT_BYTES,
+            )
+            observations[treatment] = [row.record for row in selected]
+            if len(selected) != args.rounds:
+                case_issues.append(f"{treatment}: {len(selected)}/{args.rounds} observations")
+            for row in selected:
+                if row.record["status"] != "success":
+                    case_issues.append(f"{treatment}: unsuccessful observation")
+                if row.started_at < args.since:
+                    case_issues.append(f"{treatment}: observation predates final collection")
+                for metric in ("wall_sec", "max_rss_bytes"):
+                    value = row.record[metric]
+                    if value is None or not math.isfinite(value) or value <= 0:
+                        case_issues.append(f"{treatment}: invalid {metric}")
+        metrics = {}
+        observation_issue = "; ".join(case_issues) or None
+        for metric in ("wall_sec", "max_rss_bytes"):
+            estimates = []
+            for treatment in ("off", "proofs"):
+                values = [float(row[metric]) for row in observations[treatment] if row[metric] is not None]
+                estimate = _sample_estimate(values, observation_issue, critical)
+                estimates.append(estimate)
+            ratio = _ratio_estimate(*estimates, critical)
+            metrics[metric] = {
+                "off": estimates[0].estimate._asdict(),
+                "proofs": estimates[1].estimate._asdict(),
+                "ratio": ratio.estimate._asdict(),
+                "ratio_issue": ratio.issue,
+            }
+            point = ratio.estimate.point
+            if point is None or not math.isfinite(point) or point >= 5:
+                case_issues.append(f"{metric}: ratio is not below 5")
+        case_issues = list(dict.fromkeys(case_issues))
+        results.append({**item, "metrics": metrics, "issues": case_issues})
+        issues.extend(f"{item['file']}: {issue}" for issue in case_issues)
+    result = {
+        "accepted": not issues and args.rounds == 10,
+        "all_measured_ratios_below_5": not issues,
+        "rounds": args.rounds,
+        "since": args.since.isoformat(),
+        "timeout_sec": args.timeout_sec,
+        "memory_limit_bytes": NATIVE_LIMIT_BYTES,
+        "binary": str(args.binary.resolve()),
+        "binary_sha256": binary_sha,
+        "report": str(args.report.resolve()),
+        "cohort": str(cohort_path),
+        "issues": issues,
+        "results": results,
+    }
+    args.out.write_text(json.dumps(result, indent=2, allow_nan=False) + "\n")
+    print(json.dumps({"accepted": result["accepted"], "cases": len(results), "issues": len(issues)}))
+    for metric in ("wall_sec", "max_rss_bytes"):
+        available = [row for row in results if row["metrics"][metric]["ratio"]["point"] is not None]
+        for row in sorted(available, key=lambda row: row["metrics"][metric]["ratio"]["point"], reverse=True)[:8]:
+            print(metric, row["file"], row["metrics"][metric]["ratio"])
+    return int(bool(issues))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/benchmarks/local/proof-recording-under-5x/prepare_figure.py b/benchmarks/local/proof-recording-under-5x/prepare_figure.py
