+++ b/benchmarks/local/proof-recording-under-5x/prepare_figure.py
@@ -0,0 +1,29 @@
+"""Prepare the public figure command for exactly the frozen recording cohort."""
+
+import json
+from pathlib import Path
+
+root = Path.cwd()
+output = root / 'benchmarks/local/proof-recording-under-5x/final-figure'
+output.mkdir(parents=True, exist_ok=True)
+spec = json.loads((root / 'figures/eval/corpus-cdf.vl.json').read_text())
+for parameter in spec['params']:
+    if parameter['name'] == 'frozen_cohort':
+        parameter['value'] = True
+spec_path = output / 'recording-frozen.vl.json'
+spec_path.write_text(json.dumps(spec, indent=2) + '\n')
+cohort = json.loads((root / 'goals/proof-recording-under-5x/cohort.json').read_text())['workloads']
+config = {
+    'rounds': 10,
+    'timeout_sec': 500,
+    'figures': {
+        'corpus-proof-recording-cdf': {
+            'spec': str(spec_path),
+            'files': [str(root / row['file']) for row in cohort],
+            'treatments': ['off', 'proofs'],
+            'checks': [],
+        }
+    },
+}
+(output / 'catalog.json').write_text(json.dumps(config, indent=2) + '\n')
+print(output / 'catalog.json')
diff --git a/benchmarks/local/proof-recording-under-5x/audit_figure.mjs b/benchmarks/local/proof-recording-under-5x/audit_figure.mjs
new file mode 100644
index 00000000..1fa867e7
--- /dev/null
+++ b/benchmarks/local/proof-recording-under-5x/audit_figure.mjs
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import {readFile,writeFile} from 'node:fs/promises';
+import {existsSync,realpathSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import {delimiter,join,resolve} from 'node:path';
+
+const evidence=resolve('benchmarks/local/proof-recording-under-5x');
+const prefix=join(evidence,'final-figure/corpus-proof-recording-cdf');
+const accepted=JSON.parse(await readFile(join(evidence,'final-acceptance.json'),'utf8'));
+assert.equal(accepted.accepted,true);
+const spec=JSON.parse(await readFile(prefix+'.bound.vl.json','utf8'));
+assert.equal(spec.vconcat.length,1,'no overview composition');
+assert.equal(spec.params.find(p=>p.name==='frozen_cohort').value,true);
+const domains=spec.params.find(p=>p.name==='view_domains').value;
+for(const d of Object.values(domains))assert.equal(d.zoom,d.full,'every observation fits the single panel');
+const cli=process.env.PATH.split(delimiter).map(p=>join(p,'vl2svg')).find(existsSync);
+assert.ok(cli,'use the pinned Vega environment from make test-figures');
+const toolkit=createRequire(realpathSync(cli));
+const vega=await import(toolkit.resolve('vega'));
+const {compile}=await import(toolkit.resolve('vega-lite'));
+const warnings=[];
+const logger=vega.logger(vega.Warn,undefined,(...args)=>warnings.push(args));
+const view=new vega.View(vega.parse(compile(spec,{logger}).spec),{renderer:'none',logger});
+try {
+  await view.runAsync();
+  assert.deepEqual(warnings,[]);
+  const marks=[];
+  function visit(item){
+    if(item.mark&&item.datum)marks.push(item);
+    for(const child of item.items??[])visit(child);
+  }
+  visit(view.scenegraph().root);
+  const points=marks.filter(p=>p.mark.name==='cdf_points_zoom_marks');
+  assert.equal(points.length,254);
+  const metrics={};
+  for(const [label,key] of [['Runtime','wall_sec'],['Peak RSS','max_rss_bytes']]){
+    const rows=points.filter(p=>p.datum.metric===label);
+    assert.equal(rows.length,127);
+    assert.equal(new Set(rows.map(p=>p.datum.workload_id)).size,127);
+    assert.deepEqual(new Set(rows.map(p=>p.datum.workload_id)),new Set(accepted.results.map(r=>r.logical_id)));
+    for(const p of rows){
+      const expected=accepted.results.find(r=>r.logical_id===p.datum.workload_id).metrics[key].ratio.point;
+      assert.ok(Math.abs(expected-p.datum.ratio)<1e-9,'rendered ratios must equal the acceptance dataset');
+      assert.equal(p.datum.cohort_n,127);
+      assert.equal(p.datum.measured_n,127);
+      assert.equal(p.datum.beyond_n,0);
+      assert.ok(p.bounds.x1>=-1e-8&&p.bounds.x2<=p.mark.group.width+1e-8,'point must fit horizontally');
+      assert.ok(p.bounds.y1>=-1e-8&&p.bounds.y2<=p.mark.group.height+1e-8,'point must fit vertically');
+    }
+    assert.equal(Math.max(...rows.map(p=>p.datum.cdf)),1);
+    metrics[label]={points:rows.length,maximum:Math.max(...rows.map(p=>p.datum.ratio)),q50:rows[0].datum.q50,q95:rows[0].datum.q95,domain:domains[label]};
+  }
+  const svg=await view.toSVG();
+  assert.doesNotMatch(svg,/Zoom |outside zoom|full range/);
+  assert.equal([...svg.matchAll(/>Relative to off</g)].length,2);
+  const summary={passed:true,workloads:127,points:254,metrics,warnings,binary_sha256:accepted.binary_sha256};
+  await writeFile(join(evidence,'figure-audit.json'),JSON.stringify(summary,null,2)+'\n');
+  console.log(JSON.stringify(summary,null,2));
+}finally{view.finalize();}
