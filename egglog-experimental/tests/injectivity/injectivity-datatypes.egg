; Mutually recursive datatype variants use the same ruleset.
(datatype*
  (Expr (Leaf String) (Block Stmt :cost 3))
  (Stmt (Return Expr i64 :cost 2)))
(separately-injective Block)
(separately-injective Return)
(let a (Leaf "a"))
(let b (Leaf "b"))
(union (Block (Return a 0)) (Block (Return b 0)))
(check (= a b))
