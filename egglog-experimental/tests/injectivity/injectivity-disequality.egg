; Positive facts propagate upward through marked functions with fixed other inputs.
(datatype Term (A) (B) (C) (D) (Num i64) (Pair Term Term) (Wrap Term) (Plain Term Term))
(separately-injective Num)
(separately-injective Pair)
(separately-injective Wrap)
(Num 1) (Num 2)
(check (known-disequal (Num 1) (Num 2)))
(Pair (A) (C)) (Pair (B) (C))
(fail (check (known-disequal (Pair (A) (C)) (Pair (B) (C)))))
(disequal (A) (B))
(check (known-disequal (Pair (A) (C)) (Pair (B) (C))))
(Pair (C) (A)) (Pair (C) (B))
(check (known-disequal (Pair (C) (A)) (Pair (C) (B))))
(Pair (A) (A)) (Pair (B) (B))
(fail (check (known-disequal (Pair (A) (A)) (Pair (B) (B)))))
(Plain (A) (C)) (Plain (B) (C))
(fail (check (known-disequal (Plain (A) (C)) (Plain (B) (C)))))
; Output disequality does not propagate downward.
(disequal (Wrap (C)) (Wrap (D)))
(fail (check (known-disequal (C) (D))))
; Unary cancellation remains ordinary injectivity.
(union (Wrap (C)) (Wrap (D)))
(check (= (C) (D)))
(check (contradiction))
