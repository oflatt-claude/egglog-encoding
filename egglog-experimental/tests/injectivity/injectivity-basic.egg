; Cancellation requires all other coordinates to agree.
(datatype Term (Leaf String))
(constructor Pair (Term i64 Term) Term :cost 2)
(separately-injective Pair)
(let a (Leaf "a"))
(let b (Leaf "b"))
(let c (Leaf "c"))
(let d (Leaf "d"))
(union (Pair a 7 c) (Pair b 7 d))
(fail (check (= a b)))
(fail (check (= c d)))
(union c d)
(check (= a b))
