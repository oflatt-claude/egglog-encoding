Source:
(datatype U (Lam Var U :binder 0))
(let input (Lam $a $a))
(run 0)
(check (= input (Lam $b $b)))

Proof:
#0: $v1 = $v1
    by fiat
#1: $v1 = $v1
    by sym #0
#2: $v1 = {v0->v1, v1->v0}·$v0
    by shift #1 by {a->v1, v0->a, v1->v0}
#3: $v0 = {v0->v1, v1->v0}·$v1
    by sym #2
#4: $v1 = {v0->v1, v1->v0}·$v0
