#8: $v0 = {v0->v1, v1->v0}·$v1
    by sym #7
#9: $v1 = {v0->v1, v1->v0}·$v0
    by shift #6 by {v0->v1, v1->v0}
#10: $v0 = {v0->v1, v1->v0}·$v1
    by sym #9
#11: (Lam $a $a) = (Lam $a $a)
    by fiat
#12: (Lam $a $a) = {a->v0, v0->a}·(Lam $v0 $v0)
    by shift #11 by {a->v0, v0->a}
#13: (Lam $v0 $v0) = {a->v0, v0->a}·(Lam $a $a)
