Source:
(datatype U (F U))
(let input (F $a))
(rewrite (F x) x :name "unwrap")
(run 1)
(check (= input $a))

Proof:
#0: (F $a) = (F $a)
    by fiat
#1: (F $a) = $a
    by rule "unwrap" [x := $a] from #0
