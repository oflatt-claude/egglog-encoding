;;; Multipattern e-matching, hand-encoded on top of the slotted machinery.
;;;
;;; The readable form of the recipe `compile_rule` compiles
;;; (`slotted-experiments/xdiff/xdiff.py`), which is the version checked against the
;;; reference crate.  Keep the two in step.  Reasoning lives in
;;; `slotted-user-rules.md`; this file is the runnable version.
;;;
;;; Flatten the rule's LHS into depth-1 atoms `?v == (Op ?c1 ?c2)`, one per e-node,
;;; every child a bare variable.  Each becomes one egglog atom
;;;
;;;     (= V (App2 "Op" p1 C1 p2 C2))
;;;
;;; and egglog's join does the e-class level for free.  What it does not give is
;;; agreement of the *renamings*: its variable equality is e-class equality, while
;;; slotted equality is equality of renamed ids (Def. 6).  Everything below supplies
;;; that difference.  A variable `x` compiles to two egglog variables, its leader `X`
;;; and a renaming `mx : slots(X) -> slots(pattern)`, together standing for the
;;; paper's `beta(x) = mx * X`.
;;;
;;; Order the atoms so each shares a variable with the ones before it.  Then one rule
;;; covers every atom:
;;;
;;;     mp is the least renaming, total on the atom's node slots, agreeing with
;;;     everything already known about it -- its root if an earlier atom bound it,
;;;     every child an earlier atom bound, every slot literal an earlier atom pinned.
;;;     One `find-mapping-total`, avoiding the slots named so far.
;;;
;;; The initial atom is the degenerate case: nothing is known yet, so its node's
;;; slots are the pattern's and `mp` is the identity on them.  Reading this as three
;;; cases -- initial / chain / join -- and taking one constraint per case is
;;; under-constrained; M3b shows the two spellings disagreeing.
;;;
;;; Conventions:
;;;   (compose a b)           = a . b, b first: (compose a b)[x] = a[b[x]]
;;;   (compose-total a b)     = the same, but fails rather than dropping a key
;;;   (map-image m)           = identity on im(m);  (map-domain m) = on dom(m)
;;;   (App2 f m1 c1 m2 c2)     = f(m1*c1, m2*c2),  mi : slots(ci) -> slots(node)
;;;   (RenamesToLeader a m b) = a = m*b,          m  : slots(b)  -> slots(a)
;;;   (RenamesToLeader c m c) = m is in G(c)
;;;
;;; Each section is its own (push)/(pop).  Match tests assert through a witness
;;; relation carrying the computed renamings, which is what is under test; the
;;; machinery is free to rewrite the nodes afterwards.
;;;
;;; Shapes checked against the reference, by harness case:
;;;   M1 one atom, swapped action       M1-commutativity
;;;   M2 repeated variable              C1, C4, S1
;;;   M3 chain                          C2-chain
;;;   M4 join on two shared variables   C3-join
;;;   M5 chain then join                C10-chain-then-join
;;;   M6 one shared variable, minting   M6-one-shared-var-two-ops, U1
;;;   M8 action over renamed ids        C11, C14, E1-E3
;;;   M9 the accumulating avoid-set     C7-redundant-distinct-vars
;;;   M10 nested right-hand side       NR1-nested-build, NR2, NR3-assoc
;;;
;;; M7 is not covered and cannot be as the oracle stands: it puts a slot literal in a
;;; non-binder child position, which the reference admits only via `Bind` or as a
;;; unary `Var(Slot)` atom, and the harness's atoms take two children.  The mechanism
;;; it turns on -- constraining with a pinned literal rather than checking afterwards
;;; -- is covered on binder shapes by B3, B4 and the `slot-late` mutant, and its slot
;;; side condition by CD1-CD4.

(include "tests/slotted-egraph-encoding-11.egg")


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M1.  One atom, no repeated variable.
;;;
;;;     ?e == (f ?a ?b)   =>   union ?e (f ?b ?a)
;;;
;;; Nothing is known before the only atom, so nothing to check: the stored edges are
;;; already the pattern-slot renamings.  This is the cheapest shape there is --
;;; a slotted rule with no repeated variable costs exactly one extra Renaming
;;; column per child position and no joins.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= e (App2 "f" ma a mb b)))
      ((union e (App2 "f" mb b ma a))))

(let $f01 (App2 "f" (map-of 0 0) (Var 0)
                   (map-of 1 1) (Var 1)))
(run 15)

;; commutativity shows up as the e-class gaining the swap symmetry
(check (RenamesToLeader $f01 m $f01)
       (= (map-get m 0) 1)
       (= (map-get m 1) 0))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M2.  One atom, repeated variable -- the Def. 6 check.
;;;
;;;     ?e == (f ?x ?x)   =>   union ?e ?x
;;;
;;; Two occurrences of `?x` are two renamed ids of one leader.  Def. 6 says
;;; they agree iff m1^-1 . m2 is in G(X).  Both renamings are bound, so that
;;; group element is determined: compute it and look it up.
;;;
;;; This is also where the reference crate's disequality constraints show up in
;;; the encoding.  `regress::same_node_redundant_slots_stay_distinct` and
;;; `live_slots_of_one_class_stay_distinct` both say a node's two distinct slots
;;; may not be identified; here that falls out of the G-lookup simply failing --
;;; case (b) below.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation Hit (U U))

;; the lookup form: sym is computed, then checked for membership
(rule ((= e (App2 "f" m1 x m2 x))
       (= sym (compose (inverse m1) m2))
       (RenamesToLeader x sym x))
      ((Hit e x)))

;; the enumerate-then-compare spelling -- same meaning, but the planner fans
;; out over G(X) and discards all but one row
(relation Enum (U U))
(rule ((= e (App2 "f" m1 x m2 x))
       (RenamesToLeader x sym x)
       (= m2 (compose m1 sym)))
      ((Enum e x)))

;; what a non-slotted encoding would write: demand the two edges be *equal*.
;; Strictly weaker than Def. 6, and the difference is observable in (c).
(relation NaiveHit (U U))
(rule ((= e (App2 "f" m1 x m1 x))) ((NaiveHit e x)))

;; (a) both occurrences at the same slot
(push)
(let $ff (App2 "f" (map-of 7 7) (Var 7)
                  (map-of 7 7) (Var 7)))
(run 15)
(check (Hit $ff (Var 0)))
(check (Enum $ff (Var 0)))
(pop)

;; (b) negative: distinct slots, so distinct renamed ids, so no match.
;;     The crate refuses this via a disequality constraint; here the group
;;     lookup for the required swap just is not there.
(push)
(let $fg (App2 "f" (map-of 7 7) (Var 7)
                  (map-of 8 8) (Var 8)))
(run 15)
(fail (check (Hit $fg x)))
(fail (check (Enum $fg x)))
(pop)

;; (c) f(a[$0,$1], a[$1,$0]) matches f(?x,?x) *only* because `a` is symmetric.
;;     The machinery never normalises the two edges to be equal, so the naive
;;     spelling misses it while the Def. 6 spellings both fire.
(push)
(let $a01 (App2 "a" (map-of 0 0) (Var 0)
                   (map-of 1 1) (Var 1)))
(let $a10 (App2 "a" (map-of 1 1) (Var 1)
                   (map-of 0 0) (Var 0)))
(union $a01 $a10)
(run 20)

(let $t (App2 "f" (map-of 0 0 1 1) $a01
                 (map-of 0 1 1 0) $a01))
(run 20)
(check (Hit $t $a01))
(check (Enum $t $a01))
(fail (check (NaiveHit $t $a01)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M3.  Two atoms, the second rooted at a bound variable.
;;;
;;;     ?p == (f ?a ?b),  ?b == (g ?c ?d)
;;;
;;; This is the shape every flattened nested pattern produces, so it is the one
;;; that has to be cheap.  `?b` is a child of atom 1 and the root of atom 2, so
;;; the root is atom 2's only constraint, and that single G-join is
;;; simultaneously the Def. 6 check for `?b`'s second occurrence.
;;;
;;; It is still solved with `find-mapping-total`, not with `(compose mb symb)`.
;;; The two agree only while the root's edge reaches every slot of the inner
;;; node; an inner node carrying a slot `mb` does not cover -- a redundant one --
;;; has that slot dropped by the shorter spelling.  Same defect as M6, and M3b
;;; below is an e-graph where the two spellings visibly disagree.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; witness carries the two renamings the chain computes for atom 2's children
(relation Chain (U Renaming Renaming))

(rule (;; atom 1 -- its node's slots are the pattern's
       (= p (App2 "f" pa a pb b))
       (= mp1 (map-union (map-image pa) (map-image pb)))     ; identity on atom 1's node slots
       (= avoid1 (map-image mp1)) ; slots already spoken for
       (= mb (compose mp1 pb))                ; ?b's renaming into slots(pattern)
       ;; atom 2 -- constrained by its root ?b, and by nothing else
       (= b (App2 "g" pc c pd d))
       (= dom2 (map-union (map-image pc) (map-image pd)))    ; identity on atom 2's node slots
       (RenamesToLeader b symb b)             ; symb in G(B)  -- Def. 6 for ?b
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb)          ; first
                                  (map-domain mb))) ; second: id on dom(mb)
       (= mc (compose mp2 pc))                ; ?c's renaming into slots(pattern)
       (= md (compose mp2 pd)))               ; ?d's
      ((Chain p mc md)))

;; the shorter spelling this replaced, kept to show the two agree here -- they
;; part company only when the inner node has a slot `mb` does not cover
(relation ChainShort (U Renaming Renaming))
(rule ((= p (App2 "f" pa a pb b))
       (= b (App2 "g" pc c pd d))
       (RenamesToLeader b symb b)
       (= mp2 (compose pb symb)))
      ((ChainShort p (compose mp2 pc) (compose mp2 pd))))

;; f( v[$0], g[$0,$1] )   with   g = g( v[$0], v[$1] )
(let $g  (App2 "g" (map-of 0 0) (Var 0)
                  (map-of 0 1) (Var 0)))
(let $f  (App2 "f" (map-of 0 0) (Var 0)
                  (map-of 0 0 1 1) $g))
(run 20)

;; mp2 is the identity, so ?c lands on $0 and ?d on $1 -- both in the pattern
;; slot space fixed by atom 1.
(check (Chain $f mc md)
       (= (map-get mc 0) 0)
       (= (map-get md 0) 1)
       (= (map-length mc) 1)
       (= (map-length md) 1))

;; here `mb` covers every slot of the inner node, so the short spelling agrees
(check (Chain $f mc md) (ChainShort $f mc md))

(pop)


;;; M3b.  Where the two spellings part company.
;;;
;;; `g`'s class is given a slot the parent's edge cannot name: g($0,$1) is unioned
;;; with a one-slot term, so $1 becomes redundant and the parent holds `g` at an
;;; edge whose domain is narrower than `g`'s own node slots.  The short spelling
;;; then computes an EMPTY renaming for `?d` -- a child with slot 0 reached by an
;;; edge with no entries, which Def. 4 forbids and which asserts the child is
;;; slotless.  `find-mapping-total` mints a name instead.
(push)

(relation Chain (U Renaming Renaming))
(rule ((= p (App2 "f" pa a pb b))
       (= mp1 (map-union (map-image pa) (map-image pb)))
       (= avoid1 (map-image mp1))
       (= mb (compose mp1 pb))
       (= b (App2 "g" pc c pd d))
       (= dom2 (map-union (map-image pc) (map-image pd)))
       (RenamesToLeader b symb b)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb)
                                  (map-domain mb)))
       (= mc (compose mp2 pc))
       (= md (compose mp2 pd)))
      ((Chain p mc md)))

(relation ChainShort (U Renaming Renaming))
(rule ((= p (App2 "f" pa a pb b))
       (= b (App2 "g" pc c pd d))
       (RenamesToLeader b symb b)
       (= mp2 (compose pb symb)))
      ((ChainShort p (compose mp2 pc) (compose mp2 pd))))

(let $g (App2 "g" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(let $k (App2 "k" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(union $g $k)
(let $f (App2 "f" (map-of 0 0) (Var 0) (map-of 0 0) $g))

(run 25)

;; the total spelling keeps a slot for ?d ...
(check (Chain $f mc md) (= (map-length md) 1))
;; ... the short one drops it, leaving a malformed empty edge
(check (ChainShort $f mc md) (= (map-length md) 0))
;; so on this e-graph they genuinely disagree
(fail (check (Chain $f mc md) (ChainShort $f mc md)))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M4.  Two atoms, the second rooted at a fresh variable.
;;;
;;;     ?p == (f ?x ?y),  ?q == (g ?x ?y)   =>   union ?p ?q
;;;
;;; Atom 2's root is fresh, so `mp'` is the unknown and every shared variable
;;; both constrains it and contributes part of it.  All the pairs go into one
;;; `find-mapping`; the sym_i are genuinely enumerated here, unlike the
;;; determined lookups of M2/M3.
;;;
;;; `TooEager` is the tempting demotion -- build `mp'` from `?x` alone, then
;;; probe `?y` against it.  It is incomplete: until the last shared variable is
;;; in, `mp'` is partial, and `(compose mp' q2)` for a not-yet-covered child
;;; truncates to something meaningless.  Whether `mp'` is already total is a
;;; property of the data, not of the rule.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation Join (U U Renaming))

(rule (;; atom 1 -- nothing known yet, so mp is the identity
       (= p (App2 "f" p1 x q1 y))
       (= mp1 (map-union (map-image p1) (map-image q1)))     ; identity on atom 1's node slots
       (= avoid1 (map-image mp1))
       (= mx (compose mp1 p1))
       (= my (compose mp1 q1))
       ;; atom 2 -- root fresh, so both shared children constrain mp' and both
       ;; contribute part of it.  All the pairs go into one call.
       (= q (App2 "g" p2 x q2 y))
       (= dom2 (map-union (map-image p2) (map-image q2)))    ; identity on atom 2's node slots
       (RenamesToLeader x sx x)
       (RenamesToLeader y sy y)
       (= mp' (find-mapping-total avoid1 dom2
                                  (compose mx sx) (compose my sy)   ; firsts
                                  p2 q2)))                          ; seconds
      ((Join p q mp')))

(relation TooEager (U U))
(rule ((= p (App2 "f" p1 x q1 y))
       (= q (App2 "g" p2 x q2 y))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2)))   ; from ?x alone
       (= sy (compose (inverse q1) (compose mp' q2)))   ; then probe ?y
       (RenamesToLeader y sy y))
      ((TooEager p q)))

(relation NaiveJoin (U U))
(rule ((= p (App2 "f" p1 x q1 y))
       (= q (App2 "g" p1 x q1 y)))                       ; same edges, no mp'
      ((NaiveJoin p q)))

;; (a) positive, mp' = identity.  im(p2) is only {$0}, so it never reaches $1
;;     and TooEager silently loses the match.
(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(run 20)
(check (Join $P $Q m) (= (map-length m) 2))
(fail (check (TooEager $P $Q)))
(pop)

;; (b) negative: g's two children are one renamed id where f's are two, so no
;;     injective mp' exists.  This is find-mapping's injectivity check doing
;;     the job of the crate's per-node disequality clique.
(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run 20)
(fail (check (Join $P $Q m)))
(fail (check (Join $Q $P m)))
(pop)

;; (c) f(a[$0,$1], v[$0]) vs g(a[$1,$0], v[$0]): `?y` pins mp'[$0] = $0, so sx
;;     must be the real swap.  Here im(p2) happens to cover all of q's slots,
;;     so TooEager works -- again a property of the data.
(push)
(let $a01 (App2 "a" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $a10 (App2 "a" (map-of 1 1) (Var 1) (map-of 0 0) (Var 0)))
(union $a01 $a10)
(run 20)

(let $P (App2 "f" (map-of 0 0 1 1) $a01 (map-of 0 0) (Var 0)))
(let $Q (App2 "g" (map-of 0 1 1 0) $a01 (map-of 0 0) (Var 0)))
(run 20)
(check (Join $P $Q m))
(check (TooEager $P $Q))
(fail (check (NaiveJoin $P $Q)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M5.  Three atoms: one rooted at a bound variable, one at a fresh one.
;;;
;;;     ?p == (f ?a ?b),  ?b == (g ?c ?d),  ?q == (h ?c ?a)
;;;
;;; The point of the section: the three cases compose, and the renamings they
;;; produce are all in one slot space -- the one atom 1 fixed.  Atom 3 is a
;;; join constrained through `?c` (reached via the chain, two atoms deep) and
;;; `?a` (reached directly from atom 1), which is the case a two-atom test
;;; cannot exercise.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation Tri (U U Renaming))

(rule (;; atom 1 -- nothing known yet, so mp is the identity
       (= p (App2 "f" pa a pb b))
       (= mp1 (map-union (map-image pa) (map-image pb)))
       (= avoid1 (map-image mp1))
       (= ma (compose mp1 pa))
       (= mb (compose mp1 pb))
       ;; atom 2 -- constrained by its root ?b
       (= b (App2 "g" pc c pd d))
       (= dom2 (map-union (map-image pc) (map-image pd)))
       (RenamesToLeader b symb b)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb)
                                  (map-domain mb)))
       ;; the avoid-set accumulates: atom 3 may not mint over anything atom 1 or
       ;; atom 2 already named
       (= avoid2 (map-union avoid1 (map-image mp2)))
       (= mc (compose mp2 pc))
       ;; atom 3 -- root fresh, constrained through ?c (depth 2) and ?a (depth 1)
       (= q (App2 "h" qc c qa a))
       (= dom3 (map-union (map-image qc) (map-image qa)))
       (RenamesToLeader c sc c)
       (RenamesToLeader a sa a)
       (= mp3 (find-mapping-total avoid2 dom3
                                  (compose mc sc) (compose ma sa)
                                  qc qa)))
      ((Tri p q mp3)))

(let $g (App2 "g" (map-of 0 0) (Var 0)
                 (map-of 0 1) (Var 0)))
(let $f (App2 "f" (map-of 0 0) (Var 0)
                 (map-of 0 0 1 1) $g))

;; (a) positive.  ?a and ?c are both v[$0] in pattern slots, and h's two
;;     children sit at the same slot $5, so mp' = {$5 -> $0}.
(push)
(let $h (App2 "h" (map-of 0 5) (Var 0)
                 (map-of 0 5) (Var 0)))
(run 25)
(check (Tri $f q m)
       (= (map-get m 5) 0)
       (= (map-length m) 1))
(pop)

;; (b) negative.  h's children sit at *different* slots, so mp' would have to
;;     send both $5 and $6 to $0 -- not injective, no match.
(push)
(let $h2 (App2 "h" (map-of 0 5) (Var 0)
                  (map-of 0 6) (Var 0)))
(run 25)
(fail (check (Tri $f q m)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M6.  The gap: fresh slots.
;;;
;;;     ?p == (f ?x ?y),  ?q == (g ?x ?z)   =>   union ?p (h ?y ?z)
;;;
;;; Only `?x` is shared, so `mp'` is pinned only on im(p2) and a slot of `q`
;;; outside that gets NO name in slots(pattern).  `find-mapping` returns the
;;; *minimal* map, exactly as Def. 8 asks, and a Renaming is only a map -- so
;;; the encoding silently DROPS the slot.  Dropping a slot asserts it is
;;; redundant, which is unsound.
;;;
;;; The reference crate does not have this gap: `enodes_applied` hands every
;;; bound or redundant slot a fresh name up front (the last line of the paper's
;;; S3.6 -- "it suffices to pick any fresh slot for them"), so there is never an
;;; unnamed slot to drop.  `find-mapping-total` ports that: same constraints and
;;; same injectivity check as `find-mapping`, plus a fresh name for every domain
;;; slot the constraints leave unnamed.  It takes its arguments flat as
;;;
;;;     (find-mapping-total avoid domain first... second...)
;;;
;;; where `domain`'s keys are the slots the result must cover and `avoid`'s
;;; slots are the ones it may not mint over.  Both are identity maps the caller
;;; already has: `(map-union (map-image p1) (map-image p2))` is the identity on a node's slots.
;;;
;;; What to measure: the natural check -- "did `?p` lose a slot?" -- does not
;;; isolate this bug.  `f(?x,?y) = h(?y,?z)` genuinely says `f` does not depend
;;; on `?x`, so `?p` losing `$0` is the correct reading of the rule and happens
;;; in the fixed version too (asserted in (c) below).  What actually goes wrong
;;; is narrower: the dropped slot leaves an edge whose domain is smaller than
;;; its child's slot set, which Def. 4 forbids.  `BadEdge` witnesses exactly
;;; that, and it is the assertion that separates (a) from (c).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; An edge `m : slots(c) -> slots(node)` must have dom(m) = slots(c).  A child's
;; live slot count is the length of its self-map, so a row where the two
;; disagree is malformed.
(relation BadEdge (String Renaming U))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c1 s c1)
       (!= (map-length m1) (map-length s)))
      ((BadEdge f m1 c1)))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c2 s c2)
       (!= (map-length m2) (map-length s)))
      ((BadEdge f m2 c2)))

;; (a) minimal mp' -- unsound: ?z's edge comes out empty
(push)
(rule ((= p (App2 "f" p1 x q1 y))
       (= q (App2 "g" p2 x q2 z))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2))))
      ((union p (App2 "h" q1 y (compose mp' q2) z))))

(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run 20)
(check (BadEdge "h" m c))                    ; the empty edge to ?z
(pop)

;; (b) guarded -- sound but incomplete: the rule simply declines to fire
(push)
(rule ((= p (App2 "f" p1 x q1 y))
       (= q (App2 "g" p2 x q2 z))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2)))
       (= mz (compose-total mp' q2)))     ; declines rather than dropping ?z's slot
      ((union p (App2 "h" q1 y mz z))))

(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run 20)
(fail (check (BadEdge f m c)))                       ; nothing malformed ...
(fail (check (RenamesToLeader $P m $P) (= (map-length m) 1)))  ; ... and nothing derived
(pop)

;; where ?z's slots are determined it still fires
(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run 20)
(check (RenamesToLeader $P m $P) (= (map-length m) 2))
(pop)

(pop)

;; (c) total mp' -- sound AND fires
(push)
(rule ((= p (App2 "f" p1 x q1 y))
       (= q (App2 "g" p2 x q2 z))
       (RenamesToLeader x sx x)
       (= pat (map-union (map-image p1) (map-image q1)))            ; identity on slots(pattern)
       (= dom (map-union (map-image p2) (map-image q2)))            ; identity on slots(node 2)
       (= mp' (find-mapping-total pat dom (compose p1 sx) p2)))
      ((union p (App2 "h" q1 y (compose mp' q2) z))))

(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run 20)
(fail (check (BadEdge f m c)))                       ; ?z keeps its slot
;; and the redundancy the rule really does imply is still derived -- which is
;; why this assertion cannot be used to tell (a) from (c)
(check (RenamesToLeader $P m $P) (= (map-length m) 1))
(pop)

;; the determined case is unchanged: nothing is minted
(push)
(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run 20)
(check (RenamesToLeader $P m $P) (= (map-length m) 2))
(pop)

(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M6b.  The other way to break Def. 4: a variable wider than its class.
;;;
;;; M6 above is about a slot the *root's* edge fails to reach.  This one needs no
;;; minting at all and no chain -- a single atom does it.
;;;
;;; A renaming is read off a matched NODE, so its domain is the node's slots.  A
;;; node may carry a slot its class does not depend on -- that is what redundancy
;;; is, and Def. 4 permits it for nodes while forbidding it for edges.  A pattern
;;; variable stands for a CLASS, so writing its renaming straight into a built
;;; node gives that node an edge naming a slot the child does not have.
;;;
;;; The fix is one atom per variable: `(= cs (ClassSlots X))` and use
;;; `(compose m cs)`, which restricts `m` to the slots the class really has.
;;; `ClassSlots` is the right thing to restrict by and a symmetry is not: a
;;; symmetry is whichever self-loop the join happens to bind, and one of those can
;;; itself be wider than the class, in which case it narrows nothing.
;;;
;;; Note this does NOT repair itself.  The machinery's child-update rule deletes a
;;; row whose child has since narrowed, but the action rebuilds it on the next
;;; iteration, so the violation is a stable oscillation rather than a transient.
;;; It survives to `(run 200)`.
;;;
;;; `C15-action-child-narrowed-to-its-class` in `xdiff.py` is this e-graph, and
;;; `XDIFF_BUGS=wide-kids` is the version below without the narrowing.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; The witness goes in its OWN ruleset and is run once at the end.  A relation is
;; monotone, so a witness sharing the default ruleset also fires mid-repair and
;; keeps the fact after the offending row is gone -- it would answer "was there
;; ever a bad edge?", and the answer to that is yes even when all is well.
(ruleset m6b)
(relation BadEdge (String Renaming U))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c1 s c1)
       (= s (compose s s))                   ; a partial identity: c1's slots are inside dom(s)
       (< (map-length s) (map-length m1)))
      ((BadEdge f m1 c1)) :ruleset m6b)
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c2 s c2)
       (= s (compose s s))
       (< (map-length s) (map-length m2)))
      ((BadEdge f m2 c2)) :ruleset m6b)

;; ?x3 == (h ?x1 ?x2)  =>  union ?x1 (h ?x2 ?x1)
;;
;; The action's root ?x1 is a child variable and so is the other child ?x2, so
;; both renamings come off the matched node and both need narrowing.

;; two unions through a shared sub($0,$0) drive the h class's slot set down, so a
;; renaming read off an h node names a slot the class no longer has
(let $h  (App2 "h" (map-empty) (Null) (map-of 0 0) (Var 0)))
(let $g  (App2 "g" (map-empty) (Null) (map-of 0 2) (Var 0)))
(let $s  (App2 "sub" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(union $h $s)
(union $g $s)

;; (a) stored renamings used as written -- this is `XDIFF_BUGS=wide-kids`
(push)
(rule ((= x3 (App2 "h" m1 x1 m2 x2)))
      ((union x1 (App2 "h" m2 x2 m1 x1))))
(run 20)
(run m6b 1)
(check (BadEdge "h" m c))            ; an edge naming a slot its child lacks
(pop)

;; (b) every variable narrowed to its class
(push)
(rule ((= x3 (App2 "h" m1 x1 m2 x2))
       (= cs1 (ClassSlots x1))
       (= cs2 (ClassSlots x2)))
      ((union x1 (App2 "h" (compose m2 cs2) x2 (compose m1 cs1) x1))))
(run 20)
(run m6b 1)
(fail (check (BadEdge "h" m c)))     ; nothing malformed
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M7.  A slot literal: eta.
;;;
;;;     ?e == (lambda $s ?b),  ?b == (app ?f ?arg),  ?arg == (var $s)
;;;       =>  ?e = ?f      if $s not in slots(?f)
;;;
;;; Flattened, this is a pure chain -- and it is the case where flattening has
;;; to be handled with care, because `$s` is written both as the binder and
;;; inside atom 3.  It works here because the machinery represents `(var $s)`
;;; as a `(Var 0)` child, so "the argument is the bound slot" reduces to an
;;; ordinary Def. 6 check on that child rather than to a slot literal shared
;;; across two independently-renamed atoms.  Write a slot literal that a
;;; *sibling* atom also mentions and the binder escapes instead; that is the
;;; caution at the top of the file.
;;;
;;; The side condition is a `map-not-contains` on the inverse -- a genuine Rust
;;; side-condition on the computed renaming, which is what "$s is not free in
;;; ?f" becomes once slots are explicit.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule (;; atom 1 -- nothing known yet, so mp is the identity
       (= e (App2 "lambda" mvar (Var 0) mb b))
       (= mp1 (map-union (map-image mvar) (map-image mb)))
       (= avoid1 (map-image mp1))
       (= v (map-get (compose mp1 mvar) 0))       ; the bound slot, in pattern slots
       (= mb1 (compose mp1 mb))
       ;; atom 2 -- constrained by its root ?b AND by the slot literal `$s`, which
       ;; atom 1 already pinned to `v`.  Constraining with it is the point:
       ;; checking `(= (compose m2 mv) mvar)` afterwards comes too late, because by
       ;; then mp2 has already minted its own name for the same binder and nothing
       ;; can revise a mint.
       (= b (App2 "app" mf f mv (Var 0)))
       (= dom2 (map-union (map-image mf) (map-image mv)))
       (RenamesToLeader b symb b)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb1 symb) (map-insert (map-empty) 0 v)
                                  (map-domain mb1) mv))
       (map-not-contains (inverse (compose mp2 mf)) v))   ; $s not free in ?f
      ((RenamesToLeader e (compose mp2 mf) f)))

;; positive: (lambda $5 (app c (var $5)))  ->  c
(push)
(let $c    (App2 "c" (map-empty) (Null) (map-empty) (Null)))
(let $body (App2 "app" (map-empty) $c (map-of 5 5) (Var 5)))
(let $lam  (App2 "lambda" (map-of 5 5) (Var 5)
                         (map-of 5 5) $body))
(run 30)
(check (RenamesToLeader $lam m $c))
(pop)

;; negative: the bound slot is free in ?f -- (lambda $5 (app (var $5) (var $5)))
(push)
(let $body (App2 "app" (map-of 5 5) (Var 5)
                      (map-of 5 5) (Var 5)))
(let $lam  (App2 "lambda" (map-of 5 5) (Var 5)
                         (map-of 5 5) $body))
(run 30)
(fail (check (RenamesToLeader $lam m (Var 0))))
(pop)

;; negative: wrong slot -- (lambda $5 (app c (var $6)))
(push)
(let $c    (App2 "c" (map-empty) (Null) (map-empty) (Null)))
(let $body (App2 "app" (map-empty) $c (map-of 6 6) (Var 6)))
(let $lam  (App2 "lambda" (map-of 5 5) (Var 5)
                         (map-of 5 5 6 6) $body))
(run 30)
(fail (check (RenamesToLeader $lam m $c)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M8.  Actions: union over renamed ids.
;;;
;;; The paper's union takes renamed ids -- S3.5 is union(m1*a1, m2*a2), and
;;; which of redundancy, a new group element, or an e-class merge it produces
;;; depends on those renamings.  egglog's `union` takes e-classes, i.e. only the
;;; case where both renamings are the identity.  So a compiler emits either
;;;
;;;   * both operands at the identity          ->  (union A B)
;;;   * otherwise, insert the fact directly    ->  (RenamesToLeader A m B)
;;;
;;; and lets the machinery's transitivity / single-parent rules re-orient it.
;;; The relation form below states it covariantly in G(p) so the rule does not
;;; have to pick an orientation at all.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation Union' (Renaming U Renaming U))

(rule ((= p (App2 "f" p1 x q1 y))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= q (App2 "g" p2 x q2 y))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader x sx x)
       (RenamesToLeader y sy y)
       (RenamesToLeader p s p)
       (= r (find-mapping-total avoid1 dom2
                                (compose (compose mp1 p1) sx)
                                (compose (compose mp1 q1) sy)
                                p2 q2)))
      ((Union' s p (compose s r) q)))

(let $P (App2 "f" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q (App2 "g" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(run 20)
(check (Union' s $P r $Q))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M9.  The avoid-set, and why it accumulates.
;;;
;;; `find-mapping-total` is a pure function of its arguments: it sees one atom at a
;;; time and cannot know what another atom invented.  The avoid-set is how a rule
;;; threads that through as an ordinary value -- a running `map-union` of
;;; `(map-image mp)`, one per atom already compiled:
;;;
;;;     (= idm1 (map-image mp1))                    ; atom 1's slots
;;;     (= mp2  (find-mapping-total idm1 dom2 ...))  ; atom 2 avoids them
;;;     (= av   (map-union idm1 (map-image mp2)))    ; accumulate
;;;     (= mp3  (find-mapping-total av   dom3 ...))  ; atom 3 avoids both
;;;
;;; Identity maps never conflict under `map-union`, so the union is always defined.
;;;
;;; Drop the accumulation and two atoms that both invent pick the same slot, each
;;; choosing the smallest it believes to be free -- here that identifies `?u` with
;;; `?v`.  In the harness that is `C7-redundant-distinct-vars`, which without the
;;; accumulation goes order dependent and loses a match.
;;;
;;; Only smallest-unused needs this.  Minting above the largest name in play is
;;; self-avoiding and passes the corpus with no accumulation at all, so the
;;; avoid-set is the price of keeping slot names small.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;;;     ?p == (add ?a ?b),  ?a == (sub ?u ?u),  ?b == (sub2 ?v ?v)
;;;
;;; `sub($0,$0)` and `sub2($1,$1)` are each unioned with `null`, so each has a slot
;;; its class does not depend on.  The root `add(null,null)` has no slots at all, so
;;; nothing pins `?u` or `?v` and both atoms have to invent.

(let $sub  (App2 "sub"  (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(let $sub2 (App2 "sub2" (map-of 0 1) (Var 0) (map-of 0 1) (Var 0)))
(union $sub  (Null))
(union $sub2 (Null))
(let $add (App2 "add" (map-empty) (Null) (map-empty) (Null)))

;; what each atom invents for ?u and ?v, accumulated and not
(relation Accum   (Renaming Renaming))
(relation NoAccum (Renaming Renaming))

(rule ((= V (App2 "add" p1 C4 p2 C5))
       (= mp1 (map-union (map-image p1) (map-image p2)))
       (= idm1 (map-image mp1))
       (= C4 (App2 "sub" p12 K1 p13 K1))
       (RenamesToLeader C4 sym2 C4)
       (= mp2 (find-mapping-total idm1 (map-union (map-image p12) (map-image p13))
                                  (compose (compose mp1 p1) sym2)
                                  (map-domain (compose mp1 p1))))
       (= av (map-union idm1 (map-image mp2)))     ; accumulate
       (= C5 (App2 "sub2" p24 K2 p25 K2))
       (RenamesToLeader C5 sym3 C5)
       (= mp3 (find-mapping-total av (map-union (map-image p24) (map-image p25))
                                  (compose (compose mp1 p2) sym3)
                                  (map-domain (compose mp1 p2)))))
      ((Accum (compose mp2 p12) (compose mp3 p24))))

(rule ((= V (App2 "add" p1 C4 p2 C5))
       (= mp1 (map-union (map-image p1) (map-image p2)))
       (= idm1 (map-image mp1))
       (= C4 (App2 "sub" p12 K1 p13 K1))
       (RenamesToLeader C4 sym2 C4)
       (= mp2 (find-mapping-total idm1 (map-union (map-image p12) (map-image p13))
                                  (compose (compose mp1 p1) sym2)
                                  (map-domain (compose mp1 p1))))
       (= C5 (App2 "sub2" p24 K2 p25 K2))
       (RenamesToLeader C5 sym3 C5)
       (= mp3 (find-mapping-total idm1 (map-union (map-image p24) (map-image p25))
                                  (compose (compose mp1 p2) sym3)
                                  (map-domain (compose mp1 p2)))))
      ((NoAccum (compose mp2 p12) (compose mp3 p24))))

(run 20)

;; accumulated: ?u and ?v land on different pattern slots
(check (Accum (map-of 0 0) (map-of 0 1)))
(check (Accum mu mv) (!= mu mv))

;; not accumulated: both invent slot 0, so the two variables collapse
(check (NoAccum mu mv) (= mu mv))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M10.  A nested right-hand side.
;;;
;;;     ?p == (f ?a ?b)   =>   union ?p (h (g ?a ?b) ?b)
;;;
;;; The paper's `let_app` and its associativity rules build a right-hand side that
;;; is a *tree*, so an intermediate node has to exist before the outer one can point
;;; at it -- one `let` per built node, innermost first.
;;;
;;; The edge from the outer node to the inner one is the identity on the inner
;;; node's slots.  An action is already in pattern slot space, so there is no
;;; renaming between two built nodes; and a built node's slots are the union of its
;;; edges' images, which is what makes the walk bottom-up.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= p (App2 "f" pa a pb b))
       (= mp1 (map-union (map-image pa) (map-image pb)))   ; atom 1, mp = identity
       (= ma (compose mp1 pa))                             ; ?a into pattern slots
       (= mb (compose mp1 pb))                             ; ?b's
       (RenamesToLeader p symp p))
      ((let inner (App2 "g" ma a mb b))
       ;; identity on `$inner`'s slots, not a renaming
       (let outer (App2 "h" (map-union (map-image ma) (map-image mb)) inner mb b))
       (RenamesToLeader outer (compose mp1 symp) p)))

(let $f (App2 "f" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(run 20)

;; h(g($0,$1), $1) has been put in f($0,$1)'s class
(let $g (App2 "g" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(let $h (App2 "h" (map-of 0 0 1 1) $g (map-of 0 1) (Var 0)))
(run 20)

(check (RenamesToLeader $f m1 leader)
       (RenamesToLeader $h m2 leader))

(pop)
