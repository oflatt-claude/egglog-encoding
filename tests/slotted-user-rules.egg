;;; Multipattern e-matching, hand-encoded on top of the slotted machinery.
;;;
;;; THE ENCODING, one shape of user rule per section: the problem the shape poses, the
;;; construction that solves it, and then the rule -- the one a compiler emits, one per
;;; section and nothing else.  Read it top to bottom.  `slotted-user-rules.md` is the prose
;;; version; three compilers emit this same recipe and must stay in step with it --
;;; `xdiff.py compile_rule` (the toy language, checked against the crate),
;;; `xarray.py compile_array_rule` (the paper's array language, likewise) and
;;; `gen-sdql-rules.py` (SDQL, self-checked only so far).
;;;
;;; No terms, no schedules, no assertions, no wrong versions.
;;; `tests/slotted-user-rules-tests.egg` includes this file and supplies all of those, so
;;; the rules below are the ones under test rather than a copy of them, and it is also where
;;; the counter-examples live -- for each construction, the spelling it rules out together
;;; with the e-graph that tells the two apart.
;;;
;;; OPERATOR NAMES.  Every rule below is live at once, so each section gets operators of its
;;; own: section N spells them `fN`, `gN`, `hN` (M9 keeps `lambda9`/`app9`, whose shape is
;;; the point).  A term built for one section therefore cannot match another section's rule,
;;; which is what lets the tests include this file whole instead of copying rules out of it.
;;; A counter-example over there takes a further letter where it would otherwise collide with
;;; the rule it is contrasted with -- `f3a`, `f3b` against this file's `f3` -- so that rule
;;; cannot mask it.
;;;
;;; Conventions:
;;;   (compose a b)           = a . b, b first, and TRUNCATES: keys b sends outside dom(a)
;;;                             are dropped
;;;   (compose-total a b)     = the same, but fails rather than dropping a key
;;;   (map-image m)           = identity on im(m);  (map-domain m) = identity on dom(m)
;;;   (find-mapping-total avoid domain first... second...)
;;;                           = least injective m with m . second_i = first_i, made total on
;;;                             the keys of `domain`, minting outside `avoid`'s slots (M3)
;;;   (App2 f m1 c1 m2 c2)    = f(m1*c1, m2*c2),  mi : slots(ci) -> slots(node)
;;;   (RenamesToLeader a m b) = a = m*b, m : slots(b) -> slots(a); a self-loop is a member
;;;                             of G(a)
;;;   (Equated a m b)         = the same fact with no orientation picked -- what an ACTION
;;;                             writes; the machinery derives the oriented row (M10)
;;;   (ClassSlots c)          = identity on the slots c depends on; only ever narrows (M8)
;;;
;;; Scaffolding names, the same in every section:
;;;   pN, qN   atom N's own stored edges -- its first and second child column
;;;   mX       variable X's renaming into slots(pattern)
;;;   mpN      atom N's renaming, taking its node's slots into pattern slots
;;;   domN     identity on atom N's node's slots (the union of its edge images)
;;;   avoidN   identity on the pattern slots already named after atom N
;;;   csX      (ClassSlots X), the narrowing for pattern variable X
;;;   symX     a self-loop of X, i.e. a symmetry
;;;
;;; Contents, in order.  Each section names the harness cases covering it, and
;;; `slotted-user-rules.md` refers to these labels.
;;;   M1   one atom, nothing shared
;;;   M2   a repeated variable -- the Def. 6 check
;;;   M3   why an atom's renaming has to be total
;;;   M4   two atoms, chained -- the primitive in use
;;;   M5   the avoid-set, and why it accumulates
;;;   M6   two atoms, joined on a fresh root
;;;   M7   three atoms -- the cases compose
;;;   M8   a variable wider than its class
;;;   M9   a slot literal (eta)
;;;   M10  actions: concluding over renamed ids
;;;   M11  a nested right-hand side
;;;
;;; Every rule below assumes the phased schedule the tests run: the invariant rules are
;;; saturated between user-rule steps, so a rule here only ever matches nodes that are
;;; already canonical.
;;;
;;;     (run-schedule (saturate (run slotted))
;;;                   (repeat N (seq (run) (saturate (run slotted)))))

(include "tests/slotted-egraph-encoding-11.egg")


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M1.  One atom, nothing shared.
;;;
;;;     ?e == (f1 ?a ?b)   =>   union ?e (f1 ?b ?a)
;;;
;;; The LHS is flattened into depth-1 atoms `?v == (Op ?c1 ?c2)`, one per e-node with every
;;; child a bare variable, and each becomes one egglog atom, so egglog's join does the
;;; e-class level for free.  With a single atom nothing is known before it: its node's slots
;;; ARE the pattern's slots and the stored edges already are the children's renamings into
;;; them, so there is nothing to constrain.  One extra Renaming column per child, no joins.
;;;
;;; Covered by: M1-commutativity.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule ((= e (App2 "f1" p1 a q1 b)))
      ((union e (App2 "f1" q1 b p1 a))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M2.  One atom, a repeated variable -- the Def. 6 check.
;;;
;;;     ?e == (f2 ?x ?x)   =>   union ?e ?x
;;;
;;; What the join does NOT give is agreement of the renamings: egglog's variable equality
;;; is e-class equality, while slotted equality is equality of renamed ids.  Supplying that
;;; difference is what every section here is about, and this is its smallest instance.
;;;
;;; A variable `x` compiles to two egglog variables -- its leader `X` and a renaming
;;; `mx : slots(X) -> slots(pattern)` -- standing for the paper's `beta(x) = mx * X`.  Here
;;; the two occurrences are `p1*X` and `q1*X`, and Def. 6 says they agree iff `p1^-1 . q1`
;;; is in G(X).  Both edges come off the matched row, so that group element is determined,
;;; and the rule states exactly the condition: a self-loop of `X` carrying it must exist.
;;;
;;; Demanding instead that the two edges be *equal* -- what a non-slotted encoding would
;;; write -- is a strictly STRONGER condition than Def. 6, since `p1 = q1` makes the group
;;; element the identity, which is in every G(X).  So that rule is incomplete: it misses
;;; matches Def. 6 admits, and a symmetric child is where the two part ways.  `NaiveHit` in
;;; the tests file is that rule.
;;;
;;; Covered by: C1, C4, S1.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(relation Hit (U U))

;; Both edges come off the matched row, so the group element Def. 6 asks for is determined:
;; it is `p1^-1 . q1`, and the rule requires a self-loop of `X` carrying exactly it.
(rule ((= e (App2 "f2" p1 x q1 x))
       (= symx (compose (inverse p1) q1))
       (RenamesToLeader x symx x))
      ((Hit e x)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M3.  Why an atom's renaming has to be TOTAL.
;;;
;;;     ?p == (f3 ?x ?y),  ?q == (g3 ?x ?z)   =>   union ?p (h3 ?y ?z)
;;;
;;; The smallest shape whose renamings are not determined, and the reason every atom from M4
;;; on is solved with `find-mapping-total`.  Only `?x` is shared, so atom 2's renaming is
;;; pinned on im(p2) and nowhere else: a slot of `?q` outside it gets NO name in
;;; slots(pattern).  S3.6 asks for the *minimal* renaming carrying the node into pattern
;;; slots, and a minimal one simply omits that slot.
;;;
;;; An EDGE may not omit a slot.  Def. 5 makes `dom(m) = slots(a)` the leader condition on a
;;; renamed id `m*a`, and Def. 7 requires every renamed id inside a shape to be a leader, so
;;; a stored edge's domain is exactly its child's slot set.  A dropped slot leaves a row
;;; asserting the child does not depend on a slot it has -- unsound, and the tests file's
;;; counter-example (a) is that rule.
;;;
;;; What licenses the fix is Def. 8, which asks only for SOME extension `m''` of `m'` and
;;; says so: it "allows an arbitrary renaming for the redundant slots".  Any total extension
;;; over the unpinned slots therefore represents the same e-nodes.  S3.6 says it operationally in its closing line -- if a class "contains an
;;; e-node with a redundant or bound slot ... it suffices to pick any fresh slot for them" --
;;; and the crate does exactly that in `enodes_applied`, freshening every slot outside the
;;; class's slot set before it matches.  `find-mapping-total` is that: `find-mapping`'s
;;; constraints and injectivity check, plus a minted name for every domain slot they leave
;;; unnamed.  `domain`'s keys are the slots the result must cover, `avoid`'s are the ones it
;;; may not mint over, and both are identity maps the caller already has.  This is the
;;; spelling every section below uses.
;;;
;;; Declining to fire instead -- `compose-total` in place of `compose` -- is sound but
;;; incomplete; that is counter-example (b).  Note that `?p` losing a slot is NOT the
;;; symptom: `f3(?x,?y) = h3(?y,?z)` genuinely says `f3` does not depend on `?x`, so the
;;; redundancy is derived by the fixed rule too.
;;;
;;; Covered by: M3-one-shared-var-two-ops, U1.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule ((= p (App2 "f3" p1 x q1 y))
       (= q (App2 "g3" p2 x q2 z))
       (RenamesToLeader x symx x)
       (= avoid1 (map-union (map-image p1) (map-image q1)))         ; identity on slots(pattern)
       (= dom2 (map-union (map-image p2) (map-image q2)))           ; identity on slots(node 2)
       (= mp2 (find-mapping-total avoid1 dom2 (compose p1 symx) p2)))
      ((union p (App2 "h3" q1 y (compose mp2 q2) z))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M4.  Two atoms, chained -- the primitive in use.
;;;
;;;     ?p == (f4 ?a ?b),  ?b == (g4 ?c ?d)
;;;
;;; Every flattened nested pattern produces this shape, so it is the one that has to be
;;; cheap.  It is also where the per-atom step the rest of the file reuses first appears.  A
;;; compiler walks the atoms in a connected order -- that is compile time, not an order egglog
;;; evaluates the finished body in -- and for atom N it emits:
;;;
;;;     mpN is the least renaming, total on atom N's node slots, agreeing with every
;;;     constraint the atoms before it left -- its root if one of them bound it, every child
;;;     one of them bound, every slot literal one of them pinned.  One `find-mapping-total`,
;;;     avoiding the slots named so far.
;;;
;;; The cases -- first atom / root known / children known -- are only which constraints
;;; happen to exist, not three different rules.  Taking one constraint per case is
;;; under-constrained: for a chain the tempting `(compose q1 symb)` drops an inner slot the
;;; root's edge does not reach, M3's bug again, and the tests file's counter-example is an
;;; e-graph where the two visibly disagree.
;;;
;;; Covered by: C2-chain.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; witness carries the two renamings the chain computes for atom 2's children
(relation Chain (U Renaming Renaming))

(rule (;; atom 1 -- nothing known, so mp1 is the identity on its node's slots, and those
       ;; slots ARE slots(pattern)
       (= p (App2 "f4" p1 a q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))             ; slots already spoken for
       (= mb (compose mp1 q1))                ; ?b's renaming into slots(pattern)
       ;; atom 2 -- its root ?b is the only constraint there is, and that one G-join is
       ;; also the Def. 6 check for ?b's second occurrence
       (= b (App2 "g4" p2 c q2 d))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader b symb b)             ; symb in G(B)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb)          ; first
                                  (map-domain mb)))          ; second: id on dom(mb)
       (= mc (compose mp2 p2))                ; ?c's renaming into slots(pattern)
       (= md (compose mp2 q2)))               ; ?d's
      ((Chain p mc md)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M5.  The avoid-set, and why it accumulates.
;;;
;;;     ?p == (f5 ?a ?b),  ?a == (g5 ?u ?u),  ?b == (h5 ?v ?v)
;;;
;;; `find-mapping-total` is a pure function of its arguments: one call sees one atom's
;;; constraints, and nothing of what another atom invented.  The avoid-set threads that
;;; through as an ordinary value -- a running `map-union` of `(map-image mpN)`, one per atom
;;; the compiler has emitted:
;;;
;;;     (= avoid1 (map-image mp1))                      ; atom 1's slots
;;;     (= mp2    (find-mapping-total avoid1 dom2 ...))  ; atom 2 avoids them
;;;     (= avoid2 (map-union avoid1 (map-image mp2)))    ; accumulate
;;;     (= mp3    (find-mapping-total avoid2 dom3 ...))  ; atom 3 avoids both
;;;
;;; This is S3.6's own condition.  Its matching step requires the union of `m_p` and `m'_p`
;;; to be a bijective renaming, where `m'_p` is the atom's own minimal renaming and `m_p` is
;;; what the atoms before it accumulated -- exactly `avoid` plus `find-mapping`'s injectivity
;;; check.  Identity maps never conflict under `map-union`, so the union is always defined.
;;;
;;; Drop the accumulation and two atoms that both invent pick the same slot, each choosing
;;; the smallest it believes to be free -- here that identifies `?u` with `?v`, which is
;;; `NoAccum` in the tests file.  The accumulation is what smallest-unused minting costs: it
;;; reuses low names, so it has to be told which are taken.  `slotted-user-rules.md` records
;;; the measurements behind that policy choice and what the alternative was.
;;;
;;; Covered by: C7-redundant-distinct-vars, which without the accumulation goes order
;;; dependent and loses a match.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; witness carries what each of the two inventing atoms picked for ?u and ?v
(relation Accum (Renaming Renaming))

(rule ((= p (App2 "f5" p1 a q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= a (App2 "g5" p2 u q2 u))
       (RenamesToLeader a syma a)
       (= mp2 (find-mapping-total avoid1 (map-union (map-image p2) (map-image q2))
                                  (compose (compose mp1 p1) syma)
                                  (map-domain (compose mp1 p1))))
       (= avoid2 (map-union avoid1 (map-image mp2)))     ; accumulate
       (= b (App2 "h5" p3 v q3 v))
       (RenamesToLeader b symb b)
       (= mp3 (find-mapping-total avoid2 (map-union (map-image p3) (map-image q3))
                                  (compose (compose mp1 q1) symb)
                                  (map-domain (compose mp1 q1)))))
      ((Accum (compose mp2 p2) (compose mp3 p3))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M6.  Two atoms, joined on a fresh root.
;;;
;;;     ?p == (f6 ?x ?y),  ?q == (g6 ?x ?y)   =>   union ?p ?q
;;;
;;; Atom 2's root is fresh, so `mp2` is entirely unknown and every shared variable both
;;; constrains it and contributes part of it: all the pairs go into ONE `find-mapping-total`.
;;; `symx` and `symy` are free variables, so the join enumerates G(X) and G(Y) -- as it does
;;; for `symb` in M4, but several groups at once, and every element feeds the same call.  M2
;;; is the contrast: there both edges come off one matched row, so the group element is
;;; determined and the `RenamesToLeader` atom is a lookup.
;;;
;;; The tempting demotion is `TooEager` in the tests file: solve `mp2` from `?x` alone, giving
;;; `p1 . symx . p2^-1`, and require `?y` to agree with THAT.  That map is defined only on
;;; im(p2), the slots `?x`'s edge reaches, so `(compose mp2 q2)` truncates wherever `?y`'s
;;; edge leaves im(p2): the agreement it asks of `?y` is about a map that does not cover
;;; `?y`'s slots.  One call over all the pairs states a single condition instead, with no
;;; operand partial.  Whether im(p2) happens to cover the whole node is a property of the
;;; data, not of the rule.
;;;
;;; Covered by: C3-join.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(relation Join (U U Renaming))

(rule (;; atom 1 -- nothing known, so mp1 is the identity on its node's slots
       (= p (App2 "f6" p1 x q1 y))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= mx (compose mp1 p1))
       (= my (compose mp1 q1))
       ;; atom 2 -- root fresh, so every shared child both constrains mp2 and contributes
       ;; part of it, in one call
       (= q (App2 "g6" p2 x q2 y))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader x symx x)
       (RenamesToLeader y symy y)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mx symx) (compose my symy)   ; firsts
                                  p2 q2)))                              ; seconds
      ((Join p q mp2)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M7.  Three atoms -- the cases compose.
;;;
;;;     ?p == (f7 ?a ?b),  ?b == (g7 ?c ?d),  ?q == (h7 ?c ?a)
;;;
;;; Atom 2 is M4's chain, atom 3 is M6's join, and every renaming they produce lives in one
;;; slot space -- the one atom 1 fixed.  Atom 3 is constrained through `?c`, reached via the
;;; chain two atoms deep, and through `?a`, reached straight from atom 1: the case no
;;; two-atom test can exercise.  The avoid-set accumulates across all three (M5).
;;;
;;; Covered by: C10-chain-then-join.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(relation Tri (U U Renaming))

(rule (;; atom 1 -- nothing known, so mp1 is the identity on its node's slots
       (= p (App2 "f7" p1 a q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= ma (compose mp1 p1))
       (= mb (compose mp1 q1))
       ;; atom 2 -- constrained by its root ?b
       (= b (App2 "g7" p2 c q2 d))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader b symb b)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb)
                                  (map-domain mb)))
       ;; atom 3 may not mint over anything atom 1 or atom 2 already named
       (= avoid2 (map-union avoid1 (map-image mp2)))
       (= mc (compose mp2 p2))
       ;; atom 3 -- root fresh, constrained through ?c (depth 2) and ?a (depth 1)
       (= q (App2 "h7" p3 c q3 a))
       (= dom3 (map-union (map-image p3) (map-image q3)))
       (RenamesToLeader c symc c)
       (RenamesToLeader a syma a)
       (= mp3 (find-mapping-total avoid2 dom3
                                  (compose mc symc) (compose ma syma)
                                  p3 q3)))
      ((Tri p q mp3)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M8.  A variable wider than its class -- the ClassSlots narrowing.
;;;
;;;     ?x3 == (f8 ?x1 ?x2)   =>   union ?x1 (f8 ?x2 ?x1)
;;;
;;; The other way to break the edge condition, needing no minting and no chain -- one atom
;;; does it.  A renaming is read off a matched NODE, so its domain is the node's slots, and
;;; Def. 4 permits a node to carry slots its class does not: it requires only `S` included in
;;; `im(m)`, and calls the extras redundant.  An edge has no such slack (M3).  A variable
;;; stands for a CLASS, so writing a renaming read off a node straight into a built node would
;;; name a slot the child does not have.
;;;
;;; The fix is one atom per variable -- `(= csX (ClassSlots X))` -- and `(compose m csX)`
;;; wherever the renaming is used or written.  A symmetry is NOT a substitute: the self-loop
;;; the machinery stores for a node is the identity on that NODE's slot set, so it can be
;;; exactly as wide as the renaming it was meant to narrow.
;;;
;;; The action's root ?x1 is a child variable and so is the other child ?x2, so both
;;; renamings come off the matched node and both need narrowing.
;;;
;;; Covered by: C15-action-child-narrowed-to-its-class.  The un-narrowed spelling was the
;;; `wide-kids` mutant, removed from `XDIFF_BUGS` once it stopped discriminating -- the
;;; property is checked directly by `def4-edges.py` instead.  The tests file keeps the
;;; spelling as a counter-example.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule ((= x3 (App2 "f8" p1 x1 q1 x2))
       (= csx1 (ClassSlots x1))
       (= csx2 (ClassSlots x2)))
      ((union x1 (App2 "f8" (compose q1 csx2) x2 (compose p1 csx1) x1))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M9.  A slot literal: eta.
;;;
;;;     ?e == (lambda9 $s ?b),  ?b == (app9 ?f ?arg),  ?arg == (var $s)
;;;       =>  ?e = ?f      if $s not in slots(?f)
;;;
;;; Flattened this is a pure chain, and it is where flattening needs care, because `$s` is
;;; written both as the binder and inside atom 3.  It works because the machinery represents
;;; `(var $s)` as a `(Var 0)` child, so "the argument is the bound slot" reduces to an
;;; ordinary Def. 6 check on that child.  HAZARD: flattening is not always meaning-preserving.
;;; A nested pattern is matched under one renaming for the whole pattern, a flattened one gets
;;; a renaming per atom, so a slot written both under a binder and outside it means different
;;; things in the two forms and the binder escapes.  The crate's
;;; `flattening_is_not_faithful_for_a_sibling_slot_literal` is that case; a flattener has to
;;; reject or rename those.
;;;
;;; The side condition is a `map-not-contains` on the inverse -- what "$s is not free in ?f"
;;; becomes once slots are explicit.
;;;
;;; Covered by: `eta-fires` and `eta-blocked` in xarray.py, whose `vac` mode also confirms
;;; the side condition changes the answer on both sides; the same mechanism on binder shapes
;;; is B3, B4 and the `slot-late` mutant, and the slot side condition is CD1-CD4.  xdiff.py's
;;; `atom` form cannot express this shape: two children only, and a slot literal there needs
;;; `Bind` or a unary `Var(Slot)`.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (;; atom 1 -- nothing known, so mp1 is the identity on its node's slots
       (= e (App2 "lambda9" p1 (Var 0) q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= v (map-get (compose mp1 p1) 0))       ; the bound slot, in pattern slots
       (= mb (compose mp1 q1))
       ;; atom 2 -- constrained by its root ?b AND by the slot literal `$s`, which atom 1
       ;; pinned to `v`.  The pinning has to be one of `find-mapping-total`'s constraints --
       ;; `mp2 . q2 = {0 -> v}` -- and not a test on its result: a call that does not carry
       ;; it is free to mint a fresh name for that slot, and `mp2` is then a map no later
       ;; equality can repair.
       (= b (App2 "app9" p2 f q2 (Var 0)))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader b symb b)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose mb symb) (map-insert (map-empty) 0 v)
                                  (map-domain mb) q2))
       (map-not-contains (inverse (compose mp2 p2)) v))   ; $s not free in ?f
      ((Equated e (compose mp2 p2) f)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M10.  Actions: concluding over renamed ids.
;;;
;;;     ?p == (f10 ?x ?y),  ?q == (g10 ?x ?y)   =>   union ?p ?q
;;;
;;; The paper's union takes renamed ids -- S3.5 is union(m1*a1, m2*a2) -- and which of
;;; redundancy, a new group element, or an e-class merge it produces depends on those
;;; renamings.  egglog's `union` takes e-classes, i.e. only the case where both renamings are
;;; the identity, so an action emits either
;;;
;;;   * both operands at the identity  ->  (union A B)
;;;   * otherwise, the fact itself     ->  (Equated A m B)
;;;
;;; `Equated` is the unoriented form of `RenamesToLeader` and is what a compiler should
;;; write: an action cannot know which of the two values is the smaller, and the machinery
;;; picks the side.
;;;
;;; HAZARD: do not write `RenamesToLeader` from an action.  It carries an orientation -- the
;;; leader is the smaller of the pair -- and nothing re-orients it: a row that gets it wrong
;;; is deleted as stale, so the fact is silently lost, and transitivity and single parent can
;;; then disagree forever.
;;;
;;; Covered by: C11, C14, E1-E3.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the pair of renamed ids the action would union, stated covariantly in G(p) so that
;; nothing here has to pick an orientation either
(relation Union' (Renaming U Renaming U))

(rule ((= p (App2 "f10" p1 x q1 y))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= q (App2 "g10" p2 x q2 y))
       (= dom2 (map-union (map-image p2) (map-image q2)))
       (RenamesToLeader x symx x)
       (RenamesToLeader y symy y)
       (RenamesToLeader p symp p)
       (= mp2 (find-mapping-total avoid1 dom2
                                  (compose (compose mp1 p1) symx)
                                  (compose (compose mp1 q1) symy)
                                  p2 q2)))
      ((Union' symp p (compose symp mp2) q)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M11.  A nested right-hand side.
;;;
;;;     ?p == (f11 ?a ?b)   =>   union ?p (h11 (g11 ?a ?b) ?b)
;;;
;;; The paper's `let-app` -- `(let ?e $x (app ?a ?b))` becoming
;;; `(app (let ?e $x ?a) (let ?e $x ?b))` -- and associativity have a right-hand side that is
;;; a *tree*, so an intermediate node must exist before the outer one can point at it: one
;;; `let` per built node, innermost first.  An action is already in pattern slot space, so
;;; there is no renaming between two built nodes -- the edge from outer to inner is the
;;; identity on the inner node's slots -- and a built node's slots are the union of its
;;; edges' images, which is what makes the walk bottom-up.
;;;
;;; Covered by: NR1-nested-build, NR2, NR3-assoc.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule ((= p (App2 "f11" p1 a q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))   ; atom 1, mp1 = identity
       (= ma (compose mp1 p1))                             ; ?a into pattern slots
       (= mb (compose mp1 q1))                             ; ?b's
       (RenamesToLeader p symp p))
      ((let inner (App2 "g11" ma a mb b))
       ;; identity on `inner`'s slots, not a renaming
       (let outer (App2 "h11" (map-union (map-image ma) (map-image mb)) inner mb b))
       (Equated outer (compose mp1 symp) p)))
