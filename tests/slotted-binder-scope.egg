;;; KNOWN GAP: a bound slot shares a namespace with the ambient slots.
;;;
;;; `Bind<T>` in the reference SCOPES its slot, so the body's occurrence and an
;;; ambient occurrence spelled the same way are different slots. This encoding
;;; flattens the binder into an ordinary child column, so the two share one
;;; namespace and only the binder rule distinguishes them.
;;;
;;; `:binder` now covers one column, so a slot free in an UNCOVERED column is no
;;; longer stripped -- `slotted-array-rules.egg` has that case, and it fixed a
;;; baseline disagreement where the encoding merged two terms the reference keeps
;;; apart (8 classes against 9). What it did not fix is the collision below.
;;;
;;;     let $0 = (var $0) in f1 (var $0)
;;;     let $1 = (var $0) in f1 (var $1)
;;;
;;; The bound slot is renamed; nothing else moves. The reference calls these the
;;; same term, because renaming a scoped slot is invisible. Here the strip is
;;; blocked -- slot 0 IS free in the value -- so the bound slot stays in the class's
;;; slot set and the two spellings never meet. Before the coverage fix they were
;;; equal for the wrong reason: the strip removed slot 0 from the whole node, which
;;; also lost the value's occurrence.
;;;
;;; So this is a narrower gap than the one that was fixed, and the opposite way
;;; round: the encoding now keeps apart two terms the reference identifies, rather
;;; than merging two it separates. `xarray.py iso let-slot-free-in-value` shows it
;;; as 9 classes on both sides with no isomorphism between them.
;;;
;;; Fixing it means normalising the collision away: when a binder's slot is free in
;;; an uncovered column, rename the bound slot -- in the binder column and in the
;;; covered column's edge -- to one the node does not use, then strip it. That is a
;;; node rewrite, so it needs an orientation to terminate, which is why it is not
;;; done here.
;;;
;;; This file asserts the CURRENT behaviour. When the collision is normalised, the
;;; last `fail (check ...)` becomes a `check`.

(include "tests/slotted-egraph-encoding-11.egg")

;; let $0 = (var $0) in f1 (var $0)
(let $v0 (App2 "app" (map-empty) (Sym "f1") (map-of 0 0) (Var 0)))
(let $l0 (App3 "let" (map-of 0 0) (Var 0) (map-of 0 0) $v0 (map-of 0 0) (Var 0)))

;; let $1 = (var $0) in f1 (var $1)
(let $v1 (App2 "app" (map-empty) (Sym "f1") (map-of 0 1) (Var 0)))
(let $l1 (App3 "let" (map-of 0 1) (Var 0) (map-of 0 1) $v1 (map-of 0 0) (Var 0)))

(run-schedule (saturate (run slotted)))

;; Fixed by the coverage change: the value's occurrence keeps slot 0 free, so
;; neither class is left with an empty slot set.
(check (= (ClassSlots $l0) (map-of 0 0)))
(check (= (ClassSlots $l1) (map-of 0 0)))

;; Still wrong: the reference identifies these two, and here they stay apart.
(fail (check (RenamesToLeader $l0 m1 leader) (RenamesToLeader $l1 m2 leader)))
