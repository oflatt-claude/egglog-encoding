;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `Lambda` binds child 1
(rule ((RenamesToLeader (Lambda mvar0 (Var 0) m2 c2) ml l)
       (= v0 (map-get mvar0 0)))
      ((RenamesToLeader (Lambda mvar0 (Var 0) m2 c2) (inverse (map-remove (inverse ml) v0)) l)))

;; `Sum` binds child 2, 3
(rule ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) ml l)
       (= v0 (map-get mvar0 0))
       (= v1 (map-get mvar1 0)))
      ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) (inverse (map-remove (map-remove (inverse ml) v0) v1)) l)))
