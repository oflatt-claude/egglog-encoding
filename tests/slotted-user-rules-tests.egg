;;; Cases for `tests/slotted-user-rules.egg`.
;;;
;;; The tutorial states the encoding and holds the rules -- one per shape, the one a compiler
;;; emits.  This file holds everything that exercises them: the e-graphs, the schedules, the
;;; assertions, the well-formedness observers, and the counter-examples.  It INCLUDES the
;;; tutorial rather than copying rules out of it, so what runs here is exactly what the
;;; tutorial teaches and the two cannot drift.
;;;
;;; Layout: one outer (push)/(pop) per tutorial section, one inner (push)/(pop) per case, so
;;; one case's terms never reach another's.  The tutorial's rules, by contrast, are all live
;;; throughout -- that is what including it means.  They stay out of each other's way because
;;; section N spells its operators `fN`, `gN`, `hN`, so only section N's rule can match
;;; section N's terms.  Operators that only ever appear in a term here carry the section
;;; number too: `a2`, `k4b`, `a6`, `c9`.
;;;
;;; A COUNTER-EXAMPLE block sits at the end of the section it justifies.  Where its rule
;;; would collide with the tutorial's -- (a) and (b) under M3, (a) under M8 -- it takes a
;;; further letter, `f3a`/`f3b`/`f8a`, and builds its own copy of the e-graph, so the rule it
;;; is being contrasted with sees none of its terms and cannot mask the bug.  Where the
;;; contrast is a different witness relation over the same term -- `NaiveHit`, `NoAccum`,
;;; `TooEager`, `NaiveJoin`, `ChainShort` -- the two rules share the operators and the case.
;;;
;;; Every case asserts through a witness relation carrying the computed renamings -- that is
;;; what is under test, and the machinery is free to rewrite the nodes afterwards.  The
;;; schedule saturates the invariant rules between user-rule steps, so a user rule only ever
;;; matches nodes that are already canonical.
;;;
;;; The `BadEdge` observers below range over arbitrary nodes rather than over one atom, so
;;; they keep the `App2` signature's own m1/c1/m2/c2 names instead of the tutorial's pN/qN.

(include "tests/slotted-user-rules.egg")


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M1.  One atom, nothing shared.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let $f1 (App2 "f1" (map-of 0 0) (Var 0)
                    (map-of 1 1) (Var 1)))
(run-schedule (saturate (run slotted))
              (repeat 15 (seq (run) (saturate (run slotted)))))

;; commutativity shows up as the e-class gaining the swap symmetry
(check (RenamesToLeader $f1 m $f1)
       (= (map-get m 0) 1)
       (= (map-get m 1) 0))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M2.  A repeated variable -- the Def. 6 check.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; COUNTER-EXAMPLE for M2: what a non-slotted encoding would write -- demand the two edges
;; be *equal*.  A strictly stronger condition than Def. 6, so the rule is incomplete, and
;; (c) is where the difference shows.
(relation NaiveHit (U U))
(rule ((= e (App2 "f2" p1 x p1 x))) ((NaiveHit e x)))

;; (a) both occurrences at the same slot
(push)
(let $ff2 (App2 "f2" (map-of 7 7) (Var 7)
                     (map-of 7 7) (Var 7)))
(run-schedule (saturate (run slotted))
              (repeat 15 (seq (run) (saturate (run slotted)))))
(check (Hit $ff2 (Var 0)))
(pop)

;; (b) negative: distinct slots, so distinct renamed ids, so no match.  This is where the
;;     crate's disequality constraints land -- `same_node_redundant_slots_stay_distinct` and
;;     `live_slots_of_one_class_stay_distinct`, both saying a node's two distinct slots may
;;     not be identified.  Here the lookup for the required swap simply is not there.
(push)
(let $fg2 (App2 "f2" (map-of 7 7) (Var 7)
                     (map-of 8 8) (Var 8)))
(run-schedule (saturate (run slotted))
              (repeat 15 (seq (run) (saturate (run slotted)))))
(fail (check (Hit $fg2 x)))
(pop)

;; (c) f2(a2[$0,$1], a2[$1,$0]) matches f2(?x,?x) *only* because `a2` is symmetric.  The
;;     machinery never normalises the two edges to be equal, so the naive rule misses it
;;     while the Def. 6 rule fires -- which is what makes the two observably different.
(push)
(let $a2     (App2 "a2" (map-of 0 0) (Var 0)
                        (map-of 1 1) (Var 1)))
(let $a2swap (App2 "a2" (map-of 1 1) (Var 1)
                        (map-of 0 0) (Var 0)))
(union $a2 $a2swap)
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

(let $t2 (App2 "f2" (map-of 0 0 1 1) $a2
                    (map-of 0 1 1 0) $a2))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (Hit $t2 $a2))
(fail (check (NaiveHit $t2 $a2)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M3.  Why an atom's renaming has to be TOTAL.
;;;
;;; The observer for the whole section.  An edge `m : slots(c) -> slots(node)` must have
;;; dom(m) = slots(c).  A child's live slot count is the length of its self-map, so a row
;;; where the two disagree is malformed.
;;;
;;; This, and not the natural "did ?p lose a slot?", is what separates the counter-examples
;;; from the tutorial's rule: `f3(?x,?y) = h3(?y,?z)` genuinely says `f3` does not depend on
;;; `?x`, so `?p` losing `$0` is the correct reading of the rule and happens in the fixed
;;; version too.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation BadEdge (String Renaming U))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c1 symc1 c1)
       (!= (map-length m1) (map-length symc1)))
      ((BadEdge f m1 c1)))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c2 symc2 c2)
       (!= (map-length m2) (map-length symc2)))
      ((BadEdge f m2 c2)))

;; (c) the tutorial's rule: total mp2 -- sound AND fires.
(push)
(let $P3 (App2 "f3" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q3 (App2 "g3" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(fail (check (BadEdge f m c)))                       ; ?z keeps its slot
;; and the redundancy the rule really does imply is still derived -- which is why this
;; assertion cannot be used to tell the unsound spelling from this one
(check (RenamesToLeader $P3 m $P3) (= (map-length m) 1))
(pop)

;; (c) the determined case: nothing is minted
(push)
(let $P3 (App2 "f3" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q3 (App2 "g3" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (RenamesToLeader $P3 m $P3) (= (map-length m) 2))
(pop)

;;;; COUNTER-EXAMPLES for M3.

;; (a) minimal mp2 -- unsound: ?z's edge comes out empty
(push)
(rule ((= p (App2 "f3a" p1 x q1 y))
       (= q (App2 "g3a" p2 x q2 z))
       (RenamesToLeader x symx x)
       (= mp2 (compose (compose p1 symx) (inverse p2))))
      ((union p (App2 "h3a" q1 y (compose mp2 q2) z))))

(let $P3a (App2 "f3a" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q3a (App2 "g3a" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (BadEdge "h3a" m c))                  ; the empty edge to ?z
(pop)

;; (b) guarded -- sound but incomplete: the rule simply declines to fire
(push)
(rule ((= p (App2 "f3b" p1 x q1 y))
       (= q (App2 "g3b" p2 x q2 z))
       (RenamesToLeader x symx x)
       (= mp2 (compose (compose p1 symx) (inverse p2)))
       (= mz (compose-total mp2 q2)))     ; declines rather than dropping ?z's slot
      ((union p (App2 "h3b" q1 y mz z))))

(push)
(let $P3b (App2 "f3b" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q3b (App2 "g3b" (map-of 0 0) (Var 0) (map-of 5 5) (Var 5)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(fail (check (BadEdge f m c)))                          ; nothing malformed ...
(fail (check (RenamesToLeader $P3b m $P3b) (= (map-length m) 1)))  ; ... and nothing derived
(pop)

;; where ?z's slots are determined it still fires
(push)
(let $P3b (App2 "f3b" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q3b (App2 "g3b" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (RenamesToLeader $P3b m $P3b) (= (map-length m) 2))
(pop)

(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M4.  Two atoms, chained -- the primitive in use.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; f4( v[$0], g4[$0,$1] )   with   g4 = g4( v[$0], v[$1] )
(let $g4 (App2 "g4" (map-of 0 0) (Var 0)
                    (map-of 0 1) (Var 0)))
(let $f4 (App2 "f4" (map-of 0 0) (Var 0)
                    (map-of 0 0 1 1) $g4))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

;; mp2 is the identity, so ?c lands on $0 and ?d on $1 -- both in the pattern slot space
;; fixed by atom 1.
(check (Chain $f4 mc md)
       (= (map-get mc 0) 0)
       (= (map-get md 0) 1)
       (= (map-length mc) 1)
       (= (map-length md) 1))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; COUNTER-EXAMPLE for M4: what the naive chain spelling does instead.
;;;
;;; M4 solves atom 2 with `find-mapping-total`.  Taking the root's stored edge as atom 2's
;;; whole renaming -- `(compose q1 symb)`, the rule `ChainShort` below -- looks equivalent,
;;; and on (a) it is.
;;;
;;; In (b) `g4`'s class is given a slot the parent's edge cannot name: g4($0,$1) is unioned
;;; with a one-slot term, so $1 becomes redundant and the parent holds `g4` at an edge whose
;;; domain is narrower than `g4`'s own node slots.  The short spelling then computes an EMPTY
;;; renaming for `?d` -- a child with slot 0 reached by an edge with no entries, which the
;;; edge condition forbids (M3) and which asserts the child is slotless.
;;; `find-mapping-total` mints a name instead.  Which of the two happens is a property of the
;;; data, so the recipe cannot take the short spelling anywhere.
;;;
;;; `Chain` here is the tutorial's own rule, on the tutorial's own operators.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; the short spelling
(relation ChainShort (U Renaming Renaming))
(rule ((= p (App2 "f4" p1 a q1 b))
       (= b (App2 "g4" p2 c q2 d))
       (RenamesToLeader b symb b)
       (= mp2 (compose q1 symb)))
      ((ChainShort p (compose mp2 p2) (compose mp2 q2))))

;; (a) M4's e-graph: `mb` covers every slot of the inner node, so the two agree
(push)
(let $g4 (App2 "g4" (map-of 0 0) (Var 0)
                    (map-of 0 1) (Var 0)))
(let $f4 (App2 "f4" (map-of 0 0) (Var 0)
                    (map-of 0 0 1 1) $g4))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (Chain $f4 mc md) (ChainShort $f4 mc md))
(pop)

;; (b) g4($0,$1) unioned with a one-slot term, so the parent's edge to `g4` no longer covers
;;     g4's node slots
(push)
(let $g4  (App2 "g4"  (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(let $k4b (App2 "k4b" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(union $g4 $k4b)
(let $f4 (App2 "f4" (map-of 0 0) (Var 0) (map-of 0 0) $g4))

(run-schedule (saturate (run slotted))
              (repeat 25 (seq (run) (saturate (run slotted)))))

;; the total spelling keeps a slot for ?d ...
(check (Chain $f4 mc md) (= (map-length md) 1))
;; ... the short one drops it, leaving a malformed empty edge
(check (ChainShort $f4 mc md) (= (map-length md) 0))
;; so on this e-graph they genuinely disagree
(fail (check (Chain $f4 mc md) (ChainShort $f4 mc md)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M5.  The avoid-set, and why it accumulates.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; COUNTER-EXAMPLE for M5: the same rule with the accumulation dropped, so atom 3 avoids
;; only atom 1's slots and re-invents what atom 2 already took.
(relation NoAccum (Renaming Renaming))
(rule ((= p (App2 "f5" p1 a q1 b))
       (= mp1 (map-union (map-image p1) (map-image q1)))
       (= avoid1 (map-image mp1))
       (= a (App2 "g5" p2 u q2 u))
       (RenamesToLeader a syma a)
       (= mp2 (find-mapping-total avoid1 (map-union (map-image p2) (map-image q2))
                                  (compose (compose mp1 p1) syma)
                                  (map-domain (compose mp1 p1))))
       (= b (App2 "h5" p3 v q3 v))
       (RenamesToLeader b symb b)
       (= mp3 (find-mapping-total avoid1 (map-union (map-image p3) (map-image q3))
                                  (compose (compose mp1 q1) symb)
                                  (map-domain (compose mp1 q1)))))
      ((NoAccum (compose mp2 p2) (compose mp3 p3))))

;; `g5($0,$0)` and `h5($1,$1)` are each unioned with `null`, so each has a slot its class
;; does not depend on.  The root `f5(null,null)` has no slots at all, so nothing pins `?u`
;; or `?v` and both atoms have to invent.
(let $g5 (App2 "g5" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(let $h5 (App2 "h5" (map-of 0 1) (Var 0) (map-of 0 1) (Var 0)))
(union $g5 (Null))
(union $h5 (Null))
(let $f5 (App2 "f5" (map-empty) (Null) (map-empty) (Null)))

(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

;; accumulated: ?u and ?v land on different pattern slots
(check (Accum (map-of 0 0) (map-of 0 1)))
(check (Accum mu mv) (!= mu mv))

;; not accumulated: both invent slot 0, so the two variables collapse
(check (NoAccum mu mv) (= mu mv))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M6.  Two atoms, joined on a fresh root.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; COUNTER-EXAMPLE for M6: solve `mp2` from `?x` alone, then require `?y` to agree with that.
;; `mp2` is then defined only on im(p2), so the agreement asked of `?y` is about a map that
;; need not cover `?y`'s slots.  Whether im(p2) happens to cover the whole node is a property
;; of the data: (a) loses a match, (c) happens to work.
(relation TooEager (U U))
(rule ((= p (App2 "f6" p1 x q1 y))
       (= q (App2 "g6" p2 x q2 y))
       (RenamesToLeader x symx x)
       (= mp2 (compose (compose p1 symx) (inverse p2)))   ; from ?x alone
       (= symy (compose (inverse q1) (compose mp2 q2)))   ; then probe ?y
       (RenamesToLeader y symy y))
      ((TooEager p q)))

;; COUNTER-EXAMPLE for M6: no mp2 at all -- demand the two nodes carry the same edges.
(relation NaiveJoin (U U))
(rule ((= p (App2 "f6" p1 x q1 y))
       (= q (App2 "g6" p1 x q1 y)))                       ; same edges, no mp2
      ((NaiveJoin p q)))

;; (a) positive, mp2 = identity.  im(p2) is only {$0}, so it never reaches $1 and TooEager
;;     silently loses the match.
(push)
(let $P6 (App2 "f6" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q6 (App2 "g6" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (Join $P6 $Q6 m) (= (map-length m) 2))
(fail (check (TooEager $P6 $Q6)))
(pop)

;; (b) negative: g6's two children are one renamed id where f6's are two, so no injective
;;     mp2 exists.  This is find-mapping's injectivity check doing the job of the reference's
;;     per-node disequality clique.
(push)
(let $P6 (App2 "f6" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q6 (App2 "g6" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(fail (check (Join $P6 $Q6 m)))
(fail (check (Join $Q6 $P6 m)))
(pop)

;; (c) f6(a6[$0,$1], v[$0]) vs g6(a6[$1,$0], v[$0]): `?y` pins mp2[$0] = $0, so symx must be
;;     the real swap.  Here im(p2) happens to cover all of q's slots, so TooEager works --
;;     again a property of the data.
(push)
(let $a6     (App2 "a6" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $a6swap (App2 "a6" (map-of 1 1) (Var 1) (map-of 0 0) (Var 0)))
(union $a6 $a6swap)
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

(let $P6 (App2 "f6" (map-of 0 0 1 1) $a6 (map-of 0 0) (Var 0)))
(let $Q6 (App2 "g6" (map-of 0 1 1 0) $a6 (map-of 0 0) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (Join $P6 $Q6 m))
(check (TooEager $P6 $Q6))
(fail (check (NaiveJoin $P6 $Q6)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M7.  Three atoms -- the cases compose.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let $g7 (App2 "g7" (map-of 0 0) (Var 0)
                    (map-of 0 1) (Var 0)))
(let $f7 (App2 "f7" (map-of 0 0) (Var 0)
                    (map-of 0 0 1 1) $g7))

;; (a) positive.  ?a and ?c are both v[$0] in pattern slots, and h7's two children sit at
;;     the same slot $5, so mp3 = {$5 -> $0}.
(push)
(let $h7 (App2 "h7" (map-of 0 5) (Var 0)
                    (map-of 0 5) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 25 (seq (run) (saturate (run slotted)))))
(check (Tri $f7 q m)
       (= (map-get m 5) 0)
       (= (map-length m) 1))
(pop)

;; (b) negative.  h7's children sit at *different* slots, so mp3 would have to send both $5
;;     and $6 to $0 -- not injective, no match.
(push)
(let $h7bad (App2 "h7" (map-of 0 5) (Var 0)
                       (map-of 0 6) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 25 (seq (run) (saturate (run slotted)))))
(fail (check (Tri $f7 q m)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M8.  A variable wider than its class -- the ClassSlots narrowing.
;;;
;;; The observer goes in its OWN ruleset and is run once at the end.  A relation is monotone,
;;; so a witness sharing the default ruleset also fires mid-repair and keeps the fact after
;;; the offending row is gone -- it would answer "was there ever a bad edge?", and the answer
;;; to that is yes even when all is well.
;;;
;;; Both cases build the same e-graph, in their own operators: two unions through a shared
;;; h8($0,$0) drive the f8 class's slot set down, so a renaming read off an f8 node names a
;;; slot the class no longer has.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(ruleset m8obs)
(relation BadEdge (String Renaming U))
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c1 symc1 c1)
       (= symc1 (compose symc1 symc1))       ; a partial identity: c1's slots are in its domain
       (< (map-length symc1) (map-length m1)))
      ((BadEdge f m1 c1)) :ruleset m8obs)
(rule ((= n (App2 f m1 c1 m2 c2))
       (RenamesToLeader c2 symc2 c2)
       (= symc2 (compose symc2 symc2))
       (< (map-length symc2) (map-length m2)))
      ((BadEdge f m2 c2)) :ruleset m8obs)

;; (b) the tutorial's rule: every variable narrowed to its class.  Belt and braces under this
;;     schedule; it was load-bearing when the machinery ran in one ruleset with the user's
;;     rules.
(push)
(let $n8  (App2 "f8" (map-empty) (Null) (map-of 0 0) (Var 0)))
(let $g8  (App2 "g8" (map-empty) (Null) (map-of 0 2) (Var 0)))
(let $s8  (App2 "h8" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(union $n8 $s8)
(union $g8 $s8)
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(run m8obs 1)
(fail (check (BadEdge "f8" m c)))     ; nothing malformed
(pop)

;;;; COUNTER-EXAMPLE for M8.

;; (a) stored renamings used as written -- `XDIFF_BUGS=wide-kids`.  Under the phased schedule
;;     the invariants are saturated before a user rule can match, so the renamings an action
;;     reads off a node already have the child's slots for their domain: this used to produce
;;     a malformed edge and no longer does, so the assertion is now the negative.
;;     `def4-edges.py` is what checks that precondition.  Kept as a record -- a test that has
;;     stopped testing what it was written for is worse than no test.
(push)
(rule ((= x3 (App2 "f8a" p1 x1 q1 x2)))
      ((union x1 (App2 "f8a" q1 x2 p1 x1))))
(let $n8a (App2 "f8a" (map-empty) (Null) (map-of 0 0) (Var 0)))
(let $g8a (App2 "g8a" (map-empty) (Null) (map-of 0 2) (Var 0)))
(let $s8a (App2 "h8a" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(union $n8a $s8a)
(union $g8a $s8a)
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(run m8obs 1)
(fail (check (BadEdge "f8a" m c)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M9.  A slot literal: eta.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; positive: (lambda9 $5 (app9 c9 (var $5)))  ->  c9
(push)
(let $c9    (App2 "c9" (map-empty) (Null) (map-empty) (Null)))
(let $body9 (App2 "app9" (map-empty) $c9 (map-of 5 5) (Var 5)))
(let $lam9  (App2 "lambda9" (map-of 5 5) (Var 5)
                            (map-of 5 5) $body9))
(run-schedule (saturate (run slotted))
              (repeat 30 (seq (run) (saturate (run slotted)))))
(check (RenamesToLeader $lam9 m $c9))
(pop)

;; negative: the bound slot is free in ?f -- (lambda9 $5 (app9 (var $5) (var $5)))
(push)
(let $body9 (App2 "app9" (map-of 5 5) (Var 5)
                         (map-of 5 5) (Var 5)))
(let $lam9  (App2 "lambda9" (map-of 5 5) (Var 5)
                            (map-of 5 5) $body9))
(run-schedule (saturate (run slotted))
              (repeat 30 (seq (run) (saturate (run slotted)))))
(fail (check (RenamesToLeader $lam9 m (Var 0))))
(pop)

;; negative: wrong slot -- (lambda9 $5 (app9 c9 (var $6)))
(push)
(let $c9    (App2 "c9" (map-empty) (Null) (map-empty) (Null)))
(let $body9 (App2 "app9" (map-empty) $c9 (map-of 6 6) (Var 6)))
(let $lam9  (App2 "lambda9" (map-of 5 5) (Var 5)
                            (map-of 5 5 6 6) $body9))
(run-schedule (saturate (run slotted))
              (repeat 30 (seq (run) (saturate (run slotted)))))
(fail (check (RenamesToLeader $lam9 m $c9)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M10.  Actions: concluding over renamed ids.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let $P10 (App2 "f10" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(let $Q10 (App2 "g10" (map-of 0 0) (Var 0) (map-of 1 1) (Var 1)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))
(check (Union' s $P10 r $Q10))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; M11.  A nested right-hand side.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let $f11 (App2 "f11" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

;; h11(g11($0,$1), $1) has been put in f11($0,$1)'s class
(let $g11 (App2 "g11" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0)))
(let $h11 (App2 "h11" (map-of 0 0 1 1) $g11 (map-of 0 1) (Var 0)))
(run-schedule (saturate (run slotted))
              (repeat 20 (seq (run) (saturate (run slotted)))))

(check (RenamesToLeader $f11 m1 leader)
       (RenamesToLeader $h11 m2 leader))

(pop)
