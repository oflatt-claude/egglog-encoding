;; Oliver's favorite encoding as july 2
;; Keeps track of a canonical renamed form for each eclass using a union-find table called
;; "RenamesToLeader".
;; The job of shape computation rules is to find collisions, pick one of them to be the leader, then add a RenamesToLeader entry for the other eclass to point to the leader, with the appropriate renaming.
;; Footgun: RenamesToLeader needs to be initialized for each thing you add to the egraph, otherwise you might miss things in your query at the end. 
;; We delete nodes which are not canonical, compressing the e-graph. So you can't match on them anymore, but you can use their value and RenamesToLeader to find the canonical representative.

;;; Machinery ;;;

(sort Renaming (Map i64 i64))

(sort U)

(constructor Var (i64) U)

;; `(App2 f m1 c1 m2 c2)` corresponds to the term `f(m1*c1, m2*c2)`

;; `(RenamesToLeader follower m leader)` corresponds to `follower = m*leader`.
;; We require `leader <= follower` in terms of ordering-max.
(relation RenamesToLeader (U Renaming U))

; This is a basic object not depending on any variables.
(constructor Null () U)

;; Every rule that names a child position is generated, once per arity, by
;; `slotted-experiments/gen-node-rules.py`. Add an arity there and re-run.
(include "tests/slotted-node-rules.egg")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; General Unionfind Properties ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; transitivity / path compression
;; e1 = m12*e2 /\ e2 = m23*e3 --> e1 = m12*m23*e3
(rule ((RenamesToLeader e1 m12 e2)
       (RenamesToLeader e2 m23 e3)

       ; we exclude non-idempotent self-symmetries for the unionfind
       (guard (or (bool-!= e2 e3)
                  (bool= (compose m23 m23) m23)
                  (bool= e1 e3))))

      ((RenamesToLeader e1 (compose m12 m23) e3)))

;; single parent
;; a = m1*b /\ a = m2*c  --> b = m1⁻¹*m2*c
(rule ((RenamesToLeader a m1 b)
       (RenamesToLeader a m2 c)

       (!= a c) ; We don't want this rule to fire for a=b=c, as it would remove symmetries from our group.
       ;; Nor for b=a: deleting a's self-loop hides a class that still holds an
       ;; e-node (Case 14), and transitivity already derives the edge this adds.
       (!= a b)
       (= (ordering-max b c) b) ; c <= b

                                            ; either
       (guard (or (bool-!= b c)             ; c < b, or
                  (and (bool= b c)          ; b=c, but m2 < m1
                       (bool-!= m1 m2)
                       (bool= (ordering-max m1 m2) m1)))))

      ((delete (RenamesToLeader a m1 b))
       (RenamesToLeader b (compose (inverse m1) m2) c)))

; single parent for symmetries, this does shrinking.
(rule ((RenamesToLeader a m1 a)
       (RenamesToLeader a m a)
       (= m (compose m m))
       (= m2 (compose m (compose m1 m)))
       (!= m1 m2))
      ((delete (RenamesToLeader a m1 a))
        (RenamesToLeader a m2 a))
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Deduplicate nodes that are equal up to renaming ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; replace (Var v) by [0 -> v] * (Var 0)
(rule ((= e (Var v))
       (!= v 0))
      ((RenamesToLeader e (map-insert (map-empty) 0 v) (Var 0))
       (delete (Var v))
      )
)

;; α-finder: Will find two App2 nodes that are equal up to renaming, and eliminate one in favor of the other.

;; Input: e1 = f(m1*c1, m1'*c2) /\ e2 = f(m2*c1, m2'*c2),
;; then m = (find-mapping m1 m1' m2 m2') is the smallest renaming, s.t. m*m2 = m1 /\ m*m2' = m1'
;; so that m*e2 = m*f(m2*c1, m2'*c2) = f(m*m2*c1, m*m2'*c2) = f(m1*c1, m1'*c2) = e1
;; so in short m*e2 = e1.

; non-destructive symmetry-finder based on the above.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Everything has to have a self-loop ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This guarantees that (Var 0) is the lowest ordering-max variable, and it has a reflexive RenamesToLeader entry.
(RenamesToLeader (Var 0) (map-insert (map-empty) 0 0) (Var 0))
(RenamesToLeader (Null) (map-empty) (Null))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Migration of e-nodes ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; if `e2 = f(m1*c1, m2*c2)` /\ `e2 = m*e1`, then `e1 = m⁻¹*e2 = m⁻¹*f(m1*c1, m2*c2) = f(m⁻¹*m1*c1, m⁻¹*m2*c2)`

;;;;;;;;;;;;;;;;;;;;;;;
;; Child-Update rule ;;
;;;;;;;;;;;;;;;;;;;;;;;

;; per-position child rewrites- canonicalize children to use representatives
;; These replace `c` with the more canonical `m*c'`.

;;;; First child:

;;;; Second child:

;;;;;;;;;;
;; MISC ;;
;;;;;;;;;;

; if two things are equal up to some identity renaming, let's merge them.
(rule
    (
        (RenamesToLeader a m1_o c)
        (RenamesToLeader b m2 c)
        (RenamesToLeader c sym c)

        (= m1 (compose m1_o sym))

        (= m (compose m1 (inverse m2)))
        (= (compose m m) m)
    )
    (
        (union a b)
    )
)

;;; Tests ;;;


;;; Case 1: swap of two free variables ;;;
(push)

(let $a1 (App2 "f" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty)  1  1) (Var 1)))

(let $a2 (App2 "f" (map-insert (map-empty)  1  1) (Var 1)
                  (map-insert (map-empty) 20 20) (Var 20)))

(run 10)

(fail (check (= $a1 $a2)))
(check (RenamesToLeader $a2 m1 leader)
       (RenamesToLeader $a1 m2 leader))

(pop)


;;; Case 2: three-variable cyclic permutation, nested ;;;
(push)

(let $b1 (App2 "f"
              (map-insert (map-insert (map-empty) 100 100) 200 200)
              (App2 "g" (map-insert (map-empty) 100 100) (Var 100)
                       (map-insert (map-empty) 200 200) (Var 200))
              (map-insert (map-empty) 300 300) (Var 300)))

(let $b2 (App2 "f"
              (map-insert (map-insert (map-empty) 100 100) 300 300)
              (App2 "g" (map-insert (map-empty) 300 300) (Var 300)
                       (map-insert (map-empty) 100 100) (Var 100))
              (map-insert (map-empty) 200 200) (Var 200)))

(run 10)

(check (RenamesToLeader $b1 m1 leader)
       (RenamesToLeader $b2 m2 leader))

(pop)


;;; Case 3: same shape, different slot ids ;;;
(push)

(let $c1 (App2 "h" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 50 50) (Var 50)))

(let $c2 (App2 "h" (map-insert (map-empty) 60 60) (Var 60)
                  (map-insert (map-empty) 60 60) (Var 60)))

(run 10)

(check (RenamesToLeader $c1 m1 leader)
       (RenamesToLeader $c2 m2 leader))

(pop)


;;; Case 4 (negative): different free-slot counts ;;;
(push)

(let $d1 (App2 "k" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 50 50) (Var 50)))

(let $d2 (App2 "k" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 60 60) (Var 60)))


(run 10)

;; negative — should remain in distinct e-classes.
(fail (check (= $d1 $d2)))
(fail (check (RenamesToLeader $d1 m1 leader)
             (RenamesToLeader $d2 m2 leader)))

(pop)


;;; Case 5- redundancies
(push)

(let $c1 (App2 "f" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty) 1 1) (Var 1)))
(let $c2 (App2 "g" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty) 20 20) (Var 20)))

(union $c1 $c2)

(let $c3 (App2 "f" (map-insert (map-empty) 23 23) (Var 23)
                  (map-insert (map-empty) 24 24) (Var 24) ))
(let $c4 (App2 "f" (map-insert (map-empty) 23 23) (Var 23)
                  (map-insert (map-empty) 25 25) (Var 25) ))

(run 10)

(check (RenamesToLeader $c3 m1 leader)
       (RenamesToLeader $c1 m2 leader))

(check (RenamesToLeader $c3 m1 leader)
       (RenamesToLeader $c4 m2 leader))

(pop)


;;; Case 6- RenamesToLeader Var reflexivity test
(push)

(let $v1 (Var 1))
(let $v2 (Var 2))

(run 10)
(check (RenamesToLeader $v1 m1 leader)
       (RenamesToLeader $v2 m2 leader))


; NOTE: commented out as it crashed even with the "fail".
; (fail (extract $v2)) ; the renamed version of $v2 is there but the original $v2 is not extractable because it was deleted.
;; in the encoding we'll look up the leader when you extract anything automatically.


(pop)

;;; Case 7- redundancies (II)
(push)

; If you look at the --to-svg of this (without the push/pop),
; we get one App2 node in the end due to the symmetry rule above

; 1 - 1
(let $m11 (App2 "m" (map-insert (map-empty) 1 1) (Var 1)
                  (map-insert (map-empty) 1 1) (Var 1)))

; 2 - 2
(let $m22 (App2 "m" (map-insert (map-empty) 2 2) (Var 2)
                  (map-insert (map-empty) 2 2) (Var 2)))

(union $m11 $m22)

(run 10)

(pop)

;;; Case 8- more toying around
(push)

(let $v7 (Var 7))
(let $v0 (Var 0))

(let $f7 (App2 "f" (map-insert (map-empty) 7 7) (Var 7) (map-empty) (Null)))
(let $g7 (App2 "g" (map-insert (map-empty) 7 7) (Var 7) (map-empty) (Null)))

(union $f7 $g7)

(let $f8 (App2 "f" (map-insert (map-empty) 8 8) (Var 8) (map-empty) (Null)))
(let $h8 (App2 "h" (map-insert (map-empty) 8 8) (Var 8) (map-empty) (Null)))
(union $f8 $h8)

(run 10)

(check (RenamesToLeader $g7 m1 leader)
       (RenamesToLeader $h8 m2 leader))

(pop)

;;; Case 9- redundancies bug.
(push)

(let $v0 (Var 0))
(let $v7 (Var 7))

(let $f0 (App2 "f" (map-insert (map-empty) 0 0) (Var 0) (map-empty) (Null)))
(let $f7 (App2 "f" (map-insert (map-empty) 7 7) (Var 7) (map-empty) (Null)))

(union $v0 $v7)

(run 10)

(check (RenamesToLeader $f0 m1 leader) (RenamesToLeader $f7 m2 leader))

(pop)


;;; Case 10- lambda alpha equivalence.
(push)

(let $lam00 (App2 "lambda"
                (map-insert (map-empty) 0 0) (Var 0)
                (map-insert (map-empty) 0 0) (Var 0)))

(let $lam11 (App2 "lambda"
                (map-insert (map-empty) 1 1) (Var 1)
                (map-insert (map-empty) 1 1) (Var 1)))

(run 10)

(check (= $lam00 $lam11))

(pop)


;;; Case 11- f(0, 1) = f(1, 0)
(push)

(let $f01 (App2 "f"
                (map-insert (map-empty) 0 0) (Var 0)
                (map-insert (map-empty) 1 1) (Var 1)))

(let $f10 (App2 "f"
                (map-insert (map-empty) 1 1) (Var 1)
                (map-insert (map-empty) 0 0) (Var 0)))

(let $node1 (App2 "g"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $f01
                (map-insert (map-insert (map-empty) 1 1) 0 0) $f01))

(let $node2 (App2 "g"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $f01
                (map-insert (map-insert (map-empty) 0 1) 1 0) $f01))

(union $f01 $f10)

(run 10)

(check (= $node1 $node2))

(pop)

;;; Case 12- f(0, 1) = f(1, 0) -> g(f(0, 1)) = g(f(1, 0))
(push)

(let $f01 (App2 "f"
                (map-insert (map-empty) 0 0) (Var 0)
                (map-insert (map-empty) 1 1) (Var 1)))

(let $f10 (App2 "f"
                (map-insert (map-empty) 1 1) (Var 1)
                (map-insert (map-empty) 0 0) (Var 0)))

(let $g01 (App2 "g"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $f01
                (map-empty) (Null)))

(let $g10 (App2 "g"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $f10
                (map-empty) (Null)))

(let $node1 (App2 "h"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $g01
                (map-insert (map-insert (map-empty) 1 1) 0 0) $g01))

(let $node2 (App2 "h"
                (map-insert (map-insert (map-empty) 1 1) 0 0) $g01
                (map-insert (map-insert (map-empty) 0 1) 1 0) $g01))

(union $f01 $f10)

(run 10)

(check (= $node1 $node2))

(pop)

;;; Case 13- single leader redundancies
(push)

(let $null (Null))
(let $f (App2 "f"
                (map-insert (map-empty) 0 0) (Var 0)
                (map-insert (map-empty) 1 1) (Var 1)))

(union $f $null)

(run 10)

(fail (check (RenamesToLeader $f m l)
             (RenamesToLeader l sym l)
             (!= sym (map-empty))))

(pop)

;;; Case 14- a class holding an e-node must keep a self-loop.
;;;
;;; Every user-rule query reaches a class's symmetries by joining
;;; `(RenamesToLeader v sym v)`, so a class that still holds an e-node but has no
;;; self-loop is invisible to matching and its node cannot be found.
;;;
;;; Two rules together used to produce exactly that. `$N` uses slots {1,2} while
;;; its class is just the variable $2, so slot 1 is redundant; migration declines
;;; to move the node to the leader, because rewriting the child edge {0->1} through
;;; the leader's frame {0->2} would drop the entry and so assert that the child is
;;; slotless. Meanwhile single-parent deleted `$N`'s self-loop as soon as `$N`
;;; acquired the leader, and nothing re-derived it -- the rule that makes one fires
;;; on a *new* `App2` row, and the row was not new any more. The node was left on a
;;; class no query could see.
(push)

; B = h($2, $1), slots {1,2}
(let $B (App2 "h" (map-of 0 2) (Var 0) (map-of 0 1) (Var 0)))

; N = h($1, B), also slots {1,2}
(let $N (App2 "h" (map-of 0 1) (Var 0) (map-of 1 1 2 2) $B))

; N's class is the variable $2, so slot 1 is redundant for it
(union $N (Var 2))

(run 20)

; the node is still there, on a follower class
(check (RenamesToLeader $N m (Var 0))
       (!= $N (Var 0)))

; ...so that class must still carry a self-loop for a query to reach it
(check (RenamesToLeader $N sym $N))

(pop)

;;; Case 15- migration must not narrow an edge.
;;;
;;; Same e-graph as Case 14, which is also where migration wants to truncate:
;;; rewriting `$N`'s first edge {0->1} through the leader's frame {0->2} drops the
;;; entry, since 1 is not in the frame. `compose` would narrow it silently and the
;;; result is asserted as an edge, so the e-graph would end up holding
;;;
;;;     (App2 "h" (map-of) (Var 0) ...)
;;;
;;; an empty edge to a child that has a slot -- Def. 4 says an edge's domain is its
;;; child's slot set, so this states that `(Var 0)` has none. `compose-total`
;;; declines instead. `(Var 0)` is the one child whose slots are known statically,
;;; which is what makes this checkable here.
(push)

(let $B (App2 "h" (map-of 0 2) (Var 0) (map-of 0 1) (Var 0)))
(let $N (App2 "h" (map-of 0 1) (Var 0) (map-of 1 1 2 2) $B))
(union $N (Var 2))

(run 20)

(fail (check (= x (App2 f m1 (Var 0) m2 c2)) (= (map-length m1) 0)))
(fail (check (= x (App2 f m1 c1 m2 (Var 0))) (= (map-length m2) 0)))

(pop)

;;; Case 16- a ternary node, alpha-equivalent up to renaming.
;;;
;;; Nothing binder-specific: f3 over three distinct variables is the same node
;;; whatever the three slots are called, so the alpha-finder identifies the two and
;;; records the renaming between them. Exercises the generated arity-3 rules.
(push)

(let $f3a (App3 "f3" (map-of 0 0) (Var 0) (map-of 0 1) (Var 0) (map-of 0 2) (Var 0)))
(let $f3b (App3 "f3" (map-of 0 3) (Var 0) (map-of 0 4) (Var 0) (map-of 0 5) (Var 0)))

(run 20)

(check (RenamesToLeader $f3a m1 leader)
       (RenamesToLeader $f3b m2 leader))

;; and three distinct slots may not collapse: f3($0,$1,$2) is not f3($0,$0,$2)
(let $f3c (App3 "f3" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0) (map-of 0 2) (Var 0)))
(run 20)
(fail (check (= $f3a $f3c)))

(pop)

;;; Case 17- `let` alpha-equivalence, the arity-3 binder.
;;;
;;; Case 10 at arity 3: `(let $5 (var $5) e)` and `(let $6 (var $6) e)` are the same
;;; term, so the generated binder rule has to take the bound slot out of the class
;;; and leave the two identified.
(push)

(let $let5 (App3 "let" (map-of 0 5) (Var 0) (map-of 0 5) (Var 0) (map-empty) (Null)))
(let $let6 (App3 "let" (map-of 0 6) (Var 0) (map-of 0 6) (Var 0) (map-empty) (Null)))

(run 20)

(check (= $let5 $let6))

;; the bound slot is not free: the class has no slots
(check (RenamesToLeader $let5 (map-empty) $let5))

(pop)

;;; Case 18- leaves carrying a payload.
;;;
;;; `Number(u32)` and `Symbol` in the paper's arith, rise and array languages. A
;;; payload leaf has no slots, so it behaves like `Null` except that there are
;;; infinitely many, which is why its self-loop is a rule.
(push)

(let $one (Num 1))
(let $two (Num 2))

(run 20)

;; slotless, like Null
(check (RenamesToLeader $one (map-empty) $one))

;; distinct payloads stay distinct
(fail (check (= $one $two)))

;; and they compose into nodes: f(1, $0) and f(1, $1) are alpha-equivalent
(let $f1a (App2 "f" (map-empty) $one (map-of 0 0) (Var 0)))
(let $f1b (App2 "f" (map-empty) $one (map-of 0 1) (Var 0)))
(run 20)
(check (RenamesToLeader $f1a m1 leader)
       (RenamesToLeader $f1b m2 leader))

;; but f(1, ...) and f(2, ...) are not
(let $f2a (App2 "f" (map-empty) $two (map-of 0 0) (Var 0)))
(run 20)
(fail (check (= $f1a $f2a)))

(pop)

;;; Case 19- a payload column beside a slotted child.
;;;
;;; `Scale :: i64 child`. The payload is an ordinary column, so it takes part in the
;;; node's identity; the child is the only source of slots. Nothing special is
;;; needed for the mix -- a payload just never appears in a renaming.
(push)

(let $s2a (Scale 2 (map-of 0 0) (Var 0)))
(let $s2b (Scale 2 (map-of 0 1) (Var 0)))
(let $s3a (Scale 3 (map-of 0 0) (Var 0)))

(run 20)

;; same payload, child at a different slot: alpha-equivalent
(check (RenamesToLeader $s2a m1 leader)
       (RenamesToLeader $s2b m2 leader))

;; different payload: a different node
(fail (check (= $s2a $s3a)))

;; the slots come from the child alone
(check (RenamesToLeader $s2a (map-of 0 0) $s2a))

(pop)

