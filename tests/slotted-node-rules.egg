;;; Scale :: i64 child
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Scale (i64 Renaming U) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Scale p1 m1 c1)))
      ((set (ClassSlots e1) (map-image m1))))

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Scale p1 m1 c1))
       (= m (map-image m1)))
      ((RenamesToLeader e1 m e1)))

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (Scale p1 m1_o c1))
       (= e2 (Scale p1 b1 c1))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (= m1 (compose m1_o sym1))
       (= m (find-mapping m1 b1))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))))))
      ((RenamesToLeader e1 m e2)
       (delete (Scale p1 m1_o c1))))

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (Scale p1 m1_o c1))
       (RenamesToLeader c1 sym1 c1)
       (= m1 (compose m1_o sym1))
       (= sym_out (find-mapping m1_o m1)))
      ((RenamesToLeader e sym_out e)))

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (Scale p1 m1 c1))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-image m1))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1)))
      ((union e1 (Scale p1 n1 c1))
       (delete (Scale p1 m1 c1))))

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (Scale p1 m1 c1))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (Scale p1 (compose m1 m) c'))
       (delete (Scale p1 m1 c1))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `lambda` binds its first child's slot
(rule ((RenamesToLeader (App2 "lambda" mvar0 (Var 0) m2 c2) ml l)
       (= v0 (map-get mvar0 0)))
      ((RenamesToLeader (App2 "lambda" mvar0 (Var 0) m2 c2) (inverse (map-remove (inverse ml) v0)) l)))

;; `let` binds its first child's slot
(rule ((RenamesToLeader (App3 "let" mvar0 (Var 0) m2 c2 m3 c3) ml l)
       (= v0 (map-get mvar0 0)))
      ((RenamesToLeader (App3 "let" mvar0 (Var 0) m2 c2 m3 c3) (inverse (map-remove (inverse ml) v0)) l)))
