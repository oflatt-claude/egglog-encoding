;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; arity 2
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor App2 (String Renaming U Renaming U) U)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (App2 f m1 c1 m2 c2))
       (= m (map-union (map-image m1) (map-image m2))))
      ((RenamesToLeader e1 m e1)))

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (App2 f a1_o c1 a2_o c2))
       (= e2 (App2 f b1 c1 b2 c2))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (= a1 (compose a1_o sym1))
       (= a2 (compose a2_o sym2))
       (= m (find-mapping a1 a2 b1 b2))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (or (and (bool= (ordering-max a1 b1) b1) (bool-!= a1 b1))
              (and (bool= a1 b1)
                   (and (bool= (ordering-max a2 b2) b2) (bool-!= a2 b2))))))))
      ((RenamesToLeader e1 m e2)
       (delete (App2 f a1 c1 a2 c2))))

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (App2 f a1_o c1 a2_o c2))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (= a1 (compose a1_o sym1))
       (= a2 (compose a2_o sym2))
       (= sym_out (find-mapping a1_o a2_o a1 a2)))
      ((RenamesToLeader e sym_out e)))

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (App2 f m1 c1 m2 c2))
       (!= e1 e2)
       ; narrowing would understate the child's slots, so decline instead
       (= n1 (compose-total (inverse m) m1))
       (= n2 (compose-total (inverse m) m2)))
      ((union e1 (App2 f n1 c1 n2 c2))
       (delete (App2 f m1 c1 m2 c2))))

;; child-update, position 1
(rule ((RenamesToLeader c1 m c')
       (= node (App2 f m1 c1 m2 c2))
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c') (bool-!= (compose m1 m) m1))))
      ((union node (App2 f (compose m1 m) c' m2 c2))
       (delete (App2 f m1 c1 m2 c2))))

;; child-update, position 2
(rule ((RenamesToLeader c2 m c')
       (= node (App2 f m1 c1 m2 c2))
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c2 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c2 c') (bool-!= (compose m2 m) m2))))
      ((union node (App2 f m1 c1 (compose m2 m) c'))
       (delete (App2 f m1 c1 m2 c2))))

