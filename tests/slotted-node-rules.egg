;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `lambda` binds its first child's slot (arity 2)
(rule ((RenamesToLeader (App2 "lambda" mvar (Var 0) m2 c2) ml l)
       (= v (map-get mvar 0)))
      ((RenamesToLeader (App2 "lambda" mvar (Var 0) m2 c2) (inverse (map-remove (inverse ml) v)) l)))

;; `let` binds its first child's slot (arity 3)
(rule ((RenamesToLeader (App3 "let" mvar (Var 0) m2 c2 m3 c3) ml l)
       (= v (map-get mvar 0)))
      ((RenamesToLeader (App3 "let" mvar (Var 0) m2 c2 m3 c3) (inverse (map-remove (inverse ml) v)) l)))
