;;; Differential cases against the reference `multi_ematch`
;;; (memoryleak47/slotted-egraphs, PR #45 @ e3efcdd).
;;;
;;; The oracle lives in `slotted-experiments/xmulti`; run it with
;;; `cargo run` from that directory to reproduce the reference answers quoted
;;; below.  This file runs the *encoded* form of the same two patterns.
;;;
;;; ===========================================================================
;;; FINDING: the encoding is strictly less complete than `multi_ematch`.
;;; ===========================================================================
;;;
;;; `multi_ematch` mints a fresh slot per *lookup* and then lets `unify` MERGE
;;; two of them when a repeated pattern variable demands it (`union_slot`).  The
;;; encoding has no merge step at all: `find-mapping` is injective by
;;; construction, so it never identifies two node slots, and the Def. 6 check is
;;; a lookup.  The encoding can only ever VERIFY a slot equality, never
;;; CONSTRUCT one.
;;;
;;; `find-mapping-total` does not close this.  It is a pure function, so two
;;; atoms mint the *same* slot exactly when they are handed the same arguments
;;; -- which is why R1 below agrees and R2 does not.  Determinism is standing in
;;; for unification, and it only covers the case where the inputs coincide.
;;;
;;; Closing it needs what a merge needs: a slot union-find threaded through the
;;; rule body, solving for identifications across atoms rather than checking
;;; them.  That is a Rust side-condition carrying state between atoms, not
;;; another pure map primitive.
;;;
;;; Both cases below are asserted at *current* behaviour, so this file passes.
;;; R2's assertion is a `fail`, marking a known gap -- fix the encoding and R2
;;; starts failing, which is the point.

(include "tests/slotted-egraph-encoding-11.egg")

(relation Mu (String Renaming))
(relation Hit (String U))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; R1.  ONE node with a redundant slot, reached through two atoms.
;;;
;;;   e-graph:  sub($9,$9) = zero,  add(zero,zero)
;;;   pattern:  ?p == (add ?a ?b), ?a == (sub ?u ?u), ?b == (sub ?u ?u)
;;;   reference: 1 match, ?u = id0[$f0 -> $f8]
;;;
;;; AGREES -- but by coincidence.  Both atoms match the same node, so both hand
;;; `find-mapping-total` identical arguments and it returns the same minted
;;; slot for each.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= p (App "add" pa a pb b))
       (= a (App "sub" u1 u u2 u))
       (= b (App "sub" v1 u v2 u))
       (RenamesToLeader a syma a)
       (RenamesToLeader b symb b)
       (= pat  (find-mapping pa pb pa pb))          ; identity on slots(pattern)
       (= dom2 (find-mapping u1 u2 u1 u2))          ; identity on atom 2's node
       (= dom3 (find-mapping v1 v2 v1 v2))
       (= mp2 (find-mapping-total pat dom2 (compose pa syma) (map-empty)))
       (= mp3 (find-mapping-total pat dom3 (compose pb symb) (map-empty)))
       (= mu  (compose mp2 u1))
       (= s3  (compose (inverse mu) (compose mp3 v1)))
       (RenamesToLeader u s3 u))                    ; Def. 6 across the atoms
      ((Hit "R1" p)))

;; witness the two minted renamings so the coincidence is visible
(rule ((= p (App "add" pa a pb b))
       (= a (App "sub" u1 u u2 u))
       (RenamesToLeader a syma a)
       (= pat  (find-mapping pa pb pa pb))
       (= dom2 (find-mapping u1 u2 u1 u2))
       (= mp2 (find-mapping-total pat dom2 (compose pa syma) (map-empty))))
      ((Mu "R1" (compose mp2 u1))))

(let $sub  (App "sub" (map-of 0 9) (Var 0) (map-of 0 9) (Var 0)))
(union $sub (Null))
(let $add  (App "add" (map-empty) (Null) (map-empty) (Null)))
(run 25)

(check (Hit "R1" p))                    ; agrees with the reference
(check (Mu "R1" (map-of 0 10)))         ; one minted slot, used by both atoms

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; R2.  TWO DIFFERENT nodes, redundant slots named $9 and $7, with `?u`
;;; written in both atoms so the two slots must be identified.
;;;
;;;   e-graph:  sub($9,$9) = zero,  sub2($7,$7) = zero,  add(zero,zero)
;;;   pattern:  ?p == (add ?a ?b), ?a == (sub ?u ?u), ?b == (sub2 ?u ?u)
;;;   reference: 1 match, ?u = id0[$f11 -> $f26]   (the two slots MERGED)
;;;
;;; DIVERGES.  The two atoms hand the primitive different domains, so they mint
;;; $10 and $8, and nothing can bring them together.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= p (App "add" pa a pb b))
       (= a (App "sub"  u1 u u2 u))
       (= b (App "sub2" v1 u v2 u))
       (RenamesToLeader a syma a)
       (RenamesToLeader b symb b)
       (= pat  (find-mapping pa pb pa pb))
       (= dom2 (find-mapping u1 u2 u1 u2))
       (= dom3 (find-mapping v1 v2 v1 v2))
       (= mp2 (find-mapping-total pat dom2 (compose pa syma) (map-empty)))
       (= mp3 (find-mapping-total pat dom3 (compose pb symb) (map-empty)))
       (= mu  (compose mp2 u1))
       (= s3  (compose (inverse mu) (compose mp3 v1)))
       (RenamesToLeader u s3 u))
      ((Hit "R2" p)))

(rule ((= p (App "add" pa a pb b))
       (= a (App "sub" u1 u u2 u))
       (RenamesToLeader a syma a)
       (= pat  (find-mapping pa pb pa pb))
       (= dom2 (find-mapping u1 u2 u1 u2))
       (= mp2 (find-mapping-total pat dom2 (compose pa syma) (map-empty))))
      ((Mu "R2-atom2" (compose mp2 u1))))

(rule ((= p (App "add" pa a pb b))
       (= b (App "sub2" v1 u v2 u))
       (RenamesToLeader b symb b)
       (= pat  (find-mapping pa pb pa pb))
       (= dom3 (find-mapping v1 v2 v1 v2))
       (= mp3 (find-mapping-total pat dom3 (compose pb symb) (map-empty))))
      ((Mu "R2-atom3" (compose mp3 v1))))

(let $sub  (App "sub"  (map-of 0 9) (Var 0) (map-of 0 9) (Var 0)))
(let $sub2 (App "sub2" (map-of 0 7) (Var 0) (map-of 0 7) (Var 0)))
(union $sub  (Null))
(union $sub2 (Null))
(let $add  (App "add" (map-empty) (Null) (map-empty) (Null)))
(run 25)

;; the two atoms mint different slots for the same pattern variable ...
(check (Mu "R2-atom2" (map-of 0 10)))
(check (Mu "R2-atom3" (map-of 0 8)))

;; ... so the match the reference finds is lost.  KNOWN GAP: this `fail` is
;; asserting the bug, not the desired behaviour.
(fail (check (Hit "R2" p)))

(pop)
