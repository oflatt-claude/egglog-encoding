;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `Lam` binds child 1
(rule ((RenamesToLeader (Lam mvar0 (Var 0) m2 c2) ml l)
       (= v0 (map-get mvar0 0)))
      ((RenamesToLeader (Lam mvar0 (Var 0) m2 c2) (inverse (map-remove (inverse ml) v0)) l)))

;; `Let` binds child 1
(rule ((RenamesToLeader (Let mvar0 (Var 0) m2 c2 m3 c3) ml l)
       (= v0 (map-get mvar0 0)))
      ((RenamesToLeader (Let mvar0 (Var 0) m2 c2 m3 c3) (inverse (map-remove (inverse ml) v0)) l)))
