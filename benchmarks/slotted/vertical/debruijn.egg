;;; Ordinary SDQL. Var 0 is the innermost binder. Payload heads cost zero
;;; because ordinary extraction charges one for the payload itself.
;;; Keep scope helpers active: their bodies can acquire new alternatives later.
(sort U)
(constructor Lambda (U) U)
(constructor Sing (U U) U)
(constructor Add (U U) U)
(constructor Mult (U U) U)
(constructor Sub (U U) U)
(constructor Equality (U U) U)
(constructor Get (U U) U)
(constructor Range (U U) U)
(constructor App (U U) U)
(constructor IfThen (U U) U)
(constructor Binop (U U U) U)
(constructor SubArray (U U U) U)
(constructor Unique (U) U)
(constructor Sum (U U) U)
(constructor Merge (U U U) U)
(constructor Let (U U) U)
(constructor Num (i64) U :cost 0)
(constructor Symbol (String) U :cost 0)
(constructor Null () U)
(constructor Var (i64) U :cost 0)
(constructor Shift (U i64 i64) U :cost 100000)
(constructor Subst (U U i64) U :cost 100000)
(rewrite (Shift x 0 k) x)
(rewrite (Shift (Var i) d k) (Var i) :when ((< i k)))
(rewrite (Shift (Var i) d k) (Var (+ i d)) :when ((>= i k)))
(rewrite (Subst (Var i) a k) (Var i) :when ((< i k)))
(rewrite (Subst (Var i) a k) (Shift a k 0) :when ((= i k)))
(rewrite (Subst (Var i) a k) (Var (- i 1)) :when ((> i k)))
(rewrite (Shift (Lambda x2) d k) (Lambda (Shift x2 d (+ k 1))))
(rewrite (Subst (Lambda x2) a k) (Lambda (Subst x2 a (+ k 1))))
(rewrite (Shift (Sing x1 x2) d k) (Sing (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Sing x1 x2) a k) (Sing (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Add x1 x2) d k) (Add (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Add x1 x2) a k) (Add (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Mult x1 x2) d k) (Mult (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Mult x1 x2) a k) (Mult (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Sub x1 x2) d k) (Sub (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Sub x1 x2) a k) (Sub (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Equality x1 x2) d k) (Equality (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Equality x1 x2) a k) (Equality (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Get x1 x2) d k) (Get (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Get x1 x2) a k) (Get (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Range x1 x2) d k) (Range (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (Range x1 x2) a k) (Range (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (App x1 x2) d k) (App (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (App x1 x2) a k) (App (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (IfThen x1 x2) d k) (IfThen (Shift x1 d k) (Shift x2 d k)))
(rewrite (Subst (IfThen x1 x2) a k) (IfThen (Subst x1 a k) (Subst x2 a k)))
(rewrite (Shift (Binop x1 x2 x3) d k) (Binop (Shift x1 d k) (Shift x2 d k) (Shift x3 d k)))
(rewrite (Subst (Binop x1 x2 x3) a k) (Binop (Subst x1 a k) (Subst x2 a k) (Subst x3 a k)))
(rewrite (Shift (SubArray x1 x2 x3) d k) (SubArray (Shift x1 d k) (Shift x2 d k) (Shift x3 d k)))
(rewrite (Subst (SubArray x1 x2 x3) a k) (SubArray (Subst x1 a k) (Subst x2 a k) (Subst x3 a k)))
(rewrite (Shift (Unique x1) d k) (Unique (Shift x1 d k)))
(rewrite (Subst (Unique x1) a k) (Unique (Subst x1 a k)))
(rewrite (Shift (Sum x1 x4) d k) (Sum (Shift x1 d k) (Shift x4 d (+ k 2))))
(rewrite (Subst (Sum x1 x4) a k) (Sum (Subst x1 a k) (Subst x4 a (+ k 2))))
(rewrite (Shift (Merge x1 x2 x6) d k) (Merge (Shift x1 d k) (Shift x2 d k) (Shift x6 d (+ k 3))))
(rewrite (Subst (Merge x1 x2 x6) a k) (Merge (Subst x1 a k) (Subst x2 a k) (Subst x6 a (+ k 3))))
(rewrite (Shift (Let x1 x3) d k) (Let (Shift x1 d k) (Shift x3 d (+ k 1))))
(rewrite (Subst (Let x1 x3) a k) (Let (Subst x1 a k) (Subst x3 a (+ k 1))))
(rewrite (Shift (Num x1) d k) (Num x1))
(rewrite (Subst (Num x1) a k) (Num x1))
(rewrite (Shift (Symbol x1) d k) (Symbol x1))
(rewrite (Subst (Symbol x1) a k) (Symbol x1))
(rewrite (Shift (Null) d k) (Null))
(rewrite (Subst (Null) a k) (Null))
(rewrite (Let value body) (Subst body value 0) :name "beta")
(rewrite
  (Sum (Sum rows (Sing (Var 1) producer)) consumer)
  (Sum rows (Let (Var 1) (Let (Shift producer 1 0) (Shift consumer 2 2))))
  :name
  "sum-sum-vert-fuse-1")
(rewrite
  (Sum (Sum rows (Sing (Unique key) producer)) consumer)
  (Sum rows (Let (Unique key) (Let (Shift producer 1 0) (Shift consumer 2 2))))
  :name
  "sum-sum-vert-fuse-2")
