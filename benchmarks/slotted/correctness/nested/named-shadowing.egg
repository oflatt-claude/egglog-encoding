; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(let start (Lam $a (Lam $a (F $a $a0))))
(rewrite (Lam $x (Lam $y (F $y body))) (Lam $x (Lam $y (G body $y))))
(run 1)
