; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (Add b a) :when ((= p (Add a b))))
(rewrite q (K x y) :when ((= q (G x y))))
(let _t0 (Add (Sub $0 $0) (G $1 $1)))
(let _p0 (Add (Sub $0 $0) (G $1 $1)))
(let _p1 (Add (G $1 $1) (Sub $0 $0)))
(let _p2 (Add (Sub $0 $0) (K $1 $1)))
(let _p3 (K $1 $1))
(run 10)
