; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (Add (Add a b) c) :when ((= p (Add a x)) (= x (Add b c))))
(let _t0 (Add (Sub $0 $0) (Add (G $1 $1) (K $2 $2))))
(let _p0 (Add (Sub $0 $0) (Add (G $1 $1) (K $2 $2))))
(let _p1 (Add (Add (Sub $0 $0) (G $1 $1)) (K $2 $2)))
(let _p2 (Add (Sub $0 $0) (G $1 $1)))
(let _p3 (Null))
(run 10)
