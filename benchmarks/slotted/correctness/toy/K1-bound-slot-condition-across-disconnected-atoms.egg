; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite v0 (H r1 r1) :when ((= r0 (Lam $s0 v0)) (= r1 (Sub2 a b)) (free $s0 a)))
(let _t0 (Lam $0 $2))
(let _t1 (Sub2 $0 $1))
(let _p0 (Lam $0 $2))
(let _p1 (Sub2 $0 $1))
(let _p2 (H $0 $1))
(let _p3 (H $0 $0))
(let _p4 (Null))
(run 6)
