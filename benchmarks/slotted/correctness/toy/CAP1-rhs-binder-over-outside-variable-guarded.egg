; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (Lam $y (F body e)) :when ((= p (F l e)) (= l (Lam $y body)) (not-free $y e)))
(let _t0 (F (Lam $0 (Sub $0 $0)) $2))
(let _p0 (F (Lam $0 (Sub $0 $0)) $2))
(let _p1 (Lam $1 (F (Sub $1 $1) $2)))
(let _p2 (Lam $1 (F (Sub $1 $1) $1)))
(let _p3 (Null))
(run 3)
