; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H a b) :when ((= p (K e z)) (= e (Add l r)) (= l (F a b)) (= r (F a b))))
(let _t0 (K (Add (F $0 $1) (F $0 $1)) (Null)))
(let _p0 (K (Add (F $0 $1) (F $0 $1)) (Null)))
(let _p1 (H $0 $1))
(let _p2 (H $0 $0))
(run 10)
