; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H a a) :when ((= p (G c $0)) (= c (F a a))))
(let _t0 (F $0 $0))
(let _t1 (F $1 $1))
(let _t2 (G (F $0 $0) $0))
(union (F $0 $0) (F $1 $1))
(let _p0 (G (F $0 $0) $0))
(let _p1 (H $0 $0))
(let _p2 (H $1 $1))
(let _p3 (F $0 $0))
(let _p4 (Sub $0 $0))
(run 10)
