; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x1 (H x2 x1) :when ((= x3 (H x1 x2))))
(union (H (Null) $0) (Sub $0 $0))
(union (G (Null) $2) (Sub $0 $0))
(let _p0 (H (Null) $0))
(let _p1 (G (Null) $2))
(let _p2 (Sub $0 $0))
(let _p3 (H $0 $1))
(let _p4 (H $0 $0))
(let _p5 (Null))
(let _p6 (Sub $0 $0))
(run 6)
