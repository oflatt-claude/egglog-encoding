; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite out (Sub $x $x) :when ((= out (F l1 l2)) (= l1 (Lam $x b1)) (= b1 (Lam $y a)) (= l2 (Lam $x b2)) (= b2 (Lam $y a))))
(rewrite out (Sub $x $y) :when ((= out (F l1 l2)) (= l1 (Lam $x b1)) (= b1 (Lam $y a)) (= l2 (Lam $y b2)) (= b2 (Lam $x a))))
(let _t0 (F (Lam $0 (Lam $1 (F $0 $1))) (Lam $0 (Lam $1 (F $0 $1)))))
(union (F $0 $1) (F $1 $0))
(let _p0 (F (Lam $0 (Lam $1 (F $0 $1))) (Lam $0 (Lam $1 (F $0 $1)))))
(let _p1 (Sub $0 $0))
(let _p2 (Sub $0 $1))
(let _p3 (Null))
(run 6)
