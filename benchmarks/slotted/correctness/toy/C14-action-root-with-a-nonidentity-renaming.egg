; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x1 (H x3 x2) :when ((= x3 (F x1 x2))))
(let _t0 (F $2 (Null)))
(let _t1 (K $2 (Null)))
(union (G $1 (Null)) (K (Null) $0))
(let _p0 (F $2 (Null)))
(let _p1 (K $2 (Null)))
(let _p2 (G $1 (Null)))
(let _p3 (H $0 $1))
(let _p4 (H $0 $0))
(let _p5 (Null))
(let _p6 (Sub $0 $0))
(run 6)
