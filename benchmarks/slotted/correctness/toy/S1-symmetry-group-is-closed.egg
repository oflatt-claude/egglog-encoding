; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H x x) :when ((= p (F x x))))
(let _t0 (F (K (G $0 $1) $2) (K (G $2 $0) $1)))
(union (K (G $0 $1) $2) (K (G $1 $2) $0))
(let _p0 (F (K (G $0 $1) $2) (K (G $2 $0) $1)))
(let _p1 (H (K (G $0 $1) $2) (K (G $0 $1) $2)))
(let _p2 (H (K (G $0 $1) $2) (K (G $1 $2) $0)))
(run 10)
