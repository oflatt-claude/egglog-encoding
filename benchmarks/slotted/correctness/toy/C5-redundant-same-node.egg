; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H u u) :when ((= p (Add a b)) (= a (Sub u u)) (= b (Sub u u))))
(let _t0 (Add (Null) (Null)))
(union (Sub $0 $0) (Null))
(let _p0 (Add (Null) (Null)))
(let _p1 (H $0 $0))
(let _p2 (Null))
(run 10)
