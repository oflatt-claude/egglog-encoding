; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite c d :when ((= p (F a b)) (= b (K c d))))
(let _t0 (F $0 (K $1 $2)))
(let _t1 (K $1 $1))
(let _p0 (F $0 (K $1 $2)))
(let _p1 (K $1 $1))
(let _p2 (K $1 $2))
(let _p3 (H $0 $0))
(run 10)
