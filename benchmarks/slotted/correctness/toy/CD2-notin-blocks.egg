; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p b :when ((= p (Lam $s b)) (not-free $s b)))
(let _t0 (Lam $0 (G $0 $0)))
(let _p0 (Lam $0 (G $0 $0)))
(let _p1 (G $0 $0))
(let _p2 (G $1 $1))
(let _p3 (Null))
(run 10)
