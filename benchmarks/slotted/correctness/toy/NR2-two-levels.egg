; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H (G (K a b) a) b) :when ((= p (F a b))))
(let _t0 (F $0 $1))
(let _p0 (F $0 $1))
(let _p1 (H (G (K $0 $1) $0) $1))
(let _p2 (G (K $0 $1) $0))
(let _p3 (K $0 $1))
(run 10)
