; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x (H ??x a) :when ((= x (F ?x ??x)) (= ?x (G a b))))
(let _t0 (F (G $0 $1) $2))
(let _p0 (F (G $0 $1) $2))
(let _p1 (H $2 $0))
(let _p2 (H $0 $2))
(run 10)
