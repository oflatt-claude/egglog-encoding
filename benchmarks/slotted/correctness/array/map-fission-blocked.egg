; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Let (U U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (App (Sym "map") (Lam $x (App f gx))) (Lam $in (App (App (Sym "map") f) (App (App (Sym "map") (Lam $x gx)) $in))) :name "map-fission" :when ((not-free $x f)))
(let _t0 (App (Sym "map") (Lam $0 (App (App (Sym "f1") $0) (Sym "f2")))))
(let _p0 (App (Sym "map") (Lam $0 (App (App (Sym "f1") $0) (Sym "f2")))))
(let _p1 (Lam $1 (App (App (Sym "map") (App (Sym "f1") $0)) (App (App (Sym "map") (Lam $0 (Sym "f2"))) $1))))
(let _p2 (App (Sym "map") (Lam $0 (App (App (Sym "f1") $0) (Sym "f3")))))
(run 3)
