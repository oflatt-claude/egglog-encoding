; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Let (U U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (Let $x b e) b :name "let-unused" :when ((not-free $x b)))
(let _t0 (Let $0 (App (Sym "f1") (Sym "cc")) (Sym "aa")))
(let _p0 (Let $0 (App (Sym "f1") (Sym "cc")) (Sym "aa")))
(let _p1 (App (Sym "f1") (Sym "cc")))
(let _p2 (App (Sym "f1") (Sym "dd")))
(run 8)
