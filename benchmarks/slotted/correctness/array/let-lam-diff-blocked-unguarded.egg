; Frozen differential input; see generate_differential.py.
(sort U)
(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Let (U U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (Let $x (Lam $y body) e) (Lam $y (Let $x body e)) :name "let-lam-diff" :when ())
(let _t0 (Let $0 (Lam $1 (App $1 (Sym "cc"))) (Sym "aa")))
(let _p0 (Let $0 (Lam $1 (App $1 (Sym "cc"))) (Sym "aa")))
(let _p1 (Lam $1 (Let $0 (App $1 (Sym "cc")) (Sym "aa"))))
(let _p2 (Lam $1 (App $1 (Sym "cc"))))
(run 8)
