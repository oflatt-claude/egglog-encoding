(let input (Output (Symbol "q0") (Sum (Symbol "R") $r $c (Mult $c $c))))
(run 0)
(let target (Output (Symbol "q0") (Sum (Symbol "R") $r $c (Mult $c $c))))
(run 0)
(check (= input target))
