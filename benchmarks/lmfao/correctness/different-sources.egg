(sort U)
(constructor Lambda (U U) U :binder 0)
(constructor Sing (U U) U)
(constructor Add (U U) U)
(constructor Mult (U U) U)
(constructor Sub (U U) U)
(constructor Equality (U U) U)
(constructor Get (U U) U)
(constructor Range (U U) U)
(constructor App (U U) U)
(constructor IfThen (U U) U)
(constructor Binop (U U U) U)
(constructor SubArray (U U U) U)
(constructor Unique (U) U)
(constructor Sum (U U U U) U :binder 1 2)
(constructor Merge (U U U U U U) U :binder 2 3 4)
(constructor Let (U U U) U :binder 1)
(constructor Num (i64) U)
(constructor Symbol (String) U)
(constructor Null () U)
(constructor Pair (U U) U)
(constructor Output (U U) U)
(constructor Task (U U) U)
(constructor TaskPair (U U) U)
(constructor Batch (U U) U)
(constructor FusedBatch (U U) U)
(constructor GroupingBatch (U U) U)
(rewrite output (Batch input (Task name (Lambda $row (Lambda $count body)))) :name "batch-seed" :when ((= output (Output name aggregate)) (= aggregate (Sum input $row $count body))))
(rewrite program (Batch input (TaskPair a b)) :name "batch-merge" :when ((= program (Pair left right)) (= left (Batch input a)) (= right (Batch input b))))
(rewrite (Batch input tasks) (FusedBatch input tasks) :name "batch-fuse")
(rewrite (Batch input tasks) (GroupingBatch input tasks) :name "batch-grouping-sets")
(let input (Pair (Output (Symbol "q0") (Sum (Symbol "R") $q0_row $q0_count $q0_count)) (Output (Symbol "q1") (Sum (Symbol "S") $q1_row $q1_count $q1_count))))
(let wrong (Batch (Symbol "R") (TaskPair (Task (Symbol "q0") (Lambda $q0_row (Lambda $q0_count $q0_count))) (Task (Symbol "q1") (Lambda $q1_row (Lambda $q1_count $q1_count))))))
(run 8)
(fail (check (= input wrong)))
