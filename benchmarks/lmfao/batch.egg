;;; A task is a named aggregate body closed over (row, multiplicity).
;;; Batches preserve the ordered output tree and every output name.
(include "egglog-experimental/tests/slotted/languages/sdql.egg")
(constructor Pair (U U) U)
(constructor Output (U U) U)
(constructor Task (U U) U)
(constructor TaskPair (U U) U)
(constructor Batch (U U) U)
(constructor FusedBatch (U U) U)
(constructor GroupingBatch (U U) U)

;;; Only required outputs seed tasks; internal sums in the join are untouched.
(rewrite output (Batch input (Task name (Lambda $row (Lambda $count body))))
  :name "batch-seed"
  :when ((= output (Output name aggregate))
         (= aggregate (Sum input $row $count body))))

;;; Merge adjacent batches only when their source eclasses agree.
;;; Candidates follow the existing output tree.
(rewrite program (Batch input (TaskPair a b))
  :name "batch-merge"
  :when ((= program (Pair left right))
         (= left (Batch input a))
         (= right (Batch input b))))

;;; Physical alternatives preserve every task and its result. FusedBatch shares
;;; a scan for identical grouping keys. GroupingBatch additionally evaluates
;;; distinct groupings with identical sets of weights using GROUPING SETS.
(rewrite (Batch input tasks) (FusedBatch input tasks) :name "batch-fuse")
(rewrite (Batch input tasks) (GroupingBatch input tasks) :name "batch-grouping-sets")
