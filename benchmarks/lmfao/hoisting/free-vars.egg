;;; Scope analysis for the ordinary named representation of rules.egg.
(constructor Var (String) E)
(sort Names (Set String))
(function fv (E) Names :merge (set-intersect old new))
(rule ((= e (Var x))) ((set (fv e) (set-of x))))
(rule ((= e (Blocks))) ((set (fv e) (set-of))))
(rule ((= e (Field x f)) (= vs (fv x))) ((set (fv e) vs)))
(rule ((= e (Rows x)) (= vs (fv x))) ((set (fv e) vs)))
(rule ((= e (Mul a b)) (= av (fv a)) (= bv (fv b)))
      ((set (fv e) (set-union av bv))))
(rule ((= e (Sum d (Var x) b)) (= dv (fv d)) (= bv (fv b)))
      ((set (fv e) (set-union dv (set-remove bv x)))))
(rule ((= e (ScaleSum d a (Var x) b)) (= dv (fv d)) (= av (fv a)) (= bv (fv b)))
      ((set (fv e) (set-union av (set-union dv (set-remove bv x))))))
