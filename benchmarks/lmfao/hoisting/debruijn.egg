;;; Ordinary control. Var 0 names the nearest enclosing binder.
(sort E)
(constructor Sum (E E) E)
(constructor ScaleSum (E E E) E)
(constructor Mul (E E) E)
(constructor Field (E String) E)
(constructor Rows (E) E)
(constructor Blocks () E)
(constructor Lambda (E) E)
(constructor App (E E) E)
(constructor Pair (E E) E)
(constructor One () E)
(constructor Var (i64) E)
(constructor Shift (E i64 i64) E :cost 10000)
(constructor Subst (E E i64) E :cost 10000)

;;; Subst removes binder k; its replacement is expressed outside that binder.
;;; Discard resolved scope helpers to avoid repeatedly rewriting their equivalents.
(rewrite (Subst (Var i) a k) (Var i) :when ((< i k)) :subsume)
(rewrite (Subst (Var i) a k) (Shift a k 0) :when ((= i k)) :subsume)
(rewrite (Subst (Var i) a k) (Var (- i 1)) :when ((> i k)) :subsume)
(rewrite (Subst (Blocks) a k) (Blocks) :subsume)
(rewrite (Subst (One) a k) (One) :subsume)
(rewrite (Subst (Field x f) a k) (Field (Subst x a k) f) :subsume)
(rewrite (Subst (Rows x) a k) (Rows (Subst x a k)) :subsume)
(rewrite (Subst (Mul x y) a k) (Mul (Subst x a k) (Subst y a k)) :subsume)
(rewrite (Subst (Pair x y) a k) (Pair (Subst x a k) (Subst y a k)) :subsume)
(rewrite (Subst (App x y) a k) (App (Subst x a k) (Subst y a k)) :subsume)
(rewrite (Subst (Lambda body) a k) (Lambda (Subst body a (+ k 1))) :subsume)
(rewrite (Subst (Sum rows body) a k) (Sum (Subst rows a k) (Subst body a (+ k 1))) :subsume)
(rewrite (Subst (ScaleSum rows f body) a k) (ScaleSum (Subst rows a k) (Subst f a k) (Subst body a (+ k 1))) :subsume)
(rewrite (Shift x 0 k) x :subsume)
(rewrite (Shift (Var i) d k) (Var i) :when ((< i k)) :subsume)
(rewrite (Shift (Var i) d k) (Var (+ i d)) :when ((>= i k)) :subsume)
(rewrite (Shift (Blocks) d k) (Blocks) :subsume)
(rewrite (Shift (One) d k) (One) :subsume)
(rewrite (Shift (Field x f) d k) (Field (Shift x d k) f) :subsume)
(rewrite (Shift (Rows x) d k) (Rows (Shift x d k)) :subsume)
(rewrite (Shift (Mul x y) d k) (Mul (Shift x d k) (Shift y d k)) :subsume)
(rewrite (Shift (Pair x y) d k) (Pair (Shift x d k) (Shift y d k)) :subsume)
(rewrite (Shift (App x y) d k) (App (Shift x d k) (Shift y d k)) :subsume)
(rewrite (Shift (Lambda body) d k) (Lambda (Shift body d (+ k 1))) :subsume)
(rewrite (Shift (Sum rows body) d k) (Sum (Shift rows d k) (Shift body d (+ k 1))) :subsume)
(rewrite (Shift (ScaleSum rows f body) d k) (ScaleSum (Shift rows d k) (Shift f d k) (Shift body d (+ k 1))) :subsume)

;;; Demand-driven absence checks work at arbitrary binder depth.
(relation NeedAbsent (E i64))
(function Absent (E i64) bool :merge (or old new))
(rule ((NeedAbsent e k)) ((set (Absent e k) false)))
(rule ((Sum rows body) (= body (Mul factor rest))) ((NeedAbsent factor 0)))
(rule ((Sum rows body) (= body (Mul rest factor))) ((NeedAbsent factor 0)))
(rule ((NeedAbsent e k) (= e (Var i)) (!= i k) (= (Absent e k) false)) ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Blocks)) (= (Absent e k) false)) ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (One)) (= (Absent e k) false)) ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Field x f)) (= (Absent e k) false)) ((NeedAbsent x k)))
(rule ((NeedAbsent e k)
       (= e (Field x f))
       (= (Absent x k) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Rows x)) (= (Absent e k) false)) ((NeedAbsent x k)))
(rule ((NeedAbsent e k)
       (= e (Rows x))
       (= (Absent x k) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Mul a b)) (= (Absent e k) false)) ((NeedAbsent a k) (NeedAbsent b k)))
(rule ((NeedAbsent e k)
       (= e (Mul a b))
       (= (Absent a k) true)
       (= (Absent b k) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Pair a b)) (= (Absent e k) false)) ((NeedAbsent a k) (NeedAbsent b k)))
(rule ((NeedAbsent e k)
       (= e (Pair a b))
       (= (Absent a k) true)
       (= (Absent b k) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (App a b)) (= (Absent e k) false)) ((NeedAbsent a k) (NeedAbsent b k)))
(rule ((NeedAbsent e k)
       (= e (App a b))
       (= (Absent a k) true)
       (= (Absent b k) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k) (= e (Lambda b)) (= (Absent e k) false)) ((NeedAbsent b (+ k 1))))
(rule ((NeedAbsent e k)
       (= e (Lambda b))
       (= (Absent b (+ k 1)) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k)
       (= e (Sum r b))
       (= (Absent e k) false))
      ((NeedAbsent r k) (NeedAbsent b (+ k 1))))
(rule ((NeedAbsent e k)
       (= e (Sum r b))
       (= (Absent r k) true)
       (= (Absent b (+ k 1)) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rule ((NeedAbsent e k)
       (= e (ScaleSum r a b))
       (= (Absent e k) false))
      ((NeedAbsent r k) (NeedAbsent a k) (NeedAbsent b (+ k 1))))
(rule ((NeedAbsent e k)
       (= e (ScaleSum r a b))
       (= (Absent r k) true)
       (= (Absent a k) true)
       (= (Absent b (+ k 1)) true)
       (= (Absent e k) false))
      ((set (Absent e k) true)))
(rewrite (App (Lambda body) a) (Subst body a 0) :name "inline-scalar-function")
(rewrite total (ScaleSum rows (Shift factor -1 0) rest)
  :name "hoist-independent-factor"
  :when ((= total (Sum rows body))
         (= body (Mul factor rest))
         (= (Absent factor 0) true)))
(rewrite total (ScaleSum rows (Shift factor -1 0) rest)
  :name "hoist-independent-right-factor"
  :when ((= total (Sum rows body))
         (= body (Mul rest factor))
         (= (Absent factor 0) true)))
(rewrite pair (Sum rows (Pair a b))
  :name "fuse-sums"
  :when ((= pair (Pair left right))
         (= left (Sum rows a))
         (= right (Sum rows b))))
