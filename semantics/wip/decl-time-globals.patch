+  intro e
+  induction e using Expr.rec
+    (motive_2 := fun es => ∀ (g : FnName),
+      g ∈ Expr.fnsList (Expr.resolveGlobalsList σ es) →
+        g ∈ Expr.fnsList es ∨ ∃ b ∈ σ, g ∈ b.2.toExpr.fns) with
+  | lit l => intro g h; simp at h
+  | var v =>
