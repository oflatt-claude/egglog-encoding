+@[inherit_doc Expr.fns_resolveGlobals]
+theorem Expr.fnsList_resolveGlobalsList (σ : Env) :
+    ∀ (es : List Expr) (g : FnName), g ∈ Expr.fnsList (Expr.resolveGlobalsList σ es) →
