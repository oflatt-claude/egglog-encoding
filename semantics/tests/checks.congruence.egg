(sort Math)
(ruleset r0)
(ruleset r1)
(ruleset r2)
(ruleset r3)
(relation @NodeA (Math))
(relation @NodeB (Math))
(relation @SubA ())
(relation @NodeF (Math Math))
(relation @SubF (Math))
(relation @SubB ())
(constructor A () Math)
(constructor B () Math)
(relation @UF (Math Math))
(constructor F (Math) Math)
(rule () ((@NodeA (A)) (@UF (A) (A)) (@NodeF (A) (F (A))) (@UF (F (A)) (F (A)))) :ruleset r0)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((@SubA) (A)) ((subsume (A))) :ruleset r1)
(rule ((@NodeF @a0 @k) (@NodeF @b0 @l) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @k @y) (@UF @l @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((@SubF @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0)) ((subsume (F @b0))) :ruleset r1)
(rule ((@SubB) (B)) ((subsume (B))) :ruleset r1)
(run-schedule (seq (run r0) (saturate (run r1))))
(rule () ((@NodeA (A)) (@UF (A) (A)) (@NodeB (B)) (@UF (B) (B)) (@UF (A) (min (A) (B))) (@UF (B) (min (A) (B)))) :ruleset r2)
(run r2 1)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r3)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r3)
(rule ((@SubA) (A)) ((subsume (A))) :ruleset r3)
(rule ((@NodeF @a0 @k) (@NodeF @b0 @l) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @k @y) (@UF @l @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((@SubF @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0)) ((subsume (F @b0))) :ruleset r3)
(rule ((@SubB) (B)) ((subsume (B))) :ruleset r3)
(run-schedule (saturate (run r3)))
(check (F @v0) (@UF @v0 x) (@UF (F @v0) @v1) (B) (@UF (B) @v2) (= x @v2) (A) (@UF (A) @v3) (F @v4) (@UF @v4 @v3) (@UF (F @v4) @v5) (B) (@UF (B) @v6) (F @v7) (@UF @v7 @v6) (@UF (F @v7) @v8) (= @v5 @v8))
