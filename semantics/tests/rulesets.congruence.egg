(sort Math)
(ruleset lower)
(ruleset upper)
(ruleset @rebuild)
(function @UF (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor A () Math)
(function @AView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor G (Math) Math)
(function @GView (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor F (Math) Math)
(function @FView (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)) :ruleset @rebuild)
(rule ((= @e (@AView)) (= @x (@UF @e))) ((set (@AView) @x)) :ruleset @rebuild)
(rule ((= @e (@GView @c0)) (= @x (@UF @e))) ((set (@GView @c0) @x)) :ruleset @rebuild)
(rule ((= @e (@GView @c0)) (= @x (@UF @c0))) ((set (@GView @x) @e)) :ruleset @rebuild)
(rule ((= @e (@FView @c0)) (= @x (@UF @e))) ((set (@FView @c0) @x)) :ruleset @rebuild)
(rule ((= @e (@FView @c0)) (= @x (@UF @c0))) ((set (@FView @x) @e)) :ruleset @rebuild)
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)) :ruleset lower)
(rule ((= @e (@AView)) (= @x (@UF @e))) ((set (@AView) @x)) :ruleset lower)
(rule ((= @e (@GView @c0)) (= @x (@UF @e))) ((set (@GView @c0) @x)) :ruleset lower)
(rule ((= @e (@GView @c0)) (= @x (@UF @c0))) ((set (@GView @x) @e)) :ruleset lower)
(rule ((= @e (@FView @c0)) (= @x (@UF @e))) ((set (@FView @c0) @x)) :ruleset lower)
(rule ((= @e (@FView @c0)) (= @x (@UF @c0))) ((set (@FView @x) @e)) :ruleset lower)
(set (@AView) (A))
(set (@FView (A)) (F (A)))
(run-schedule (saturate @rebuild))
(rule ((= @v0 (@FView x))) ((set (@GView x) (G x))) :ruleset lower)
(rule ((= @v0 (@GView x))) ((set (@GView x) (G x)) (set (@FView x) (F x)) (set (@UF (G x)) (min (G x) (F x))) (set (@UF (F x)) (min (G x) (F x)))) :ruleset upper)
(run-schedule (saturate lower))
(run-schedule (saturate @rebuild))
(run upper 1)
(run-schedule (saturate @rebuild))
