(sort Math)
(ruleset @rebuild)
(function @UF (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor N1 () Math)
(function @N1View () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor N2 () Math)
(function @N2View () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor N3 () Math)
