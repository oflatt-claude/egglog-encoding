(rule ((= @e (@PathView @c0 @c1)) (= @x (@UF @c1))) ((set (@PathView @c0 @x) @e)) :ruleset @rebuild)
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)))
(rule ((= @e (@N1View)) (= @x (@UF @e))) ((set (@N1View) @x)))
(rule ((= @e (@N2View)) (= @x (@UF @e))) ((set (@N2View) @x)))
(rule ((= @e (@N3View)) (= @x (@UF @e))) ((set (@N3View) @x)))
(rule ((= @e (@N4View)) (= @x (@UF @e))) ((set (@N4View) @x)))
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @e))) ((set (@EdgeView @c0 @c1) @x)))
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @c0))) ((set (@EdgeView @x @c1) @e)))
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @c1))) ((set (@EdgeView @c0 @x) @e)))
(rule ((= @e (@PathView @c0 @c1)) (= @x (@UF @e))) ((set (@PathView @c0 @c1) @x)))
(rule ((= @e (@PathView @c0 @c1)) (= @x (@UF @c0))) ((set (@PathView @x @c1) @e)))
(rule ((= @e (@PathView @c0 @c1)) (= @x (@UF @c1))) ((set (@PathView @c0 @x) @e)))
(set (@N1View) (N1))
(set (@N2View) (N2))
(set (@EdgeView (N1) (N2)) (Edge (N1) (N2)))
(run-schedule (saturate @rebuild))
(set (@N2View) (N2))
(set (@N3View) (N3))
