(rule ((= @e (@N4View)) (= @x (@UF @e))) ((set (@N4View) @x)) :ruleset @rebuild)
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @e))) ((set (@EdgeView @c0 @c1) @x)) :ruleset @rebuild)
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @c0))) ((set (@EdgeView @x @c1) @e)) :ruleset @rebuild)
(rule ((= @e (@EdgeView @c0 @c1)) (= @x (@UF @c1))) ((set (@EdgeView @c0 @x) @e)) :ruleset @rebuild)
(rule ((= @e (@PathView @c0 @c1)) (= @x (@UF @e))) ((set (@PathView @c0 @c1) @x)) :ruleset @rebuild)
