(constructor N4 () Math)
(function @N4View () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor Edge (Math Math) Math)
(function @EdgeView (Math Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor Path (Math Math) Math)
(function @PathView (Math Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)) :ruleset @rebuild)
(rule ((= @e (@N1View)) (= @x (@UF @e))) ((set (@N1View) @x)) :ruleset @rebuild)
