(sort Math)
(ruleset r0)
(ruleset r1)
(relation @NodeA (Math))
(relation @SubA ())
(constructor A () Math)
(relation @NodeF (Math Math))
(relation @SubF (Math))
(relation @SubB ())
(constructor B () Math)
(relation @UF (Math Math))
(constructor F (Math) Math)
(rule () ((@NodeA (A)) (@UF (A) (A)) (@NodeF (A) (F (A))) (@UF (F (A)) (F (A)))) :ruleset r0)
(run r0 1)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((@SubA) (A)) ((subsume (A))) :ruleset r1)
(rule ((@NodeF @a0 @k) (@NodeF @b0 @l) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @k @y) (@UF @l @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((@SubF @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0)) ((subsume (F @b0))) :ruleset r1)
(rule ((@SubB) (B)) ((subsume (B))) :ruleset r1)
(run-schedule (saturate (run r1)))
(check (B) (@UF (B) @v0) (F @v1) (@UF @v1 @v0) (@UF (F @v1) @v2))
