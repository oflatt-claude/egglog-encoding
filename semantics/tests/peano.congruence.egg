(rule ((@SubEval @a0) (Eval @b0) (@UF @a0 @r0) (@UF @b0 @r0)) ((subsume (Eval @b0))) :ruleset r3)
(rule ((@NodeAdd @a0 @a1 @k) (@NodeAdd @b0 @b1 @l) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @a1 @r1) (@UF @b1 @r1) (@UF @k @y) (@UF @l @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((@SubAdd @a0 @a1) (Add @b0 @b1) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @a1 @r1) (@UF @b1 @r1)) ((subsume (Add @b0 @b1))) :ruleset r3)
