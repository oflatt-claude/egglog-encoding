(rule () ((@NodeZero (Zero)) (@UF (Zero) (Zero)) (@NodeSucc (Zero) (Succ (Zero))) (@UF (Succ (Zero)) (Succ (Zero))) (@NodeSucc (Succ (Zero)) (Succ (Succ (Zero)))) (@UF (Succ (Succ (Zero))) (Succ (Succ (Zero)))) (@NodeZero (Zero)) (@UF (Zero) (Zero)) (@NodeSucc (Zero) (Succ (Zero))) (@UF (Succ (Zero)) (Succ (Zero))) (@NodeAdd (Succ (Succ (Zero))) (Succ (Zero)) (Add (Succ (Succ (Zero))) (Succ (Zero)))) (@UF (Add (Succ (Succ (Zero))) (Succ (Zero))) (Add (Succ (Succ (Zero))) (Succ (Zero)))) (@NodeEval (Add (Succ (Succ (Zero))) (Succ (Zero))) (Eval (Add (Succ (Succ (Zero))) (Succ (Zero))))) (@UF (Eval (Add (Succ (Succ (Zero))) (Succ (Zero)))) (Eval (Add (Succ (Succ (Zero))) (Succ (Zero)))))) :ruleset r0)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
