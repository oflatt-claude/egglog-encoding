(run-schedule (seq (run r0) (saturate (run r1))))
(rule ((Zero) (@UF (Zero) @v0) (Add @v1 @v2) (@UF @v1 @v0) (@UF @v2 y) (@UF (Add @v1 @v2) @v3) (Eval @v4) (@UF @v4 @v3) (@UF (Eval @v4) @v5)) ((@NodeZero (Zero)) (@UF (Zero) (Zero)) (@UF y y) (@NodeAdd (Zero) y (Add (Zero) y)) (@UF (Add (Zero) y) (Add (Zero) y)) (@NodeEval (Add (Zero) y) (Eval (Add (Zero) y))) (@UF (Eval (Add (Zero) y)) (Eval (Add (Zero) y))) (@UF y y) (@NodeEval y (Eval y)) (@UF (Eval y) (Eval y)) (@UF (Eval (Add (Zero) y)) (min (Eval (Add (Zero) y)) (Eval y))) (@UF (Eval y) (min (Eval (Add (Zero) y)) (Eval y)))) :ruleset r2)
