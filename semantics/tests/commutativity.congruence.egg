(rule ((@SubTwo) (Two)) ((subsume (Two))) :ruleset r1)
(rule ((@NodeAdd @a0 @a1 @k) (@NodeAdd @b0 @b1 @l) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @a1 @r1) (@UF @b1 @r1) (@UF @k @y) (@UF @l @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
