(sort Math)
(ruleset @rebuild)
(function @UF (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor A () Math)
(function @AView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor B () Math)
(function @BView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor F (Math) Math)
(function @FView (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor G (Math) Math)
(function @GView (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)) :ruleset @rebuild)
(rule ((= @e (@AView)) (= @x (@UF @e))) ((set (@AView) @x)) :ruleset @rebuild)
(rule ((= @e (@BView)) (= @x (@UF @e))) ((set (@BView) @x)) :ruleset @rebuild)
(rule ((= @e (@FView @c0)) (= @x (@UF @e))) ((set (@FView @c0) @x)) :ruleset @rebuild)
