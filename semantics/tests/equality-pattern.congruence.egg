(rule ((= @v0 (@FView x)) (= @v1 (@GView y)) (= @v0 @v1)) ((set (@UF x) (min x y)) (set (@UF y) (min x y))))
(run-schedule (saturate (run)))
(run-schedule (saturate @rebuild))
