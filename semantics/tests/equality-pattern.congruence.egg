(rule ((= @e (@AView)) (= @x (@UF @e))) ((set (@AView) @x)))
(rule ((= @e (@BView)) (= @x (@UF @e))) ((set (@BView) @x)))
(rule ((= @e (@FView @c0)) (= @x (@UF @e))) ((set (@FView @c0) @x)))
(rule ((= @e (@FView @c0)) (= @x (@UF @c0))) ((set (@FView @x) @e)))
(rule ((= @e (@GView @c0)) (= @x (@UF @e))) ((set (@GView @c0) @x)))
(rule ((= @e (@GView @c0)) (= @x (@UF @c0))) ((set (@GView @x) @e)))
(set (@AView) (A))
(set (@FView (A)) (F (A)))
(run-schedule (saturate @rebuild))
(set (@BView) (B))
(set (@GView (B)) (G (B)))
