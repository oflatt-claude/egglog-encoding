(sort Math)
(ruleset @rebuild)
(function @UF (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor F (Math) Math)
(function @FView (Math) Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor A () Math)
(function @AView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor B () Math)
(function @BView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor C () Math)
(function @CView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(constructor D () Math)
(function @DView () Math :merge ((set (@UF old) (min old new)) (set (@UF new) (min old new)) (min old new)))
(rule ((= @b (@UF @a)) (= @c (@UF @b))) ((set (@UF @a) @c)) :ruleset @rebuild)
(rule ((= @e (@FView @c0)) (= @x (@UF @e))) ((set (@FView @c0) @x)) :ruleset @rebuild)
(rule ((= @e (@FView @c0)) (= @x (@UF @c0))) ((set (@FView @x) @e)) :ruleset @rebuild)
(rule ((= @e (@AView)) (= @x (@UF @e))) ((set (@AView) @x)) :ruleset @rebuild)
(rule ((= @e (@BView)) (= @x (@UF @e))) ((set (@BView) @x)) :ruleset @rebuild)
(rule ((= @e (@CView)) (= @x (@UF @e))) ((set (@CView) @x)) :ruleset @rebuild)
(rule ((= @e (@DView)) (= @x (@UF @e))) ((set (@DView) @x)) :ruleset @rebuild)
(set (@AView) (A))
(set (@FView (A)) (F (A)))
(run-schedule (saturate @rebuild))
(set (@DView) (D))
(set (@FView (D)) (F (D)))
(run-schedule (saturate @rebuild))
(set (@AView) (A))
(set (@BView) (B))
(set (@UF (A)) (min (A) (B)))
(set (@UF (B)) (min (A) (B)))
(run-schedule (saturate @rebuild))
(set (@BView) (B))
(set (@CView) (C))
(set (@UF (B)) (min (B) (C)))
(set (@UF (C)) (min (B) (C)))
(run-schedule (saturate @rebuild))
(set (@CView) (C))
(set (@DView) (D))
(set (@UF (C)) (min (C) (D)))
(set (@UF (D)) (min (C) (D)))
(run-schedule (saturate @rebuild))
