;;; `slotted-subst` against the full slotted encoding.
;;;
;;; `(slotted-subst body x var t_ren t)` extracts a smallest term rooted at
;;; `body`, replaces the variable at slot `x` of `body`'s frame with the
;;; invocation `t_ren * t`, and adds the result back. `var` is the class every
;;; variable lives in -- `(SlottedVar_0 0)` here -- passed in so the primitive stays
;;; language-agnostic.
;;;
;;; It reads tables (to extract) and writes them (to add the result), so it is
;;; only callable from an action: a top-level one, or the head of a `:naive`
;;; rule.
;;;
;;; It reads e-node rows, so it has to be handed a value that still holds the
;;; node. Compression deletes a non-canonical node, so a rule should reach the
;;; class's canonical member through `RenamesToLeader_0` first.  The `slotted`
;;; machinery must also have populated `ClassSlots_0`, which is the exact public
;;; frame the primitive substitutes in.
;;;
;;; The node generator also supplies hidden Unit-valued `SlottedNodeLayout`,
;;; `SlottedEdgeLayout`, and `SlottedBinderLayout` facts.  They identify every physical
;;; edge, which binder-marker edge covers which child, and the optional string head that
;;; activates a generic binder.  The primitive validates them instead of guessing from
;;; runtime `Id` columns (where an equality-sort child and a container look alike).
;;; Binder markers are therefore excluded from traversal and `AstSize`, shadowing stops
;;; descent into the covered child, and rebuilding refreshes a private binder to avoid
;;; capturing the replacement's free slots.  Source-language containers are unsupported.

(include "target/slotted/slotted-lang-encoded.egg")


;;; Case 1- a slot that occurs: h($0, $1)[$0 := null] = h(null, $1)
(push)

(let $body (H (map-of 0 0) (SlottedVar_0 0) (map-of 0 1) (SlottedVar_0 0)))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 0 (SlottedVar_0 0) (map-empty) (Null) "ClassSlots_0"))
(check (= $out (H (map-empty) (Null) (map-of 0 1) (SlottedVar_0 0))))
(fail (check (= $out $body)))

(pop)


;;; Case 2- a slot the body does not name cannot occur in it, so the body comes
;;; back as it is.
(push)

(let $body (H (map-of 0 1) (SlottedVar_0 0) (map-of 0 2) (SlottedVar_0 0)))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 0 (SlottedVar_0 0) (map-empty) (Null) "ClassSlots_0"))
(check (= $out $body))

(pop)


;;; Case 3- a nested occurrence, and the subterm that cannot mention the slot
;;; is shared rather than copied.
(push)

(let $inner (H (map-of 0 0) (SlottedVar_0 0) (map-of 0 1) (SlottedVar_0 0)))
(let $body (G (map-of 0 0 1 1) $inner (map-of 0 2) (SlottedVar_0 0)))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 0 (SlottedVar_0 0) (map-empty) (Null) "ClassSlots_0"))
(check (= $out (G
                     (map-of 1 1) (H (map-empty) (Null) (map-of 0 1) (SlottedVar_0 0))
                     (map-of 0 2) (SlottedVar_0 0))))

(pop)


;;; Case 4- a redundant node slot survives the frame change.
;;;
;;; `$c`'s node names slots {0, 7} while the edge reaching it says its class has
;;; only slot 0, so 7 is redundant and outside the frame the substitution
;;; carries in. `compose` would drop it, leaving an edge that misstates which
;;; slots `(SlottedVar_0 0)` has.
(push)

(let $c (H (map-of 0 0) (SlottedVar_0 0) (map-of 0 7) (SlottedVar_0 0)))
(let $body (G (map-of 0 5) $c (map-of 0 6) (SlottedVar_0 0)))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 5 (SlottedVar_0 0) (map-empty) (Null) "ClassSlots_0"))
(check (= x (H (map-empty) (Null) (map-of 0 7) (SlottedVar_0 0))))
(fail (check (= x (H (map-empty) (Null) (map-empty) (SlottedVar_0 0)))))

(pop)


;;; Case 5- a beta step from a `:naive` rule.
;;;
;;; The frames here are identities on the slots they cover, so the lambda's
;;; frame, its body's frame and the application's frame agree and the result can
;;; be unioned into the redex directly. A rule for arbitrary frames has to carry
;;; `x`, `t` and the result through the surrounding renamings.
(push)

;; b = h($0, $1)
(let $b (H (map-of 0 0) (SlottedVar_0 0) (map-of 0 1) (SlottedVar_0 0)))
;; lambda $0. b -- slots {1}, since 0 is bound
(let $lam (Lam (map-of 0 0) (SlottedVar_0 0) (map-of 0 0 1 1) $b))
;; (lambda $0. b) null
(let $redex (App (map-of 1 1) $lam (map-empty) (Null)))

(rule ((= e (App ml l mt t))
       (= l (Lam mx (SlottedVar_0 0) mb bod))
       (= x (map-get mx 0)))
      ((union e (slotted-subst bod x (SlottedVar_0 0) mt t "ClassSlots_0")))
      :naive)

(run-schedule (saturate (run slotted)))
(run 1)

;; ((lambda $0. h($0, $1)) null) = h(null, $1)
(check (= $redex (H (map-empty) (Null) (map-of 0 1) (SlottedVar_0 0))))

(pop)


;;; Case 6- a replacement's free slot is not captured by a generic lambda.
;;;
;;; `App2` represents many operators, so the binder-layout row is conditional on
;;; its `"lambda"` payload.  Rebuilding the lambda refreshes its private `$0`
;;; while leaving the replacement's free `$0` alone.
(push)

(let $sum (Plus (map-of 0 1) (SlottedVar_0 0) (map-of 0 0) (SlottedVar_0 0)))
(let $body (Lam (map-of 0 0) (SlottedVar_0 0) (map-of 0 0 1 1) $sum))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 1 (SlottedVar_0 0) (map-of 0 0) (SlottedVar_0 0) "ClassSlots_0"))
(let $capture-avoiding
     (Lam (map-of 0 2) (SlottedVar_0 0)
           (map-of 0 0 2 2)
           (Plus (map-of 0 0) (SlottedVar_0 0) (map-of 0 2) (SlottedVar_0 0))))
(let $captured
     (Lam (map-of 0 0) (SlottedVar_0 0)
           (map-of 0 0)
           (Plus (map-of 0 0) (SlottedVar_0 0) (map-of 0 0) (SlottedVar_0 0))))
(run-schedule (saturate (run slotted)))
(check (= $out $capture-avoiding))
(fail (check (= $out $captured)))

(pop)


;;; Case 7- the same physical columns are ordinary children under another head.
;;;
;;; The `"pair"` row must not activate `App2`'s lambda binder metadata.  Its first
;;; child is therefore traversed and substituted normally.
(push)

(let $body (Pair (map-of 0 0) (SlottedVar_0 0) (map-of 0 1) (SlottedVar_0 0)))
(run-schedule (saturate (run slotted)))

(let $out (slotted-subst $body 0 (SlottedVar_0 0) (map-empty) (Null) "ClassSlots_0"))
(check (= $out (Pair (map-empty) (Null) (map-of 0 1) (SlottedVar_0 0))))

(pop)
