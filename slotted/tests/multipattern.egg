;;; Multipatterns: rules whose premise is several patterns joined by shared variables.
;;;
;;; `rewrite` has no separate premise list. One pattern is the left-hand side, and
;;; `:when` carries a LIST of facts -- each `(= v <call>)` another pattern rooted at
;;; `v`. So a rule joins as many patterns as it likes, and the variables they share are
;;; the join.
;;;
;;; Every section asserts BOTH halves: that the rule fires where the join holds, and
;;; that it does NOT where the join fails. Only the second half has teeth -- a
;;; multipattern that quietly ignored its extra atoms would pass the first on its own.
;;;
;;; Every term a section asks about is built BEFORE its `(run)`. A term added after the
;;; run has had no rule applied to it, so a `fail` claim about it would hold whatever
;;; the rule does.
;;;
;;;     python3 slotted/slotted-egglog.py slotted/tests/multipattern.egg

(constructor Num (i64) U)
(constructor Add (U U) U)
(constructor Mul (U U) U)
(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Pair (U U) U)
(constructor Root (U) U)
(constructor Mem0 () U)
(constructor Store (U U U) U)
(constructor LoadFrom (U U) U)
(constructor Same () U)
(constructor Doubled () U)
(constructor Fired () U)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Beta, guarded by the shape of the function.
;;;
;;; Two patterns joined on `f`. The premise binds a slot and a body that the left-hand
;;; side never mentions, and the right-hand side uses both -- so a `:when` pattern is a
;;; premise the conclusion can read, not a filter run beside it.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (App f x) (subst body $v x)
         :when ((= f (Lam $v body)))
         :name "beta-guarded")

;; (fun y. y + y) 3   ->   3 + 3
(let e (App (Lam $0 (Add $0 $0)) (Num 3)))
(let want (Add (Num 3) (Num 3)))
;; The function is not a lambda, so the premise fails and nothing fires. The claim
;; names `want` rather than `(Num 3)` because that is what a MISFIRE would produce:
;; a premise not joined to `f` is satisfied by the lambda above, and substituting into
;; its body gives exactly `want`.
(let stuck (App (Num 1) (Num 3)))
(run 4)

(check (= e want))
(fail (check (= stuck want)))
(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; A join on TWO variables at once: load from the memory a store produced, at the
;;; address it wrote.
;;;
;;; `m` and `p` both have to agree between the two patterns. The second claim changes
;;; only the address, so it is `p`'s half of the join that has to refuse it.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (LoadFrom m p) v
         :when ((= m (Store m0 p v)))
         :name "load-after-store")

(let m1 (Store (Mem0) (Num 7) (Num 42)))
(let got (LoadFrom m1 (Num 7)))
(let other (LoadFrom m1 (Num 8)))
(run 4)

(check (= got (Num 42)))
(fail (check (= other (Num 42))))
(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Four patterns, chained two deep: recognising `(a*b) + (a*b)`.
;;;
;;; `a` and `b` occur nowhere on the left-hand side -- they are introduced by the
;;; premises and joined only to each other, which is the case a rule form would
;;; normally be reached for.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (Root e) (Doubled)
         :when ((= e (Add l r))
                (= l (Mul a b))
                (= r (Mul a b)))
         :name "double-product")

(let yes (Root (Add (Mul (Num 2) (Num 3)) (Mul (Num 2) (Num 3)))))
;; the factors differ, so the join across the two `Mul` patterns fails
(let no (Root (Add (Mul (Num 2) (Num 3)) (Mul (Num 2) (Num 4)))))
;; the shape is right below but the top is a `Mul`, so the first premise fails
(let no2 (Root (Mul (Mul (Num 2) (Num 3)) (Mul (Num 2) (Num 3)))))
(run 6)

(check (= yes (Doubled)))
(fail (check (= no (Doubled))))
(fail (check (= no2 (Doubled))))
(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; A variable shared UNDER TWO BINDERS: two lambdas with the same body.
;;;
;;; `body` is reached through a different edge in each premise, so this join holds up
;;; to renaming rather than by pointer -- which is the whole difference between a
;;; slotted e-graph and an ordinary one.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (Pair f g) (Same)
         :when ((= f (Lam $v body))
                (= g (Lam $w body)))
         :name "same-body")

;; the bound slots are spelled differently and the bodies ignore them: one class
(let p (Pair (Lam $0 (Num 1)) (Lam $3 (Num 1))))
;; different bodies, so `body` cannot join
(let q (Pair (Lam $0 (Num 1)) (Lam $3 (Num 2))))
(run 4)

(check (= p (Same)))
(fail (check (= q (Same))))
(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; A SLOT LITERAL shared between two binder columns joins NOTHING.
;;;
;;; The trap next to the section above. A shared *variable* is a join; a shared slot
;;; name in a binder column is not. Each premise looks its own node up and gets its
;;; own name for that node's bound slot, so writing `$x` in both constrains nothing
;;; and the rule fires on two lambdas that have nothing to do with each other.
;;;
;;; To relate two binders, share the body -- as the section above does.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (Pair f g) (Fired)
         :when ((= f (Lam $x c))
                (= g (Lam $x d)))
         :name "shared-slot-literal")

;; not alpha-equivalent, unrelated bodies -- and it still fires
(let unrelated (Pair (Lam $0 (Num 1)) (Lam $0 (Num 2))))
(run 4)

(check (= unrelated (Fired)))
(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; A multipattern and a slot side condition on one rule: eta, but only where the
;;; function is itself a lambda.
;;;
;;; The two kinds of fact do different work here, so each failing claim below fails
;;; a different one: `(= f (Lam $w g))` constrains the match's SHAPE, `(not-free $v f)`
;;; its SLOTS.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)
(rewrite (Lam $v (App f $v)) f
         :when ((not-free $v f)
                (= f (Lam $w g)))
         :name "eta-lam")

;; fun y. (fun z. z + z) y   ->   fun z. z + z
(let eta (Lam $0 (App (Lam $1 (Add $1 $1)) $0)))
(let reduced (Lam $1 (Add $1 $1)))
;; the function is not a lambda: the shape premise fails
(let notlam (Lam $0 (App (Num 5) $0)))
;; the function IS a lambda but mentions the bound slot: the side condition fails
(let held (Lam $0 (App (Lam $1 (Add $1 $0)) $0)))
(let inner (Lam $1 (Add $1 $0)))
(run 6)

(check (= eta reduced))
(fail (check (= notlam (Num 5))))
(fail (check (= held inner)))
(pop)
