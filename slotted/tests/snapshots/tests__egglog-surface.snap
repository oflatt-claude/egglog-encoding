;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; carrier U: RenamesToLeader_0, EclassGroup_0, Equated_0, ClassSlots_0
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(sort U)
(constructor SlottedVar_0 (i64) U)
(relation RenamesToLeader_0 (U Renaming U))
(relation Equated_0 (U Renaming U))
(function ClassSlots_0 (U) Renaming :merge (map-intersect old new))
(relation SubstPending_0 (U Renaming Renaming U))
(function ShapeEqual_0 (U Renaming U) Unit :no-merge)
(function Invocation_0 (U Renaming) U :merge ((union old new) old))
(function EclassGroup_0 (U) Group :merge (set-union old new))
(function GroupReplace_0 (U) Group :merge new)
(function CosetReps_0 (U Renaming) Renamings :merge new)
(relation BigReading_0 (U Renaming))
(relation Reading_0 (U Renaming Renaming))

(set (SlottedNodeLayout "SlottedVar_0" 1) ())
(set (ClassSlots_0 (SlottedVar_0 0)) (map-of 0 0))

(rule ((Equated_0 _a _m _b)
       (!= _a _b)
       (= _a (ordering-max _a _b))
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b)))
      ((RenamesToLeader_0 _a (compose _csa (compose _m _csb)) _b)) :ruleset slotted :name "slotted/orient-max/0")

(rule ((Equated_0 _a _m _b)
       (!= _a _b)
       (= _b (ordering-max _a _b))
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b)))
      ((RenamesToLeader_0 _b (compose _csb (compose (inverse _m) _csa)) _a)) :ruleset slotted :name "slotted/orient-min/0")

(rule ((Equated_0 _a _m _a)
       (= _cs (ClassSlots_0 _a)))
      ((set (EclassGroup_0 _a) (set-of (compose _cs (compose _m _cs))))) :ruleset slotted :name "slotted/self-symmetry/0")

(rule ((= _cs (ClassSlots_0 _c)))
      ((RenamesToLeader_0 _c _cs _c)
       (set (EclassGroup_0 _c) (set-of _cs))) :ruleset slotted :name "slotted/seed-identity/0")

(rule ((RenamesToLeader_0 _c _m _c)
       (= _cs (ClassSlots_0 _c))
       (!= _m _cs))
      ((set (EclassGroup_0 _c) (set-of (compose _cs (compose _m _cs))))
       (delete (RenamesToLeader_0 _c _m _c))) :ruleset slotted :name "slotted/self-edge-symmetry/0")

(rule ((RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _l (ordering-max _f _l)))
      ((delete (RenamesToLeader_0 _f _m _l))) :ruleset slotted :name "slotted/drop-stale-edge/0")

(rule ((RenamesToLeader_0 _a _m _b) (= _slots (ClassSlots_0 _a)))
      ((set (ClassSlots_0 _b) (map-image (compose (inverse _m) _slots))))
      :ruleset slotted :name "slotted/transport-down/0")
(rule ((RenamesToLeader_0 _a _m _b) (= _slots (ClassSlots_0 _b)))
      ((set (ClassSlots_0 _a) (map-image (compose _m _slots))))
      :ruleset slotted :name "slotted/transport-up/0")

(rule ((= _grp (EclassGroup_0 _c)) (= _slots (ClassSlots_0 _c)))
      ((set (ClassSlots_0 _c) (group-slot-closure _grp _slots)))
      :ruleset slotted :name "slotted/slot-closure/0")

(rule ((RenamesToLeader_0 _e1 _m12 _e2)
       (RenamesToLeader_0 _e2 _m23 _e3)
       (!= _e2 _e3))
      ((Equated_0 _e1 (compose _m12 _m23) _e3)) :ruleset slotted :name "slotted/transitivity/0")

(rule ((RenamesToLeader_0 _a _m1 _b)
       (RenamesToLeader_0 _a _m2 _c)
       (!= _a _c)
       (!= _a _b)
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b))
       (= _csc (ClassSlots_0 _c))
       (= _m1 (compose _csa (compose _m1 _csb)))
       (= _m2 (compose _csa (compose _m2 _csc)))
       (= (ordering-max _b _c) _b)
       (guard (or (bool-!= _b _c)
                  (and (bool= _b _c)
                       (bool-!= _m1 _m2)
                       (bool= (ordering-max _m1 _m2) _m1)))))
      ((delete (RenamesToLeader_0 _a _m1 _b))
       (Equated_0 _b (compose (inverse _m1) _m2) _c)) :ruleset slotted :name "slotted/one-leader/0")

(rule ((= _s (EclassGroup_0 _f))
       (> (set-length _s) 0)
       (RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete (EclassGroup_0 _f))
       (set (GroupReplace_0 _f) (set-empty))) :ruleset slotted-empty :name "slotted/group-empty/0")

(rule ((RenamesToLeader_0 _f _g _f)
       (RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete (RenamesToLeader_0 _f _g _f))) :ruleset slotted :name "slotted/drop-follower-identity/0")

(rule ((= _s (EclassGroup_0 _c))
       (= _cs (ClassSlots_0 _c))
       (= _s2 (group-close (group-restrict _s _cs)))
       (!= _s _s2))
      ((delete (EclassGroup_0 _c))
       (set (GroupReplace_0 _c) _s2)) :ruleset slotted-shrink :name "slotted/group-shrink/0")

(rule ((= _s2 (GroupReplace_0 _c)))
      ((set (EclassGroup_0 _c) _s2)
       (delete (GroupReplace_0 _c))) :ruleset slotted-restore :name "slotted/group-restore/0")

(rule ((RenamesToLeader_0 _f _m _l)
       (= _csf (ClassSlots_0 _f))
       (= _csl (ClassSlots_0 _l))
       (= _m2 (compose _csf (compose _m _csl)))
       (!= _m _m2))
      ((delete (RenamesToLeader_0 _f _m _l))
       (RenamesToLeader_0 _f _m2 _l)) :ruleset slotted :name "slotted/restate-edge/0")

(rule ((= _e (SlottedVar_0 _v))
       (!= _v 0))
      ((Equated_0 _e (map-insert (map-empty) 0 _v) (SlottedVar_0 0))
       (delete (SlottedVar_0 _v))) :ruleset slotted :name "slotted/var-normalize/0")

(RenamesToLeader_0 (SlottedVar_0 0) (map-insert (map-empty) 0 0) (SlottedVar_0 0))
(set (EclassGroup_0 (SlottedVar_0 0)) (set-of (map-insert (map-empty) 0 0)))

(rule ((RenamesToLeader_0 _a _m _c)
       (= _grp (EclassGroup_0 _c))
       (= _name (coset-min _m _grp)))
      ((set (Invocation_0 _c _name) _a)) :ruleset slotted :name "slotted/invocation/0")



(rule ((GroupIdxSmall _i)
       (= _s (CosetReps_0 _c _pinned))
       (= _g (vec-get _s _i)))
      ((Reading_0 _c _pinned _g)) :ruleset slotted-read :name "slotted/reading-small/0")

(rule ((= _s (CosetReps_0 _c _pinned))
       (> (vec-length _s) 8))
      ((BigReading_0 _c _pinned)) :ruleset slotted-read :name "slotted/reading-big-mark/0")

(rule ((BigReading_0 _c _pinned)
       (= _s (CosetReps_0 _c _pinned))
       (GroupIdx _i)
       (>= _i 8)
       (= _g (vec-get _s _i)))
      ((Reading_0 _c _pinned _g)) :ruleset slotted-read :name "slotted/reading-big/0")

(rule ((Reading_0 _c _pinned _g)
       (= _s (CosetReps_0 _c _pinned))
       (vec-not-contains _s _g))
      ((delete (Reading_0 _c _pinned _g))) :ruleset slotted-read :name "slotted/reading-cleanup/0")

(rule ((= _s (CosetReps_0 _c _pinned))
       (= _grp (EclassGroup_0 _c))
       (= _fresh (group-coset-reps _grp _pinned))
       (!= _s _fresh))
      ((set (CosetReps_0 _c _pinned) _fresh)) :ruleset slotted-read :name "slotted/coset-repair/0")

(rule ((= _s (CosetReps_0 _c _pinned))
       (> (vec-length _s) 512))
      ((panic "a class has more readings than GroupIdx indexes")) :ruleset slotted-read :name "slotted/coset-panic/0")

(rule ((ShapeEqual_0 _a _m _b))
      ((Equated_0 _a _m _b)) :ruleset slotted :name "slotted/shape-equal/0")

(rule ((SubstPending_0 _root _q _mr _r)
       (= _cs (ClassSlots_0 _r)))
      ((Equated_0 _root (compose _q (compose _mr _cs)) _r))
      :ruleset slotted :name "slotted/subst-answer/0")

(constructor Null () U)
(set (SlottedNodeLayout "Null" 0) ())
(rule ((= _e1 (Null))) ((set (ClassSlots_0 _e1) (map-empty))) :name "slotted/class-slots/Null" :ruleset slotted)
(constructor Succ (Renaming U) U)
(set (SlottedEdgeLayout "Succ" 0) ())
(set (SlottedNodeLayout "Succ" 2) ())
(rule ((= _e1 (Succ _m1 _c1))) ((set (ClassSlots_0 _e1) (map-image _m1))) :name "slotted/class-slots/Succ" :ruleset slotted)
(function _pinned_Succ (Renaming U i64) Renaming :merge new)
(function _shape_Succ (Renaming U) (U Renaming) :merge ((set (ShapeEqual_0 old0 (compose old1 (inverse new1)) new0) ()) (values old0 old1)))
(function _shapeof_Succ (Renaming Group) (Renaming Renaming Group) :no-merge)
(rule ((= _c (Succ _m1 _c1)) (= _g1 (EclassGroup_0 _c1)) (= _sh (node-shape (vec-of _m1) (vec-of _g1)))) ((set (_shape_Succ (vec-get _sh 0) _c1) (values _c (vec-get _sh 1))) (set (_shapeof_Succ _m1 _g1) (values (vec-get _sh 0) (vec-get _sh 1) (symmetries-of _sh 2)))) :ruleset slotted-shape :name "slotted/shape-index/Succ")
(rule ((= _c (Succ _m1 _c1)) (= _g1 (EclassGroup_0 _c1)) (= (values _s1 _back _syms) (_shapeof_Succ _m1 _g1)) (= _cs (ClassSlots_0 _c))) ((set (EclassGroup_0 _c) (group-restrict _syms _cs))) :ruleset slotted-group :name "slotted/node-symmetry/Succ")
