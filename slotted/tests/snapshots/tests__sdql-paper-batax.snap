;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; carrier U: RenamesToLeader_0, EclassGroup_0, Equated_0, ClassSlots_0
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(sort U)
(constructor SlottedVar_0 (i64) U)
(relation RenamesToLeader_0 (U Renaming U))
(relation Equated_0 (U Renaming U))
(function ClassSlots_0 (U) Renaming :merge (map-intersect old new))
(relation SubstPending_0 (U Renaming Renaming U))
(function ShapeEqual_0 (U Renaming U) Unit :no-merge)
(function Invocation_0 (U Renaming) U :merge ((union old new) old))
(function EclassGroup_0 (U) Group :merge (set-union old new))
(function GroupReplace_0 (U) Group :merge new)
(function CosetReps_0 (U Renaming) Group :merge new)
(relation BigReading_0 (U Renaming))
(relation Reading_0 (U Renaming Renaming))

(set (SlottedNodeLayout "SlottedVar_0" 1) ())

(rule ((Equated_0 _a _m _b)
       (!= _a _b)
       (= _a (ordering-max _a _b))
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b)))
      ((RenamesToLeader_0 _a (compose _csa (compose _m _csb)) _b)) :ruleset slotted)

(rule ((Equated_0 _a _m _b)
       (!= _a _b)
       (= _b (ordering-max _a _b))
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b)))
      ((RenamesToLeader_0 _b (compose _csb (compose (inverse _m) _csa)) _a)) :ruleset slotted)

(rule ((Equated_0 _a _m _a)
       (= _cs (ClassSlots_0 _a)))
      ((set (EclassGroup_0 _a) (set-of (compose _cs (compose _m _cs))))) :ruleset slotted)

(rule ((= _cs (ClassSlots_0 _c)))
      ((RenamesToLeader_0 _c _cs _c)
       (set (EclassGroup_0 _c) (set-of _cs))) :ruleset slotted)

(rule ((RenamesToLeader_0 _c _m _c)
       (= _cs (ClassSlots_0 _c))
       (!= _m _cs))
      ((set (EclassGroup_0 _c) (set-of (compose _cs (compose _m _cs))))
       (delete (RenamesToLeader_0 _c _m _c))) :ruleset slotted)

(rule ((RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _l (ordering-max _f _l)))
      ((delete (RenamesToLeader_0 _f _m _l))) :ruleset slotted)

(rule ((RenamesToLeader_0 _a _m _b) (= _slots (ClassSlots_0 _a)))
      ((set (ClassSlots_0 _b) (map-image (compose (inverse _m) _slots))))
      :ruleset slotted)
(rule ((RenamesToLeader_0 _a _m _b) (= _slots (ClassSlots_0 _b)))
      ((set (ClassSlots_0 _a) (map-image (compose _m _slots))))
      :ruleset slotted)

(rule ((= _grp (EclassGroup_0 _c)) (= _slots (ClassSlots_0 _c)))
      ((set (ClassSlots_0 _c) (group-slot-closure _grp _slots)))
      :ruleset slotted)

(rule ((RenamesToLeader_0 _e1 _m12 _e2)
       (RenamesToLeader_0 _e2 _m23 _e3)
       (!= _e2 _e3))
      ((Equated_0 _e1 (compose _m12 _m23) _e3)) :ruleset slotted)

(rule ((RenamesToLeader_0 _a _m1 _b)
       (RenamesToLeader_0 _a _m2 _c)
       (!= _a _c)
       (!= _a _b)
       (= _csa (ClassSlots_0 _a))
       (= _csb (ClassSlots_0 _b))
       (= _csc (ClassSlots_0 _c))
       (= _m1 (compose _csa (compose _m1 _csb)))
       (= _m2 (compose _csa (compose _m2 _csc)))
       (= (ordering-max _b _c) _b)
       (guard (or (bool-!= _b _c)
                  (and (bool= _b _c)
                       (bool-!= _m1 _m2)
                       (bool= (ordering-max _m1 _m2) _m1)))))
      ((delete (RenamesToLeader_0 _a _m1 _b))
       (Equated_0 _b (compose (inverse _m1) _m2) _c)) :ruleset slotted)

(rule ((= _s (EclassGroup_0 _f))
       (> (set-length _s) 0)
       (RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete (EclassGroup_0 _f))
       (set (GroupReplace_0 _f) (set-empty))) :ruleset slotted-empty)

(rule ((RenamesToLeader_0 _f _g _f)
       (RenamesToLeader_0 _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete (RenamesToLeader_0 _f _g _f))) :ruleset slotted)

(rule ((= _s (EclassGroup_0 _c))
       (= _cs (ClassSlots_0 _c))
       (= _s2 (group-close (group-restrict _s _cs)))
       (!= _s _s2))
      ((delete (EclassGroup_0 _c))
       (set (GroupReplace_0 _c) _s2)) :ruleset slotted-shrink)

(rule ((= _s2 (GroupReplace_0 _c)))
      ((set (EclassGroup_0 _c) _s2)
       (delete (GroupReplace_0 _c))) :ruleset slotted-restore)

(rule ((RenamesToLeader_0 _f _m _l)
       (= _csf (ClassSlots_0 _f))
       (= _csl (ClassSlots_0 _l))
       (= _m2 (compose _csf (compose _m _csl)))
       (!= _m _m2))
      ((delete (RenamesToLeader_0 _f _m _l))
       (RenamesToLeader_0 _f _m2 _l)) :ruleset slotted)

(rule ((= _e (SlottedVar_0 _v))
       (!= _v 0))
      ((Equated_0 _e (map-insert (map-empty) 0 _v) (SlottedVar_0 0))
       (delete (SlottedVar_0 _v))) :ruleset slotted)


(rule ((RenamesToLeader_0 _a _m _c)
       (= _grp (EclassGroup_0 _c))
       (= _name (coset-min _m _grp)))
      ((set (Invocation_0 _c _name) _a)) :ruleset slotted)

(rule ((GroupIdxSmall _i)
       (= _s (CosetReps_0 _c _pinned))
       (= _g (set-get _s _i)))
      ((Reading_0 _c _pinned _g)) :ruleset slotted-read)

(rule ((= _s (CosetReps_0 _c _pinned))
       (> (set-length _s) 8))
      ((BigReading_0 _c _pinned)) :ruleset slotted-read)

(rule ((BigReading_0 _c _pinned)
       (= _s (CosetReps_0 _c _pinned))
       (GroupIdx _i)
       (>= _i 8)
       (= _g (set-get _s _i)))
      ((Reading_0 _c _pinned _g)) :ruleset slotted-read)

(rule ((Reading_0 _c _pinned _g)
       (= _s (CosetReps_0 _c _pinned))
       (set-not-contains _s _g))
      ((delete (Reading_0 _c _pinned _g))) :ruleset slotted-read)

(rule ((= _s (CosetReps_0 _c _pinned))
       (= _grp (EclassGroup_0 _c))
       (= _fresh (group-coset-reps _grp _pinned))
       (!= _s _fresh))
      ((set (CosetReps_0 _c _pinned) _fresh)) :ruleset slotted-read)

(rule ((= _s (CosetReps_0 _c _pinned))
       (> (set-length _s) 512))
      ((panic "a class has more readings than GroupIdx indexes")) :ruleset slotted-read)

(rule ((ShapeEqual_0 _a _m _b))
      ((Equated_0 _a _m _b)) :ruleset slotted)

(rule ((SubstPending_0 _root _q _mr _r)
       (= _cs (ClassSlots_0 _r)))
      ((Equated_0 _root (compose _q (compose _mr _cs)) _r))
      :ruleset slotted)

(set (SlottedVariableSort "U") ())
(set (ClassSlots_0 (SlottedVar_0 0)) (map-of 0 0))
(RenamesToLeader_0 (SlottedVar_0 0) (map-insert (map-empty) 0 0) (SlottedVar_0 0))
(set (EclassGroup_0 (SlottedVar_0 0)) (set-of (map-insert (map-empty) 0 0)))
(constructor Lambda (Renaming U Renaming U) U)
(set (SlottedEdgeLayout "Lambda" 0) ())
(set (SlottedEdgeLayout "Lambda" 2) ())
(set (SlottedNodeLayout "Lambda" 4) ())
(set (SlottedBinderLayout "Lambda" 0 2 -1 "") ())
(rule ((= _e1 (Lambda _m1 _c1 _m2 _c2))) ((set (ClassSlots_0 _e1) (map-union (map-image _m1) (map-image _m2)))) :ruleset slotted)
(function _shape_Lambda (Renaming U Renaming U) (U Renaming) :merge ((set (ShapeEqual_0 old0 (compose old1 (inverse new1)) new0) ()) (values old0 old1)))
(function _shapeof_Lambda (Renaming Group Renaming Group) (Renaming Renaming Renaming Group) :no-merge)
(function _pinned_Lambda (Renaming U Renaming U i64) Renaming :merge new)
(rule ((= _c (Lambda _m1 _c1 _m2 _c2)) (= _g1 (EclassGroup_0 _c1)) (= _g2 (EclassGroup_0 _c2)) (= _sh (node-shape (vec-of _m1 _m2) (vec-of _g1 _g2)))) ((set (_shape_Lambda (vec-get _sh 0) _c1 (vec-get _sh 1) _c2) (values _c (vec-get _sh 2))) (set (_shapeof_Lambda _m1 _g1 _m2 _g2) (values (vec-get _sh 0) (vec-get _sh 1) (vec-get _sh 2) (symmetries-of _sh 3)))) :ruleset slotted-shape)
(rule ((= _c (Lambda _m1 _c1 _m2 _c2)) (= _g1 (EclassGroup_0 _c1)) (= _g2 (EclassGroup_0 _c2)) (= (values _s1 _s2 _back _syms) (_shapeof_Lambda _m1 _g1 _m2 _g2)) (= _cs (ClassSlots_0 _c))) ((set (EclassGroup_0 _c) (group-restrict _syms _cs))) :ruleset slotted-group)
(rule ((= _c (Lambda _m1 _c1 _m2 _c2)) (= _g1 (EclassGroup_0 _c1)) (= _g2 (EclassGroup_0 _c2)) (= (values _s1 _s2 _b1 _syms1) (_shapeof_Lambda _m1 _g1 _m2 _g2)) (= _c (Lambda _n1 _c1 _n2 _c2)) (= (values _s1 _s2 _b2 _syms2) (_shapeof_Lambda _n1 _g1 _n2 _g2)) (= _v1 (vec-of _m1 _m2)) (= _v2 (vec-of _n1 _n2)) (!= _v1 _v2) (= _v1 (ordering-max _v1 _v2))) ((delete (Lambda _m1 _c1 _m2 _c2))) :ruleset slotted-shape)
