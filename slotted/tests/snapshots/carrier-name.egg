;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; multi-sort slotted machinery
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(ruleset slotted)

(function SlottedNodeLayout (String i64) Unit :no-merge :internal-hidden)
(function SlottedEdgeLayout (String i64) Unit :no-merge :internal-hidden)
(function SlottedBinderLayout (String i64 i64 i64 String) Unit :no-merge :internal-hidden)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; carrier U: RenamesToLeader, Equated, ClassSlots
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(sort U)
(constructor Var (i64) U)
(relation RenamesToLeader (U Renaming U))
(relation Equated (U Renaming U))
(function ClassSlots (U) Renaming :merge (map-intersect old new))
(relation SubstPending (U Renaming Renaming U))

(set (SlottedNodeLayout "Var" 1) ())
(set (ClassSlots (Var 0)) (map-of 0 0))

(rule ((Equated a m b)
       (!= a b)
       (= a (ordering-max a b)))
      ((RenamesToLeader a m b)) :ruleset slotted)

(rule ((Equated a m b)
       (!= a b)
       (= b (ordering-max a b)))
      ((RenamesToLeader b (inverse m) a)) :ruleset slotted)

(rule ((Equated a m a))
      ((RenamesToLeader a m a)) :ruleset slotted)

(rule ((RenamesToLeader f m l)
       (!= f l)
       (= l (ordering-max f l)))
      ((delete (RenamesToLeader f m l))) :ruleset slotted)

(rule ((RenamesToLeader a m b) (= slots (ClassSlots a)))
      ((set (ClassSlots b) (map-image (compose (inverse m) slots))))
      :ruleset slotted)
(rule ((RenamesToLeader a m b) (= slots (ClassSlots b)))
      ((set (ClassSlots a) (map-image (compose m slots))))
      :ruleset slotted)

(rule ((RenamesToLeader e1 m12 e2)
       (RenamesToLeader e2 m23 e3)
       (guard (or (bool-!= e2 e3)
                  (bool= (compose m23 m23) m23)
                  (bool= e1 e3))))
      ((Equated e1 (compose m12 m23) e3)) :ruleset slotted)

(rule ((RenamesToLeader a m1 b)
       (RenamesToLeader a m2 c)
       (!= a c)
       (!= a b)
       (= (ordering-max b c) b)
       (guard (or (bool-!= b c)
                  (and (bool= b c)
                       (bool-!= m1 m2)
                       (bool= (ordering-max m1 m2) m1)))))
      ((delete (RenamesToLeader a m1 b))
       (Equated b (compose (inverse m1) m2) c)) :ruleset slotted)

(rule ((RenamesToLeader a m1 a)
       (RenamesToLeader a m a)
       (= m (compose m m))
       (= m2 (compose m (compose m1 m)))
       (!= m1 m2))
      ((delete (RenamesToLeader a m1 a))
       (RenamesToLeader a m2 a)) :ruleset slotted)

(rule ((= e (Var v))
       (!= v 0))
      ((Equated e (map-insert (map-empty) 0 v) (Var 0))
       (delete (Var v))) :ruleset slotted)

(RenamesToLeader (Var 0) (map-insert (map-empty) 0 0) (Var 0))

(rule ((RenamesToLeader a m1_o c)
       (RenamesToLeader b m2 c)
       (RenamesToLeader c sym c)
       (= m1 (compose m1_o sym))
       (= m (compose m1 (inverse m2)))
       (= (compose m m) m))
      ((union a b)) :ruleset slotted)

(rule ((SubstPending root q mr r)
       (= cs (ClassSlots r)))
      ((Equated root (compose q (compose mr cs)) r))
      :ruleset slotted)


(push)
(rule ((= V2 (Prev p1 C3))
       (= dom4 (map-image p1))
       (= mp5 dom4)
       (= idm6 (map-image mp5))
       (= m7 (compose mp5 p1))
       (= cs8 (ClassSlots C3))
       (= cs9 (ClassSlots V2))
       (= C3 (Succ p10 C12))
       (= dom13 (map-image p10))
       (RenamesToLeader C3 sym14 C3)
       (= mp15 (find-mapping-total idm6 dom13 (compose (compose m7 cs8) sym14) (map-domain (compose m7 cs8))))
       (= idm16 (map-image mp15))
       (= av17 (map-union idm6 idm16))
       (= m18 (compose mp15 p10))
       (= cs19 (ClassSlots C12))
       (= carr20 (map-union (map-image (compose m18 cs19)) (map-union (map-image (compose mp5 cs9)) (map-image (compose m7 cs8)))))
       (= alts21 (refine-namings carr20 (map-empty) idm6 idm16))
       (Idx ix22)
       (= mrg23 (vec-get alts21 ix22)))
      ((Equated V2 (compose (inverse (compose mrg23 (compose mp5 cs9))) (compose mrg23 (compose m18 cs19))) C12)) :name "peel")
(let $one (Prev (map-empty) (Succ (map-empty) (Null))))
(run-schedule (saturate (run slotted))
              (repeat 5 (seq (run) (saturate (run slotted)))))
(check (= _c0V2 (Succ _c0p1 _c0L3))
       (RenamesToLeader (Null) _c0ml4 _c0L3)
       (= _c0dom5 (map-image _c0p1))
       (= _c0mp6 _c0dom5)
       (= _c0idm7 (map-image _c0mp6))
       (= _c0cs8 (ClassSlots _c0V2))
       (= _c0V10 (Prev _c0p9 _c0V2))
       (= _c0dom12 (map-image _c0p9))
       (RenamesToLeader _c0V2 _c0sym13 _c0V2)
       (= _c0mp14 (find-mapping-total _c0idm7 _c0dom12 (compose (compose _c0mp6 _c0cs8) _c0sym13) _c0p9))
       (= _c0idm15 (map-image _c0mp14))
       (= _c0av16 (map-union _c0idm7 _c0idm15))
       (= _c0cs17 (ClassSlots _c0V10))
       (= _c1V1 (Null))
       (= _c1dom2 (map-empty))
       (= _c1mp3 _c1dom2)
       (= _c1idm4 (map-image _c1mp3))
       (= _c1cs5 (ClassSlots _c1V1))
       (= _c0V10 _c1V1)
       (RenamesToLeader _c0V10 _gsym _c0V10)
       (= (compose (map-empty) (compose _c0mp14 _c0cs17)) (compose (compose (map-empty) (compose _c1mp3 _c1cs5)) _gsym)))
(pop)
(push)
(let $id0 (Lam (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)))
(let $id5 (Lam (map-of 0 5) (Var 0) (map-of 0 5) (Var 0)))
(run-schedule (saturate (run slotted)))
(check (= _c0V3 (Lam _c0p1 (Var 0) _c0p2 (Var 0)))
       (= _c0dom4 (map-union (map-image _c0p1) (map-image _c0p2)))
       (= _c0mp5 _c0dom4)
       (= _c0idm6 (map-image _c0mp5))
       (= _c0s_b1 (map-get (compose _c0mp5 _c0p1) 0))
       (= _c0s_b1 (map-get (compose _c0mp5 _c0p2) 0))
       (= _c0cs7 (ClassSlots _c0V3))
       (= _c1V3 (Lam _c1p1 (Var 0) _c1p2 (Var 0)))
       (= _c1dom4 (map-union (map-image _c1p1) (map-image _c1p2)))
       (= _c1mp5 _c1dom4)
       (= _c1idm6 (map-image _c1mp5))
       (= _c1s_b1 (map-get (compose _c1mp5 _c1p1) 0))
       (= _c1s_b1 (map-get (compose _c1mp5 _c1p2) 0))
       (= _c1cs7 (ClassSlots _c1V3))
       (= _c0V3 _c1V3)
       (RenamesToLeader _c0V3 _gsym _c0V3)
       (= (compose (map-empty) (compose _c0mp5 _c0cs7)) (compose (compose (map-empty) (compose _c1mp5 _c1cs7)) _gsym)))
(check (= _c0V3 (Lam _c0p1 (Var 0) _c0p2 (Var 0)))
       (= _c0dom4 (map-union (map-image _c0p1) (map-image _c0p2)))
       (= _c0mp5 _c0dom4)
       (= _c0idm6 (map-image _c0mp5))
       (= _c0s_b1 (map-get (compose _c0mp5 _c0p1) 0))
       (= _c0s_b1 (map-get (compose _c0mp5 _c0p2) 0))
       (= _c0cs7 (ClassSlots _c0V3))
       (= (map-image (compose (map-empty) (compose _c0mp5 _c0cs7))) (map-empty)))
(pop)
