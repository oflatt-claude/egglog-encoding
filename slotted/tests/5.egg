; NOTE: This test would also fail in slotted-egraphs.
; In slotted-egraphs it fails as revisiting a redundant variable would allocate a fresh slot for it.
; Why does it fail here though? For some reason using (Var 0) instead of (Var 3) in $sub33 makes this work.

(rewrite
    (App2 "f"
        (App2 "sub" x x)
        (App2 "sub" x x)
    )
    (App2 "h" (Null) (Null))
)

(let $sub33 (App2 "sub" (Var 3) (Var 3)))
(let $zero (Null))
(union $sub33 $zero) ; This makes x redundant in x-x.

(let $x (App2 "f"
    (App2 "sub" (Var 0) (Var 0))
    (App2 "sub" (Var 1) (Var 1))
    ))
; after redundancies, this should match the rule above.

(let $y (App2 "h" (Null) (Null)))

(run 10)

(check (= $x $y))
