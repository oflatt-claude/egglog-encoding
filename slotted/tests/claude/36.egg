; Redundant slots should be canonical in the stored node.  Def. 7 makes the
; shape lexicographically minimal, so after sub(v,v) loses its slot the node
; should read (App2 "sub" (map-of 0 0) (Var 0) (map-of 0 0) (Var 0)) whichever
; invocation established the redundancy.  Today it keeps the name it happened to
; have, so 34/35 and Rudi's 4/5 disagree on a pure renaming.
;
; User-visible form: the answer must not depend on which invocation was unioned.

(rewrite
    (App2 "f" (App2 "sub" x x) (App2 "sub" x x))
    (App2 "h" (Null) (Null))
)

(let $s9 (App2 "sub" (Var 9) (Var 9)))
(let $z (Null))
(union $s9 $z)

; every invocation of sub(v,v) is now the same slotless class
(let $s0 (App2 "sub" (Var 0) (Var 0)))
(let $s1 (App2 "sub" (Var 1) (Var 1)))

(run 20)

(check (= $s0 $z))
(check (= $s0 $s1))

; ... so f(sub($0,$0), sub($1,$1)) is f applied to that class twice, and the
; rule's two occurrences of x are the same renamed id.
(let $w (App2 "f" (App2 "sub" (Var 0) (Var 0)) (App2 "sub" (Var 1) (Var 1))))
(let $h (App2 "h" (Null) (Null)))

(run 20)

(check (= $w $h))
