; Control for 34: identical except the redundancy is established at (Var 9)
; instead of (Var 0).  Passes today, while 34 does not -- which is the bug.

(rewrite
    (App2 "f" (App2 "sub" x x) (App2 "sub" x x))
    x
)

(let $s (App2 "sub" (Var 9) (Var 9)))
(let $z (Null))
(union $s $z)

(let $w (App2 "f" (App2 "sub" (Var 0) (Var 0)) (App2 "sub" (Var 1) (Var 1))))

(let $k5 (App2 "k" (Var 5) (Null)))
(let $k6 (App2 "k" (Var 6) (Null)))

(run 20)

(fail (check (= $k5 $k6)))
