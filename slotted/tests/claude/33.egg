; Matching a class that has *two* redundant slots (paper Def. 8: a redundant
; slot stands for infinitely many e-nodes, so the match picks fresh slots for
; them).  After mul($7,$8) = 0 the class 0 also contains mul($x,$y) for every
; pair, so commutativity must yield swp($y,$x) = 0 for every pair too.

(rewrite
    (App2 "mul" x y)
    (App2 "swp" y x)
)

(let $m (App2 "mul" (Var 7) (Var 8)))
(let $z (Null))
(union $m $z)

(let $s12 (App2 "swp" (Var 1) (Var 2)))
(let $s21 (App2 "swp" (Var 2) (Var 1)))
(let $k    (App2 "k" (Var 1) (Var 2)))

(run 30)

(check (= $s12 $z))
(check (= $s12 $s21))
(fail (check (= $k $z)))
