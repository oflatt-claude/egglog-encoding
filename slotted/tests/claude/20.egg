; Nested binders and capture avoidance.
; $a/$b are the same closed term under different bound names.  $c swaps the two
; bound occurrences and is a genuinely different term.
; $p and $q are alpha-variants of each other with the *free* slot renamed --
; renaming $q's binder to $0 would capture, so they must not be equal, only
; equal up to renaming.

(let $a (App2 "lambda" (Var 0) (App2 "lambda" (Var 1) (App2 "f" (Var 0) (Var 1)))))
(let $b (App2 "lambda" (Var 7) (App2 "lambda" (Var 8) (App2 "f" (Var 7) (Var 8)))))
(let $c (App2 "lambda" (Var 0) (App2 "lambda" (Var 1) (App2 "f" (Var 1) (Var 0)))))

(let $p (App2 "lambda" (Var 0) (App2 "f" (Var 0) (Var 3))))
(let $q (App2 "lambda" (Var 3) (App2 "f" (Var 3) (Var 0))))

(run 25)

(check (= $a $b))
(fail (check (= $a $c)))
(fail (check (= $p $q)))
(check (RenamesToLeader $p m1 l) (RenamesToLeader $q m2 l))
