; App1 is part of the user-facing signature but the compiled machinery only
; covers App2.  Every constructor arity needs its own alpha-finder, self-loop,
; migration and per-position child-update rules -- the point of an automatic
; encoding pass is that these are generated, not hand-written per arity.

(rewrite
    (App1 "neg" (App1 "neg" x))
    x
)

(let $a (App1 "neg" (Var 3)))
(let $b (App1 "neg" (Var 4)))
(let $c (App1 "neg" (App1 "neg" (Var 3))))
(let $d (Var 3))
(let $e (App1 "neg" (App1 "neg" (Var 4))))

(run 20)

(fail (check (= $a $b)))
(check (RenamesToLeader $a m1 l) (RenamesToLeader $b m2 l))
(check (= $c $d))
(fail (check (= $c $e)))
