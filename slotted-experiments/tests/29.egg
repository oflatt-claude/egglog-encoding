; Terms written inline in `union` and `check`, not only in `let`.  These are
; passed through unencoded today, so they reach egglog with the user arity.
; Currently: Arity mismatch, expected 5 args.

(union (App2 "f" (Var 1) (Var 2)) (App2 "g" (Var 2) (Var 1)))

(let $a (App2 "f" (Var 1) (Var 2)))

(run 20)

(check (= $a (App2 "g" (Var 2) (Var 1))))
(fail (check (= $a (App2 "g" (Var 1) (Var 2)))))
