; A let that refers to an earlier let.  $a already has a slot list of its own,
; so the edge from "g" to $a is that identity -- the encoder has to remember
; each global's slots rather than only handling literal subterms.
; Currently: transform_rhs: what is $a?

(let $a (App2 "f" (Var 1) (Var 2)))
(let $b (App2 "g" $a (Null)))
(let $c (App2 "g" (App2 "f" (Var 1) (Var 2)) (Null)))
(let $d (App2 "g" (App2 "f" (Var 2) (Var 1)) (Null)))

(run 20)

(check (= $b $c))
(fail (check (= $b $d)))
