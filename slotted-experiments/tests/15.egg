; A rule variable repeated in one pattern binds a *renamed id*, so the two
; occurrences only have to agree up to a symmetry of the child (paper Def. 6).
; a is symmetric, so f(a[$0,$1], a[$1,$0]) matches f(x,x) even though the two
; stored edges are different.  Matching on e-class identity alone would be
; unsound here; matching on edge equality would miss it.

(rewrite
    (App2 "f" x x)
    x
)

(let $a01 (App2 "a" (Var 0) (Var 1)))
(let $a10 (App2 "a" (Var 1) (Var 0)))
(union $a01 $a10)

(let $t (App2 "f" (App2 "a" (Var 0) (Var 1)) (App2 "a" (Var 1) (Var 0))))
(let $s (App2 "f" (App2 "a" (Var 0) (Var 1)) (App2 "a" (Var 0) (Var 2))))

(run 25)

(check (= $t $a01))
(fail (check (= $s $a01)))
