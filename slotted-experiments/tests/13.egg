; Two merges of the same pair at different invocations generate a symmetry
; (paper 3.5, step 2), which then has to reach the parent by congruence.

(let $f12 (App2 "f" (Var 1) (Var 2)))
(let $g12 (App2 "g" (Var 1) (Var 2)))
(let $g21 (App2 "g" (Var 2) (Var 1)))
(union $f12 $g12)
(union $f12 $g21)

(let $f21 (App2 "f" (Var 2) (Var 1)))
(let $f13 (App2 "f" (Var 1) (Var 3)))
(let $p1 (App2 "h" (App2 "f" (Var 1) (Var 2)) (Null)))
(let $p2 (App2 "h" (App2 "f" (Var 2) (Var 1)) (Null)))

(run 20)

(check (= $f12 $f21))
(check (= $g12 $g21))
(check (= $p1 $p2))
(fail (check (= $f12 $f13)))
