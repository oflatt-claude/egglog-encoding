; Redundancy has to be closed under the permutation group (paper 3.5, step 1:
; "if you can swap $x with $y by a symmetry, then if $x is redundant also $y").
; f is made symmetric, then equated with a one-slot term: slot 1 goes redundant,
; the orbit drags slot 0 with it, and the merged class ends up with no slots.

(let $f01 (App2 "f" (Var 0) (Var 1)))
(let $f10 (App2 "f" (Var 1) (Var 0)))
(union $f01 $f10)

(let $g0 (App2 "g" (Var 0) (Null)))
(union $f01 $g0)

(let $g5 (App2 "g" (Var 5) (Null)))
(let $f78 (App2 "f" (Var 7) (Var 8)))
(let $n (Null))

(run 20)

(check (= $g0 $g5))
(check (= $f01 $f78))
(fail (check (= $f01 $n)))
