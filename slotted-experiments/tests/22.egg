; A rule whose pattern is itself a binder, and whose action rebuilds two copies
; of that binder around the matched subterms: lambda(v, pair(a,b)) becomes
; pair(lambda(v,a), lambda(v,b)).  On the right, $4 is not under the binder, so
; lambda($5, $4) is the same term as lambda($0, $4).

(rewrite
    (App2 "lambda" v (App2 "pair" a b))
    (App2 "pair" (App2 "lambda" v a) (App2 "lambda" v b))
)

(let $l (App2 "lambda" (Var 0) (App2 "pair" (App2 "f" (Var 0) (Var 3)) (Var 4))))

(let $r (App2 "pair" (App2 "lambda" (Var 0) (App2 "f" (Var 0) (Var 3)))
                     (App2 "lambda" (Var 5) (Var 4))))

(let $w (App2 "pair" (App2 "lambda" (Var 0) (App2 "f" (Var 3) (Var 0)))
                     (App2 "lambda" (Var 5) (Var 4))))

(run 25)

(check (= $l $r))
(fail (check (= $l $w)))
