; Rules reach under a binder by congruence: rewriting the body of a lambda has
; to keep the binding, and the result is still identified up to alpha.
; The second pair also drops the bound slot: lambda(x, mul(x,0)) = lambda(x, 0).

(rewrite
    (App2 "f" x y)
    (App2 "f" y x)
)

(rewrite
    (App2 "mul" x (Null))
    (Null)
)

(let $a (App2 "lambda" (Var 0) (App2 "f" (Var 0) (Var 3))))
(let $b (App2 "lambda" (Var 0) (App2 "f" (Var 3) (Var 0))))
(let $c (App2 "lambda" (Var 7) (App2 "f" (Var 3) (Var 7))))

(let $m (App2 "lambda" (Var 0) (App2 "mul" (Var 0) (Null))))
(let $z (App2 "lambda" (Var 0) (Null)))
(let $n (Null))

(run 25)

(check (= $a $b))
(check (= $a $c))
(check (= $m $z))
(fail (check (= $m $n)))
