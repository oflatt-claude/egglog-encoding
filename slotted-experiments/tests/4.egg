(rewrite
    (App2 "f"
        (App2 "sub" x x)
        (App2 "sub" x x)
    )
    (App2 "h" (Null) (Null))
)

(let $sub00 (App2 "sub" (Var 0) (Var 0)))
(let $zero (Null))
(union $sub00 $zero) ; This makes x redundant in x-x.

(let $x (App2 "f"
    (App2 "sub" (Var 0) (Var 0))
    (App2 "sub" (Var 1) (Var 1))
    ))
; after redundancies, this should match the rule above.

(let $y (App2 "h" (Null) (Null)))

(run 10)

(check (= $x $y))
