(rewrite
    (App2 "h"
        (App2 "f" x y)
        (App2 "f" y x)
    )
    (Null)
)

(let $a (App2 "f" (Var 1) (Var 2)))
(let $b (App2 "f" (Var 2) (Var 1)))
(union $a $b)

(let $c (App2 "h"
    (App2 "f" (Var 7) (Var 8))
    (App2 "f" (Var 7) (Var 8))
    ))

(let $d (Null))

(run 10)

(check (= $c $d))
