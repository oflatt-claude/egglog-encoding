; Lambdas: (App2 "lambda" (Var v) body) binds slot v in body, so v must not
; appear among the e-class's free slots.  All identity lambdas collapse; all
; constant lambdas with the same free slot collapse; a different free slot is
; only equal up to renaming.

(let $i0 (App2 "lambda" (Var 0) (Var 0)))
(let $i5 (App2 "lambda" (Var 5) (Var 5)))

(let $k3a (App2 "lambda" (Var 0) (Var 3)))
(let $k3b (App2 "lambda" (Var 5) (Var 3)))
(let $k4  (App2 "lambda" (Var 0) (Var 4)))

(run 20)

(check (= $i0 $i5))
(check (= $k3a $k3b))
(fail (check (= $k3a $k4)))
(check (RenamesToLeader $k3a m1 l) (RenamesToLeader $k4 m2 l))
(fail (check (= $i0 $k3a)))
