; A commutativity rewrite turns into a symmetry of f's e-class, and congruence
; must carry that symmetry up to the parent: g(f($1,$2)) = g(f($2,$1)).

(rewrite
    (App2 "f" x y)
    (App2 "f" y x)
)

(let $a (App2 "g" (App2 "f" (Var 1) (Var 2)) (Null)))
(let $b (App2 "g" (App2 "f" (Var 2) (Var 1)) (Null)))
(let $c (App2 "g" (App2 "f" (Var 1) (Var 3)) (Null)))

(run 20)

(check (= $a $b))
(fail (check (= $a $c)))
