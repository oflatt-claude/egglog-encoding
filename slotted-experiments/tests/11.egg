; Unioning two invocations of one class whose slot sets differ makes every slot
; redundant (slotted-egraphs' own xy_eq_yz_causes_redundancy test).
; f($0,$1) = f($1,$2) leaves f with no slots at all -- but f is still not (Null).

(let $a (App2 "f" (Var 0) (Var 1)))
(let $b (App2 "f" (Var 1) (Var 2)))
(union $a $b)

(let $c (App2 "f" (Var 7) (Var 8)))
(let $n (Null))

; a parent of a slotless class must not keep pretending it has those slots
(let $p1 (App2 "q" (App2 "f" (Var 0) (Var 1)) (Var 5)))
(let $p2 (App2 "q" (App2 "f" (Var 2) (Var 3)) (Var 5)))
(let $p3 (App2 "q" (App2 "f" (Var 0) (Var 1)) (Var 6)))

(run 20)

(check (= $a $c))
(fail (check (= $a $n)))
(check (= $p1 $p2))
(fail (check (= $p1 $p3)))
