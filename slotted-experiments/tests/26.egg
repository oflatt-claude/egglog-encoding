; A conjunctive rule body.  Only the first atom's node fixes slots(pattern);
; the second atom has to solve for the paper's mp' through the variables the
; two atoms share, and the candidate mp' are enumerated by the shared children's
; symmetries (find-mapping).  Written in egglog rule syntax because `rewrite`
; is single-rooted.
;
;   (a) positive, mp' = identity
;   (b) negative: g's children are one renamed id and f's are two, so no
;       injective mp' exists
;   (c) mp' only exists via a symmetry of the shared child a

(rule ((= p (App2 "f" x y))
       (= q (App2 "g" x y)))
      ((union p q)))

(let $p  (App2 "f" (Var 0) (Var 1)))
(let $q  (App2 "g" (Var 0) (Var 1)))
(let $q2 (App2 "g" (Var 0) (Var 0)))

(let $a01 (App2 "a" (Var 0) (Var 1)))
(let $a10 (App2 "a" (Var 1) (Var 0)))
(union $a01 $a10)

(let $p3 (App2 "f" (App2 "a" (Var 0) (Var 1)) (Var 0)))
(let $q3 (App2 "g" (App2 "a" (Var 1) (Var 0)) (Var 0)))

(run 25)

(check (= $p $q))
(fail (check (= $p $q2)))
(check (= $p3 $q3))
