; Fresh slots (paper 3.6, last paragraph).  `z` is reached only through the
; second atom, so the minimal mp' gives it no name in slots(pattern).  A
; renaming is only a map, so the encoding drops the slot -- and an e-node child
; edge that drops a slot asserts that slot is redundant *in the child's class*,
; which here is the class of every variable.
;
; Whatever this rule does to $p, it must not make one variable interchangeable
; with another: k($5) and k($6) stay apart.  (Declining to fire -- the sound but
; incomplete guard -- also satisfies this.)

(rule ((= p (App2 "f" x y))
       (= q (App2 "g" x z)))
      ((union p (App2 "h" y z))))

(let $p (App2 "f" (Var 0) (Var 1)))
(let $q (App2 "g" (Var 0) (Var 5)))

(let $k5 (App2 "k" (Var 5) (Null)))
(let $k6 (App2 "k" (Var 6) (Null)))

(run 20)

(fail (check (= $k5 $k6)))
