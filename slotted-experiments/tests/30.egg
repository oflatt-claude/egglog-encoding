; Eta-expansion: the action introduces a binder over a slot that the match never
; named.  Paper 3.6 ends by saying such slots may be any fresh slot; a Renaming
; is only a map, so there is nothing to mint one with -- this is the encoding's
; "fresh slots" gap, and it is the same gap that makes 27 unsound.
; Currently: Unbound symbol s.

(rewrite
    (App2 "f" x y)
    (App2 "lambda" (Var s) (App2 "app" (App2 "f" x y) (Var s)))
)

(let $a (App2 "f" (Var 1) (Var 2)))
(let $b (App2 "lambda" (Var 9) (App2 "app" (App2 "f" (Var 1) (Var 2)) (Var 9))))
(let $c (App2 "lambda" (Var 9) (App2 "app" (App2 "f" (Var 1) (Var 2)) (Var 2))))

(run 20)

(check (= $a $b))
(fail (check (= $a $c)))
