; Group closure. Unioning $a0 with $a1 records the 3-cycle [0->1,1->2,2->0].
; Its square must follow from the group, giving $a2; the transposition [0<->1]
; is not in the generated group, so $a3 must stay separate.

(let $a0 (App2 "p" (App2 "p" (Var 0) (Var 1)) (Var 2)))
(let $a1 (App2 "p" (App2 "p" (Var 1) (Var 2)) (Var 0)))
(let $a2 (App2 "p" (App2 "p" (Var 2) (Var 0)) (Var 1)))
(let $a3 (App2 "p" (App2 "p" (Var 1) (Var 0)) (Var 2)))

(union $a0 $a1)

(run 20)

(check (= $a0 $a2))
(fail (check (= $a0 $a3)))
