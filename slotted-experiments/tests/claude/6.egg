; Paper 3.4, "E-Node Collisions Within E-Classes": a symmetry of a child must
; become a symmetry of the parent, which the hashcons alone cannot find.
; No rewrite rules -- the symmetry comes from a single union.

(let $c01 (App2 "c" (Var 0) (Var 1)))
(let $c10 (App2 "c" (Var 1) (Var 0)))
(union $c01 $c10)

(let $i01 (App2 "i" (App2 "c" (Var 0) (Var 1)) (Null)))
(let $i10 (App2 "i" (App2 "c" (Var 1) (Var 0)) (Null)))
(let $i02 (App2 "i" (App2 "c" (Var 0) (Var 2)) (Null)))

; the same child at two positions, invoked differently at each
(let $n1 (App2 "n" (App2 "c" (Var 0) (Var 1)) (App2 "c" (Var 0) (Var 1))))
(let $n2 (App2 "n" (App2 "c" (Var 0) (Var 1)) (App2 "c" (Var 1) (Var 0))))
(let $n3 (App2 "n" (App2 "c" (Var 1) (Var 0)) (App2 "c" (Var 0) (Var 1))))

(run 20)

(check (= $i01 $i10))
(fail (check (= $i01 $i02)))
(check (= $n1 $n2))
(check (= $n1 $n3))
