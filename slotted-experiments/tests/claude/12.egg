; A union chain whose renamings have to compose: f[$1,$2] = g[$2,$1] and
; g[$3,$4] = h[$3,$4] give f[$4,$3] = h[$3,$4].  h itself gains no symmetry,
; so h[$4,$3] must stay apart.

(let $a (App2 "f" (Var 1) (Var 2)))
(let $b (App2 "g" (Var 2) (Var 1)))
(union $a $b)

(let $b2 (App2 "g" (Var 3) (Var 4)))
(let $c (App2 "h" (Var 3) (Var 4)))
(union $b2 $c)

(let $a2 (App2 "f" (Var 4) (Var 3)))
(let $c2 (App2 "h" (Var 4) (Var 3)))

(run 20)

(check (= $a2 $c))
(fail (check (= $a2 $c2)))
