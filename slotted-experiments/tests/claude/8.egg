; Paper Figure 3: mul($7, 0) = 0 makes $7 redundant, so mul($9, 0) = 0 too.
; (Null) plays the role of the constant 0.

(let $a (App2 "mul" (Var 7) (Null)))
(let $zero (Null))
(union $a $zero)

(let $b (App2 "mul" (Var 9) (Null)))
(let $c (App2 "mul" (Var 9) (Var 7)))

(run 20)

(check (= $b $zero))
(check (= $a $b))
(fail (check (= $c $zero)))
