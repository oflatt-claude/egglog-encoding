; A pattern that names a *slot* rather than a subterm.  (Var s) must match only
; a variable -- so this restricted commutativity fires on f($1,$2) but not on
; f(g($1),$2).  Slot patterns are what the standard slotted rule sets are
; written with ((var $x) in eta, let-var-same, map-fission, ...).

(rewrite
    (App2 "f" (Var s) (Var t))
    (App2 "f" (Var t) (Var s))
)

(let $a (App2 "f" (Var 1) (Var 2)))
(let $b (App2 "f" (Var 2) (Var 1)))

(let $c (App2 "f" (App2 "g" (Var 1) (Null)) (Var 2)))
(let $d (App2 "f" (Var 2) (App2 "g" (Var 1) (Null))))

(run 20)

(check (= $a $b))
(fail (check (= $c $d)))
