; Same rule as 15 without the symmetry.  a[$0,$1] and a[$1,$0] are one e-class
; but two different renamed ids, so f(x,x) must not match $t -- while $u, whose
; children really are the same renamed id, still must.

(rewrite
    (App2 "f" x x)
    x
)

(let $a01 (App2 "a" (Var 0) (Var 1)))
(let $t (App2 "f" (App2 "a" (Var 0) (Var 1)) (App2 "a" (Var 1) (Var 0))))
(let $u (App2 "f" (App2 "a" (Var 0) (Var 1)) (App2 "a" (Var 0) (Var 1))))

(run 25)

(check (= $u $a01))
(fail (check (= $t $a01)))
