; Eta.  The pattern mentions the binder's variable again inside the body, so the
; match is an ordinary repeated-variable check against the (Var 0) leader -- the
; renaming reached through the body must equal the one the binder installed.
; $e is the same shape with a *different* variable in argument position, so the
; rule must not fire there.

(rewrite
    (App2 "lambda" v (App2 "app" f v))
    f
)

(let $a (App2 "lambda" (Var 0) (App2 "app" (Null) (Var 0))))
(let $b (Null))

(let $c (App2 "lambda" (Var 7) (App2 "app" (App2 "g" (Var 2) (Null)) (Var 7))))
(let $d (App2 "g" (Var 2) (Null)))

(let $e (App2 "lambda" (Var 7) (App2 "app" (Null) (Var 2))))

(run 25)

(check (= $a $b))
(check (= $c $d))
(fail (check (= $e $b)))
