; Rotation: both sides of the rule nest, so every variable's edge renaming has
; to be composed down the pattern and re-composed differently on the right.
; $c/$d repeat one slot across two distinct pattern variables.

(rewrite
    (App2 "f" (App2 "g" x y) z)
    (App2 "g" x (App2 "f" y z))
)

(let $a (App2 "f" (App2 "g" (Var 1) (Var 2)) (Var 3)))
(let $b (App2 "g" (Var 1) (App2 "f" (Var 2) (Var 3))))

(let $c (App2 "f" (App2 "g" (Var 5) (Var 5)) (Var 6)))
(let $d (App2 "g" (Var 5) (App2 "f" (Var 5) (Var 6))))

(let $e (App2 "g" (Var 2) (App2 "f" (Var 1) (Var 3))))

(run 20)

(check (= $a $b))
(check (= $c $d))
(fail (check (= $a $e)))
