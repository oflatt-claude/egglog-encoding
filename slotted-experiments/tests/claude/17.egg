; Three occurrences of one variable at three different depths: N occurrences
; need N-1 symmetry lookups, and the paths to them have to be composed through
; the nesting before they can be compared.

(rewrite
    (App2 "t" x (App2 "t" x x))
    x
)

(let $a01 (App2 "a" (Var 0) (Var 1)))
(let $a10 (App2 "a" (Var 1) (Var 0)))
(union $a01 $a10)

(let $e (App2 "t" (App2 "a" (Var 0) (Var 1))
                  (App2 "t" (App2 "a" (Var 1) (Var 0))
                            (App2 "a" (Var 0) (Var 1)))))

(let $s (App2 "t" (App2 "a" (Var 0) (Var 1))
                  (App2 "t" (App2 "a" (Var 1) (Var 0))
                            (App2 "a" (Var 0) (Var 2)))))

(run 25)

(check (= $e $a01))
(fail (check (= $s $a01)))
