; Redundancy on the *leaf* class.  Unioning two invocations of one class whose
; slot sets differ is the union that establishes a redundancy (paper 3.5 step 1),
; and here that class is (Var 0) itself: every variable becomes interchangeable,
; and every term over one variable collapses with the same term over another.

(let $v0 (Var 0))
(let $v7 (Var 7))
(union $v0 $v7)

(let $f0 (App2 "f" (Var 0) (Null)))
(let $f7 (App2 "f" (Var 7) (Null)))
(let $f9 (App2 "f" (Var 9) (Null)))
(let $n  (Null))

(run 30)

(check (= $v0 $v7))
(check (= $f0 $f7))
(check (= $f0 $f9))
(fail (check (= $f0 $n)))
