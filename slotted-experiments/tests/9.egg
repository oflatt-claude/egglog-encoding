; Redundancy introduced by a rewrite rather than a union, and propagated into a
; parent: the parent's edge to the child has to shrink when the child drops a slot.

(rewrite
    (App2 "mul" x (Null))
    (Null)
)

(let $a (App2 "f" (App2 "mul" (Var 7) (Null)) (Var 8)))
(let $b (App2 "f" (App2 "mul" (Var 9) (Null)) (Var 8)))
(let $c (App2 "f" (Null) (Var 8)))
(let $d (App2 "f" (App2 "mul" (Var 7) (Null)) (Var 3)))

(run 20)

(check (= $a $b))
(check (= $a $c))
(fail (check (= $a $d)))
