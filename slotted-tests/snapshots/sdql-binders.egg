(check (= (ClassSlots $second) (map-empty)))
(pop)
(push)
(let $r (Sing (map-empty) (Null) (map-empty) (Null)))
(let $free (Sum (map-empty) $r (map-of 0 5) (Var 0) (map-of 0 6) (Var 0) (map-of 5 5 9 9) (Sing (map-of 0 5) (Var 0) (map-of 0 9) (Var 0))))
(run-schedule (saturate (run slotted)))
(check (= (ClassSlots $free) (map-of 9 9)))
