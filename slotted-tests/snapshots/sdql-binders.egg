(check (= (ClassSlots $vk) (map-empty)))
(pop)
(push)
(let $first (Sum (map-empty) (Null) (map-of 0 5) (Var 0) (map-of 0 6) (Var 0) (map-of 0 5) (Var 0)))
(let $second (Sum (map-empty) (Null) (map-of 0 5) (Var 0) (map-of 0 6) (Var 0) (map-of 0 6) (Var 0)))
