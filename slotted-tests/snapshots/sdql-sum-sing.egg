;;; Null ::  -- declared by the machinery this file includes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `Sum` binds child 2, 3, one rule per bound slot
(rule ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) ml l)
       (= v0 (map-get mvar0 0))
       (map-not-contains (map-image m1) v0))
      ((Equated (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

(rule ((= node (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m1) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-image m1) (map-image mvar0)) (map-image mvar1)) (map-image m4)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (Sum m1 c1 (map-of 0 w0) (Var 0) mvar1 (Var 0) (compose (map-insert (map-image m4) v0 w0) m4) c4))
       (delete (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))) :ruleset slotted)

(rule ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) ml l)
       (= v1 (map-get mvar1 0))
       (map-not-contains (map-image m1) v1))
      ((Equated (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) (inverse (map-remove (inverse ml) v1)) l)) :ruleset slotted)

(rule ((= node (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))
       (= v1 (map-get mvar1 0))
       (map-contains (map-image m1) v1)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-image m1) (map-image mvar0)) (map-image mvar1)) (map-image m4)))
       ; the smallest slot the node does not use
       (= fresh1 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w1 (map-get fresh1 0)))
      ((union node (Sum m1 c1 mvar0 (Var 0) (map-of 0 w1) (Var 0) (compose (map-insert (map-image m4) v1 w1) m4) c4))
       (delete (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))) :ruleset slotted)

(rule ((= V5 (Sum p1 C6 p2 (Var 0) p3 (Var 0) p4 C7))
       (= dom8 (map-union (map-image p1) (map-union (map-image p2) (map-union (map-image p3) (map-image p4)))))
       (= mp9 dom8)
       (= idm10 (map-image mp9))
       (= sk (map-get (compose mp9 p2) 0))
       (= sv (map-get (compose mp9 p3) 0))
       (= m11 (compose mp9 p1))
       (= cs12 (ClassSlots C6))
       (= m13 (compose mp9 p4))
       (= cs14 (ClassSlots C7))
       (= cs15 (ClassSlots V5))
       (= C7 (Sing p16 (Var 0) p17 (Var 0)))
       (= dom19 (map-union (map-image p16) (map-image p17)))
       (RenamesToLeader C7 sym20 C7)
       (= mp21 (find-mapping-total idm10 dom19 (compose (compose m13 cs14) sym20) (map-insert (map-empty) 0 sk) (map-insert (map-empty) 0 sv) (map-domain (compose m13 cs14)) p16 p17))
       (= idm22 (map-image mp21))
       (= av23 (map-union idm10 idm22))
       (= sk (map-get (compose mp21 p16) 0))
       (= sv (map-get (compose mp21 p17) 0)))
      ((Equated V5 (compose (inverse (compose mp9 cs15)) (compose m11 cs12)) C6)))
(push)
(let $r (Sing (map-empty) (Null) (map-empty) (Null)))
(let $s (Sum (map-empty) $r (map-of 0 5) (Var 0) (map-of 0 6) (Var 0) (map-of 5 5 6 6) (Sing (map-of 0 5) (Var 0) (map-of 0 6) (Var 0))))
(run-schedule (saturate (run slotted))
              (repeat 2 (seq (run) (saturate (run slotted)))))
(check (RenamesToLeader $s _m1 _l) (RenamesToLeader $r _m2 _l))
(pop)
(push)
(let $r (Sing (map-empty) (Null) (map-empty) (Null)))
(let $swapped (Sum (map-empty) $r (map-of 0 5) (Var 0) (map-of 0 6) (Var 0) (map-of 5 5 6 6) (Sing (map-of 0 6) (Var 0) (map-of 0 5) (Var 0))))
(run-schedule (saturate (run slotted))
              (repeat 2 (seq (run) (saturate (run slotted)))))
(fail (check (RenamesToLeader $swapped _m1 _l) (RenamesToLeader $r _m2 _l)))
(pop)
