;;; Tests ported from the reference crate's own suites, run against this encoding.
;;;
;;; Source: `memoryleak47/slotted-egraphs` PR #45, `tests/<suite>/mod.rs`. Each
;;; section names the test it came from so the two can be diffed by hand.
;;;
;;; Written in the SLOTTED language and standalone: the constructors below are all
;;; this file needs, and the compiler generates their machinery. Nothing is included,
;;; so `slotted-egglog.py slotted-tests/paper-tests.egg` runs it as it stands.
;;;
;;; `same` is the reference's equality, which is equality of INVOCATIONS: two terms
;;; are equal when one renaming carries the class's leader to both. Landing in one
;;; class is weaker, and `fgh::transitive_symmetry` below is exactly the case that
;;; separates the two.

(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor C (U U) U)
(constructor I (U U) U)
(constructor N (U U) U)
(constructor Q (U U) U)
(constructor Mul (U U) U)
(constructor Swp (U U) U)
(constructor K (U U) U)
(constructor Null () U)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; var::xy_eq_yz_causes_redundancy
;;;
;;;     f($0,$1) = f($1,$2)  =>  one class, and it has NO slots
;;;
;;; Equating two nodes that use different slots forces every slot redundant: the
;;; class cannot depend on $0 (the right side does not mention it) nor on $1 or $2
;;; by the same argument. The reference asserts `eg.slots(id).is_empty()`.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f01 (F $0 $1))
(let f12 (F $1 $2))
(union f01 f12)
(run 0)

;; one class ...
(check (same f01 f12))
;; ... with no slots left
(check (slots f01))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; fgh::transitive_symmetry
;;;
;;;     f($1,$2) = g($2,$1),  g($1,$2) = h($1,$2)  =>  f($1,$2) = h($2,$1)
;;;
;;; The first equation is a *swap*, the second the identity, so composing them has
;;; to carry the swap through. The reference asks for an explanation of
;;; `f($1,$2) = h($2,$1)`; here the claim is that equation itself, plus the one that
;;; makes it content rather than bookkeeping -- f($1,$2) is NOT h($1,$2). Both terms
;;; are in the one class either way, and the swap is what tells them apart.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f12 (F $1 $2))
(let g21 (G $2 $1))
(let g12 (G $1 $2))
(let h12 (H $1 $2))
(let h21 (H $2 $1))
(union f12 g21)
(union g12 h12)
(run 0)

;; the swap carried through both equations
(check (same f12 h21))
;; and it really is the swap: the identity does not relate them
(check (not-same f12 h12))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 3.4, "E-Node Collisions Within E-Classes"
;;;
;;; A symmetry of a CHILD has to become a symmetry of the parent, which the
;;; hashcons alone cannot find: `i(c($0,$1))` and `i(c($1,$0))` are two different
;;; rows and nothing about them collides. One union supplies the symmetry, and
;;; `n`, which holds the same child at both positions, has to pick it up at each
;;; position independently.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let c01 (C $0 $1))
(union c01 (C $1 $0))

(let i01 (I (C $0 $1) (Null)))
(let i10 (I (C $1 $0) (Null)))
(let i02 (I (C $0 $2) (Null)))

;; the same child at two positions, invoked differently at each
(let n1 (N (C $0 $1) (C $0 $1)))
(let n2 (N (C $0 $1) (C $1 $0)))
(let n3 (N (C $1 $0) (C $0 $1)))

(run 0)

(check (same i01 i10))
(check (not-same i01 i02))
(check (same n1 n2))
(check (same n1 n3))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Figure 3
;;;
;;;     mul($7, 0) = 0   =>   mul($9, 0) = 0
;;;
;;; The equation does not mention $7 on the right, so $7 is redundant in the
;;; class and the node stands for `mul($x, 0)` at every $x. `(Null)` is 0 here.
;;; `mul($9,$7)` is a different node and must not come along.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let m7 (Mul $7 (Null)))
(let zero (Null))
(union m7 zero)

(let m9 (Mul $9 (Null)))
(let m97 (Mul $9 $7))

(run 0)

(check (same m9 zero))
(check (same m7 m9))
(check (not-same m97 zero))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 3.5, step 1: redundancy is closed under the permutation group
;;;
;;; "if you can swap $x with $y by a symmetry, then if $x is redundant so is $y".
;;; `f` is made symmetric, then equated with a term over one slot: $1 goes
;;; redundant, the orbit drags $0 along, and the merged class keeps no slots --
;;; without ever becoming `(Null)`.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f01 (F $0 $1))
(let f10 (F $1 $0))
(union f01 f10)

(let g0 (G $0 (Null)))
(union f01 g0)

;; bound before the run, so the graph holds these invocations to be asked about
(let g5 (G $5 (Null)))
(let f78 (F $7 $8))

(run 0)

(check (same g0 g5))
(check (same f01 f78))
(check (slots f01))
(check (not-same f01 (Null)))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Definition 8: a class with TWO redundant slots
;;;
;;; A redundant slot stands for infinitely many e-nodes, so a match picks fresh
;;; slots for them. After `mul($7,$8) = 0` the zero class also contains
;;; `mul($x,$y)` for every pair, so commutativity has to yield `swp($y,$x) = 0`
;;; for every pair too -- while an unrelated `k($1,$2)` stays out.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (Mul ?x ?y) (Swp ?y ?x) :name comm)

(let m (Mul $7 $8))
(let z (Null))
(union m z)

(let s12 (Swp $1 $2))
(let s21 (Swp $2 $1))
(let k12 (K $1 $2))

(run 10)

(check (same s12 z))
(check (same s12 s21))
(check (not-same k12 z))

(pop)
